// add rating validation 
$j(document).ready(function () {
  const stars = $j('.starInner');
  const ratingValue = $j('#rating-value');
  $j('body').on('click', '.starInner', function () {
    $j(this).closest('.feedback-inner-wrapper').find('.errormsg').hide();
  });
  $j('body').on('click', '#rnr-widget-send', function () {
    // console.log("Submit button clicked!");
    if (!ratingValue.val()) {
      $j(this).closest('.feedback-inner-wrapper').find('.errormsg').show();
      // console.error("No rating selected!");
    } else {
      console.log("Rating selected:", ratingValue.val());
    }
  });
});
