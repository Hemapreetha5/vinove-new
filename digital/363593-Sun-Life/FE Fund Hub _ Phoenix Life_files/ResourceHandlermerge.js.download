/* --- Policy Click Popup Starts --- */

$j(document).on("click", ".policyLink,.rad-lightbox", function (e) {
  e.preventDefault();
  e.stopImmediatePropagation();
  $j(".policyLink,.rad-lightbox").removeClass("clickedPolicyLink");
  $j(this).addClass("clickedPolicyLink");
  var checkPolicy;
  var policyText;
  var anchorUrl =
    e.target.tagName == "A"
      ? $j(e.target).attr("href")
      : $j(e.target).parent("a").attr("href");
  if ($j(this).hasClass("policyLink")) {
    checkPolicy = $j(this).data("policy").toString().toLowerCase();
    policyText = $j(this).data("policy");
  }
  if ($j(this).hasClass("rad-lightbox") == true) {
    checkPolicy = $j(this).text().trim().toLowerCase();
    policyText = $j(this).text().trim();
  }
  if (
    document.cookie.indexOf("selectedInsurance") > 0 &&
    $j(this).parents(".policy-banner-wrapper").length == 0 &&
    !$j(this).hasClass("btnWhoLookspolicy")
  ) {
    var readCookieUrl = JSON.parse(
      document.cookie.split("selectedInsurance=")[1].split(";")[0]
    );
    readCookieUrl = readCookieUrl.url.toString();
    if (
      checkPolicy.indexOf("profits") > -1 ||
      anchorUrl.indexOf("profits") > -1
    ) {
      readCookieUrl += "/with-profits";
    } else if (
      checkPolicy.indexOf("unit") > -1 ||
      anchorUrl.indexOf("unit") > -1
    ) {
      readCookieUrl += "/unit-linked-fund-prices";
    } else if (
      checkPolicy.indexOf("personal") > -1 ||
      checkPolicy.indexOf("change") > -1 ||
      anchorUrl.indexOf("change") > -1
    ) {
      readCookieUrl += "/change-of-personal-information";
    } else if (
      checkPolicy.indexOf("subject") > -1 ||
      anchorUrl.indexOf("subject") > -1
    ) {
      readCookieUrl += "/subject-access-request-form";
    } else if (
      checkPolicy.indexOf("complain") > -1 ||
      anchorUrl.indexOf("complain") > -1
    ) {
      readCookieUrl =
        "/customer-centre/help-centre/how-to-guides/how-to-guides-" +
        readCookieUrl
          .substring(readCookieUrl.lastIndexOf("/"))
          .replace("/manage-my-policy-", "") +
        "/make-a-complaint";
    } else if (
      checkPolicy.indexOf("guides") > -1 ||
      anchorUrl.indexOf("guides") > -1
    ) {
      readCookieUrl =
        "/customer-centre/help-centre/how-to-guides/how-to-guides-" +
        readCookieUrl
          .substring(readCookieUrl.lastIndexOf("/"))
          .replace("/manage-my-policy-", "");
    } else if ($j(e.target).hasClass("policyLink")) {
      if (
        e.target.tagName != "A" &&
        $j(e.target).find("a").attr("href").indexOf("guides") > -1
      ) {
        readCookieUrl =
          "/customer-centre/help-centre/how-to-guides/how-to-guides-" +
          readCookieUrl
            .substring(readCookieUrl.lastIndexOf("/"))
            .replace("/manage-my-policy-", "");
      }
      if ($j(this).attr("href").indexOf("guides") > -1) {
        readCookieUrl =
          "/customer-centre/help-centre/how-to-guides/how-to-guides-" +
          readCookieUrl
            .substring(readCookieUrl.lastIndexOf("/"))
            .replace("/manage-my-policy-", "");
      }
    } else if (
      checkPolicy.indexOf("request") > -1 ||
      anchorUrl.indexOf("request") > -1
    ) {
      readCookieUrl += "/contact/retirement-pack-request-form";
    } else if ((
      checkPolicy.indexOf("contact") > -1 ||
      anchorUrl.indexOf("contact") > -1)
    ) {
      readCookieUrl += "/contact";
    }
    else if (
      window.location.pathname === "/about-phoenix-life/sustainability/sustainability-disclosure"
    ) {
      readCookieUrl += "/contact/contact-form";
    }
    else {
      readCookieUrl;
    }
    $j.ajax({
      url: readCookieUrl,
      success: function (result, status, xhr) {
        location.href = readCookieUrl;
      },
      error: function (xhr, status, error) {
        location.href = JSON.parse(
          document.cookie.split("selectedInsurance=")[1].split(";")[0]
        ).url;
      },
    });
    //location.href = readCookieUrl;
  } else {
    if ($j(this).hasClass("btnWhoLookspolicy")) {
      $j(".policyModalPopup .modal__title").text($j(this).attr("data-title"));
      $j(".policyModalPopup .policy-description > p").text(
        $j(this).attr("data-content")
      );
      $j(".policyModalPopup .policy-bottom-wrapper .rad-small").addClass(
        "hide"
      );
    } else {
      $j(".policyModalPopup .modal__title").text(policyText);
      if ($j(e.target).hasClass("btnModal")) {
        $j(".policyModalPopup").addClass("changePolicyExecuted");
      }
    }

    $j(".policyModalPopup").fadeIn(200);
    setTimeout(function () {
      $j(".policyModalPopup .close").focus();
    }, 205);
  }
});
/* ---  Policy Click Popup Ends  --- */

