function lastChildFocus(){
$j(".tab-menu ul li:last-child a").focus(function(){
    $j(".tab-next").addClass("disableTag");
   // console.log("Last Child Focused")
    $j(".disableTag").keydown(function(event){
        if (event.keyCode === 13) {
            event.preventDefault();
        }
    })
})
}

