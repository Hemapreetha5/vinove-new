document.addEventListener('focusin', function(event) {
  if (event.target.tagName.toLowerCase() === 'input' &&
      event.target.closest('.policyModalPopup')) {
      event.preventDefault();
  }
});


// Manage my policy 
$j(document).ready(function() {
    var selectedInsurance = null;
    // If selectedInsurance is set
    if (getCookie('selectedInsurance')) {
      selectedInsurance = JSON.parse(getCookie('selectedInsurance'));
    }
    if (selectedInsurance && selectedInsurance.url) {
      $j('a[data-policy="Manage my policy"]').attr('href', selectedInsurance.url);
      $j('.breadcrumb__item').each(function() {
        if ($j(this).text().trim() === "Manage my policy") {
          $j(this).attr('href', selectedInsurance.url);
        }
      });
    } else {
      // If selectedInsurance is not set, set the default URL
      $j('a[data-policy="Manage my policy"]').attr('href', '/customer-centre/manage-my-policy');
      $j('a[data-policy="How to Guide"]').attr('href', '/customer-centre/help-centre/how-to-guides');
      $j('.breadcrumb__item').each(function() {
        if ($j(this).text().trim() === "Manage my policy") {
          $j(this).attr('href', '/customer-centre/manage-my-policy');
        }
         // Setting the href for "How to Guide" link
         if ($j(this).text().trim() === "How to Guide") {
          $j(this).attr('href', '/customer-centre/help-centre/how-to-guides');
        }
      });
    }
  });


