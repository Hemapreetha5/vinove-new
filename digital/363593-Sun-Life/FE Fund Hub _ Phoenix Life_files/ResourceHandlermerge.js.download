//  var scriptTag = document.createElement('script');
  //          scriptTag.src = 'https://content.jwplatform.com/players/afcpQBgM-GdWyXZd2.js';
    //        $j('.video-card__video-container').append(scriptTag);
        
        if ($j(e.target).parents(".custom-tab-wrapper")) {
          dcYesWrapper = getClass("dc-yes-wrapper");
          dcNoWrapper = getClass("dc-no-wrapper");
          prevBtn = getClass("btnBackToPrev");
          dcMainWrapper = getClass("death-claim-wrapper");
          dcWrapper = getClass("dc-main-wrapper");
          deathClaim(
            dcYesWrapper,
            dcNoWrapper,
            prevBtn,
            dcMainWrapper,
            dcWrapper
          );
        }

        findAndReplaceDOMText(document.querySelector("body"), {
          find: /\?/g,
          wrap: "abbr",
          wrapClass: "fnClass",
        });

        $j("html,body").animate(
          {
            scrollTop: $j("article > .row.m-0")
              .find(".tab-main-wrapper")
              .offset().top,
          },
          30
        );
        
        
       // console.log("END");
       setTimeout(function(){
         $j("a.tab-a.active-a").focus();
         // console.log("END1");
        //  $j(".tab-menu ul").trigger("hover");
          //console.log("END2");
        //  $j(".tab-menu ul").trigger("click");
         // console.log("END3");
        // $j(".tab-menu ul")[0].trigger("click");
         

        },1000);
        
      },
       
    });
  }
);

$j(document).on("click", ".bod__container label", function (e) {
  e.preventDefault();
  $j(".bod_content_wrapper_inner").html("");
  var dataIndex = $j(this).parents(".bod_item_wrapper").data("index");
  var dataMobIndex = $j(this).parents(".bod_item_wrapper").data("mobindex");
  var datasMobIndex = $j(this).parents(".bod_item_wrapper").data("smobindex");

  if (
    dataIndex != $j(".bod_content_wrapper.act-content-wrapper").data("index")
  ) {
    $j(".bod_content_wrapper.bod-desktop")
      .slideUp(0)
      .removeClass("act-content-wrapper");
  }
  if (
    dataMobIndex !=
    $j(".bod_content_wrapper.act-mcontent-wrapper").data("mobindex")
  ) {
    $j(".bod_content_wrapper.bod-mob")
      .slideUp(0)
      .removeClass("act-mcontent-wrapper");
  }
  if (
    datasMobIndex !=
    $j(".bod_content_wrapper.act-scontent-wrapper").data("smobindex")
  ) {
    $j(".bod_content_wrapper.bod-smob")
      .slideUp(0)
      .removeClass("act-scontent-wrapper");
  }

  if (!$j(this).parents(".bod_item_wrapper").hasClass("active-bod")) {
    $j(".bod_item_wrapper").removeClass("active-bod");
    $j(this).parents(".bod_item_wrapper").addClass("active-bod");
    var currentContent = $j(this).next(".bod__content").html();
    $j(this)
      .parents(".bod_item_wrapper")
      .siblings(".bod_content_wrapper[data-index='" + dataIndex + "']")
      .addClass("act-content-wrapper")
      .slideDown(300)
      .find(".bod_content_wrapper_inner")
      .html(currentContent);
    $j(this)
      .parents(".bod_item_wrapper")
      .siblings(".bod_content_wrapper[data-mobindex='" + dataMobIndex + "']")
      .addClass("act-mcontent-wrapper")
      .slideDown(300)
      .find(".bod_content_wrapper_inner")
      .html(currentContent);
    $j(this)
      .parents(".bod_item_wrapper")
      .siblings(".bod_content_wrapper[data-smobindex='" + datasMobIndex + "']")
      .addClass("act-scontent-wrapper")
      .slideDown(300)
      .find(".bod_content_wrapper_inner")
      .html(currentContent);
    if ($j(window).width() > 767) {
      $j("html,body").animate(
        {
          scrollTop: $j(
            ".bod_content_wrapper[data-index='" + dataIndex + "']"
          ).offset().top,
        },
        300
      );
    } else if ($j(window).width() > 575 && $j(window).width() < 768) {
      $j("html,body").animate(
        {
          scrollTop: $j(
            ".bod_content_wrapper[data-mobindex='" + dataMobIndex + "']"
          ).offset().top,
        },
        300
      );
    } else {
      $j("html,body").animate(
        {
          scrollTop: $j(
            ".bod_content_wrapper[data-smobindex='" + datasMobIndex + "']"
          ).offset().top,
        },
        300
      );
    }
  } else {
    $j(".bod_item_wrapper").removeClass("active-bod");
    $j(".bod_content_wrapper").slideUp(300);
  }
});
$j(document).on("click", ".bod_content_wrapper .icon-close", function (e) {
  $j(".bod_item_wrapper.active-bod").find("label").trigger("click");
});
/*--- Mobile Menu Starts ---*/
$j(document).on("click", ".mob-menu span,.mob-menu", function () {
  setTimeout(function () {
    if ($j("#main-nav-check").prop("checked") == true) {
      $j("main").addClass("bk-menu-overlay");
      $j("nav.navigation").addClass("active-mmenu");
    } else {
      $j("main").removeClass("bk-menu-overlay");
       $j("nav.navigation").removeClass("active-mmenu");
    }
  }, 50);
});

$j(document).on("click", ".toggle-sub", function () {
  if ($j(this).attr("for").indexOf("-level2") > 0) {
    var currentHeight = $j(this).siblings("ul").children("li").length * 38 + 45;
    $j("nav").animate({ height: currentHeight - 20 }, 200);
    $j(this).siblings("ul").animate({ scrollTop: -65 });
    $j(".ulLevel0,.ulLevel1").css("overflow-y", "hidden");
  } else {
    var currentHeight = $j(this).siblings("ul").children("li").outerHeight();
    //console.log("In ",currentHeight);
    $j("nav").animate({ height: currentHeight - 20 }, 200);
    $j(".ulLevel0,.ulLevel1").css("overflow-y", "hidden");
  }
  $j("html,body").animate({ scrollTop: 0 }, 100);
});
$j(document).on("click", ".btnBack.toggle:not(.toggle-sub)", function () {
  if ($j(this).attr("for").indexOf("-level1") > 0) {
    /*$j(".ulLevel0").css("overflow","auto");*/
    var ulHeight = $j("nav > ul").outerHeight();
    $j("nav").animate({ height: ulHeight + 20 }, 200);
  }
  if ($j(this).attr("for").indexOf("-level2") > 0) {
    $j(".ulLevel1").css("overflow", "auto");
    var ulHeight = $j(this).parents(".ulLevel1 > li").outerHeight();
    $j("nav").animate({ height: ulHeight + 20 }, 200);
  }
}); 
