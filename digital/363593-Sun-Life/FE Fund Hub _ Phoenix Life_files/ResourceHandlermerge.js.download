  /* --- Policy: Open droplist on input focus --- */

  $j(document).on("click", function (e) {
    if (
      !$j(e.target).parent(".combo-wrapper").length > 0 &&
      !$j(e.target).hasClass("icon-symbol") &&
      ($j(e.target).parents(".policyModalPopup").length > 0 ||
        $j(e.target).parents(".dc-no-wrapper").length > 0) &&
      !$j(e.target).hasClass("btn-list")
    ) {
      $j(
        ".policyModalPopup .combo__list,.dc-no-wrapper .combo__list"
      ).fadeOut();

      if ($j(".policyModalPopup .selected-insurance").length > 0) {
        //$j("#cmbo3").val($j(".policyModalPopup .selected-insurance span").text().trim())
      }
    }
    if (
      $j(e.target).parents(".loginRegisterPopup").length > 0 &&
      !$j(e.target).hasClass("icon-symbol") &&
      !$j(e.target).parent(".input-field").length > 0 &&
      !$j(e.target).hasClass("btn-list")
    ) {
      $j(".loginRegisterPopup .combo__list").fadeOut();
      if ($j(".loginRegisterPopup .selected-insurance").length > 0) {
        $j("#cmbo2").val(
          $j(".loginRegisterPopup .selected-insurance span").text().trim()
        );
      }
    }
    if (
      $j(e.target).is("a") &&
      $j(e.target).parents(".combo__list").length > 0 &&
      $j(e.target).attr("href").indexOf(":void(0)") > 0 &&
      $j(".modal").is(":visible")
    ) {
      e.preventDefault();
    }
    if (
      $j(".active_ddl").length > 0 &&
      !$j(e.target).not(".ddl_title").parents(".dropdown-wrapper").length > 0
    ) {
      $j(".active_ddl .ddlSelectedValue").trigger("click");
    }
    if (
      $j("#main-nav-check").prop("checked") == true &&
      $j(window).width() < 992 &&
      !$j(e.target).is(
        'label[for="main-nav-check"],label[for="main-nav-check"] span,#main-nav-check'
      ) &&
      !$j(e.target).parents("nav").length > 0
    ) {
      $j(".mob-menu").trigger("click");
    }
    if (
      !$j(e.target).hasClass("rad-popup") &&
      $j(".rad-popup.open-tt").length > 0 &&
      !$j(e.target).hasClass("rad-caption")
    ) {
      $j(".rad-popup")
        .removeClass("open-tt")
        .find(".close-tt")
        .attr("tabindex", "-1");
    }
    if (
      !$j(e.target).parents(".activeShare").length > 0 &&
      !$j(e.target).hasClass("activeShare") &&
      $j(".activeShare").length > 0 &&
      !$j(e.target).parents(".share-news-item").length > 0 &&
      !$j(e.target).hasClass("share-news-item") > 0
    ) {
      $j(".activeShare").prev().find(".share-news-item").trigger("click");
    }
    if (
      $j(e.target).hasClass("panel-wrapper") &&
      $j(".panel-wrapper.active-popup").length > 0
    ) {
      $j(".active-popup .close-popup").trigger("click");
    }
    if (
     $j(e.target).parents(".policyModalPopup").length < 1 &&
      !$j(e.target).hasClass("rad-lightbox") &&
      !$j(e.target).hasClass("policyLink") &&
      $j(e.target).parents(".policyLink").length < 1 &&
      $j(".policyModalPopup").is(":visible")
    ) {
  //  $j(".policyModalPopup .close").trigger("click");
    }

    if (
      $j(e.target).hasClass("modalExternalLink") &&
      $j(".modalExternalLink.active-modal").length > 0
    ) {
      $j(".modal-wrapper .close").trigger("click");
    }
  });

  /* --- Policy: Clear Selected Value on Input --- */
  $j(document).on("click", ".icon-symbol", function () {
    if (
      !$j(this).children(".policySearch").is(":visible") &&
      $j(this).children(".search-close").is(":visible")
    ) {
      $j(this).parents(".field-wrapper").find("input").val("");
      $j(this)
        .parents(".model-filer")
        .find(".btnPolicyCheck")
        .addClass("disableTag");
      $j(this).children(".search-close").hide();
      $j(this).children(".policySearch").show();
    }
    if ($j(this).parent().find(".combo__list").is(":visible")) {
      $j(this).parent().find(".combo__list").fadeOut();
    }
  });
  /* --- Policy: Clear Selected Value on Input --- */

  /* --- Check Eligibility Starts ---*/
  $j(document).on("click", ".btn-eligibility", function (e) {
    var selectedInsurance = $j(".loginRegisterPopup .selected-insurance");
    if (selectedInsurance.length > 0) {
      $j(".lr-container > .row.p__rel").addClass("hideOnLeft hide");
      if (
        $j(
          ".loginRegisterPopup .selected-insurance .policy-holder-innerwrap"
        ).children().length > 0
      ) {
        var eligbleRadio = $j(
          ".loginRegisterPopup .selected-insurance .policy-holder-type-wrapper"
        ).clone();
        eligbleRadio.children(".policyHolderHeadText").remove();
        eligbleRadio
          .prepend($j(".selectOptionPolicy"))
          .prependTo(".lr-container")
          .removeClass("hide")
          .wrapAll("<div class='checkPolicyRadioWrapper'></div>");
        $j(".lrinner .field-wrapper")
          .siblings()
          .clone()
          .appendTo(".checkPolicyRadioWrapper");
        $j(".checkPolicyRadioWrapper button")
          .removeClass("btn-eligibility")
          .addClass("disableTag btnCheckRadioPolicy");
      } else if (selectedInsurance.data("eligible") == "eligible") {
        $j(".eligble-content").clone().prependTo(".lr-container");
      } else {
        var eligibilityContent = $j(".not-eligble-content").clone();
        if (
          $j(".lr-container .selected-insurance").data("contact") != "" ||
          $j(".lr-container .selected-insurance").data("overseas") != ""
        ) {
          eligibilityContent
            .children(".no-contacts-eligibility")
            .addClass("hide");
          if (
            $j(".lr-container .selected-insurance").data("customcontent") ==
            true
          ) {
            eligibilityContent
              .children(".with-contacts-eligibility")
              .addClass("hide");
            var customContent = $j(".lr-container .selected-insurance")
              .find(".custom-policy-content")
              .clone();
            customContent
              .removeClass("hide")
              .insertAfter(eligibilityContent.find("h2"));
          }

          var localContact = $j(".lr-container .selected-insurance").data("contact");
          var overSeasContact = $j(".lr-container .selected-insurance").data("overseas");

          var contactForm =$j(".lr-container .selected-insurance").data("cform");
          var contactFormLink =$j(".lr-container .selected-insurance").data("clink");

          if (localContact != "") {
            eligibilityContent.children(".localContact").removeClass("hide");
          }
          if (overSeasContact != "") {
            eligibilityContent.children(".overseasContact").removeClass("hide");
          }
          if (contactForm != "") {
            eligibilityContent.children(".localContactForm").removeClass("hide");
          }
          
          eligibilityContent
            .find(".localContact a")
            .attr("href", "tel:" + localContact)
            .children("strong")
            .text(localContact);
            
          eligibilityContent
            .find(".overseasContact a")
            .attr("href", "tel:" + overSeasContact)
            .text(overSeasContact);

          eligibilityContent
          .find(".localContactForm a")
           .attr("href", contactFormLink)
          

        } else {
          if (
            $j(".lr-container .selected-insurance").data("customcontent") ==
            true
          ) {
            eligibilityContent

              .children(".no-contacts-eligibility")
              .addClass("hide");
            var customContent = $j(".lr-container .selected-insurance")
              .find(".custom-policy-content")
              .clone();
            customContent
              .removeClass("hide")
              .insertAfter(eligibilityContent.find("h2"));
          }
          eligibilityContent
            .children(".with-contacts-eligibility")
            .addClass("hide");
        }
        eligibilityContent.prependTo(".lr-container");
      }
    }
  });

  $j(document).on("change", ".checkPolicyRadioWrapper input", function (e) {
    if ($j(".checkPolicyRadioWrapper input.activeRadioPolicy").length > 0) {
      $j(".checkPolicyRadioWrapper input.activeRadioPolicy").removeClass(
        "activeRadioPolicy"
      );
    }
    $j(this).addClass("activeRadioPolicy");
    if ($j(".btnCheckRadioPolicy").hasClass("disableTag")) {
      $j(".btnCheckRadioPolicy").removeClass("disableTag");
    }
  });

  $j(document).on("click", ".btnCheckRadioPolicy", function (e) {
  
  
    if (
      $j(".checkPolicyRadioWrapper input.activeRadioPolicy")
        .parent()
        .data("checkeligible") == "eligible"
    ) {
      $j(".checkPolicyRadioWrapper").children().remove();
      $j(".eligble-content")
        .clone()
        .prependTo(".lr-container .checkPolicyRadioWrapper");
    } else {
      $j(".checkPolicyRadioWrapper").children().remove();
      var eligibilityContent = $j(".not-eligble-content").clone();
      if (
        $j(".lr-container .selected-insurance").data("contact") != "" ||
        $j(".lr-container .selected-insurance").data("overseas") != ""
      ) {
        eligibilityContent
          .children(".no-contacts-eligibility")
          .addClass("hide");
        if (
          $j(".lr-container .selected-insurance").data("customcontent") == true
        ) {
          eligibilityContent
            .children(".with-contacts-eligibility")
            .addClass("hide");
          var customContent = $j(".lr-container .selected-insurance")
            .find(".custom-policy-content")
            .clone();
          customContent
            .removeClass("hide")
            .insertAfter(eligibilityContent.find("h2"));
        }
        var localContact = $j(".lr-container .selected-insurance").data(
          "contact"
        );
        var overSeasContact = $j(".lr-container .selected-insurance").data(
          "overseas"
        );
        if (localContact != "") {
          eligibilityContent.children(".localContact").removeClass("hide");
        }
        if (overSeasContact != "") {
          eligibilityContent.children(".overseasContact").removeClass("hide");
        }
        eligibilityContent
          .find(".localContact a")
          .attr("href", "tel:" + localContact)
          .children("strong")
          .text(localContact);
        eligibilityContent
          .find(".overseasContact a")
          .attr("href", "tel:" + overSeasContact)
          .text(overSeasContact);
      } else {
        eligibilityContent
          .children(".with-contacts-eligibility")
          .addClass("hide");
        if (
          $j(".lr-container .selected-insurance").data("customcontent") == true
        ) {
          eligibilityContent
            .children(".no-contacts-eligibility")
            .addClass("hide");
          var customContent = $j(".lr-container .selected-insurance")
            .find(".custom-policy-content")
            .clone();
          customContent
            .removeClass("hide")
            .insertAfter(eligibilityContent.find("h2"));
        }
      }
      eligibilityContent.prependTo(".lr-container .checkPolicyRadioWrapper");
    }
  });
  /* --- Check Eligibility Ends ---*/

  $j(document).on("click", ".reset-filter .lnk-reset", function () {
    $j(".dropdown-wrapper ul li").removeClass("active-li");
    $j(".dropdown-wrapper ul li:first-child").addClass("active-li");
    $j(".dropdown-wrapper").each(function () {
      var inittext = $j(this).find("ul li:first-child").text().trim();
      $j(this).find(".ddlSelectedValue").text(inittext);
    });
    $j(".news-filter-row input.field__input").val("");
    if (!$j(this).hasClass("filter_executed")) {
      $j(this).addClass("filter_executed");
      filterNewsItem();
    }
  });

  $j(document).on("click", ".news-filter-row .button", function () {
    if ($j(".reset-filter .lnk-reset").hasClass("filter_executed")) {
      $j(".reset-filter .lnk-reset").removeClass("filter_executed");
    }
    filterNewsItem();
  });

  /* --- Policy:Setting up cookie on Button Click --- */
   if (document.getElementsByClassName("btnsaveInsurance").length > 0) {
    document.getElementsByClassName("btnsaveInsurance")[0].onclick = function (
      e
    ) {

        console.log("Button Clicked");

      var selector = "";
      let checkCompany;
      let excUrl;
      if ($j(".policy-holder-type-wrapper.show li input:checked").length > 0) {
        selector = $j(
          ".policy-holder-type-wrapper.show li input:checked"
        ).parent();
        checkCompany = $j(".policy-holder-type-wrapper.show li input:checked")
          .parent()
          .attr("data-centre");
      } else {
        selector = $j(".selected-insurance a");
        checkCompany = $j(".selected-insurance").attr("data-centre");
       // excUrl = $j(".selected-insurance a").attr("exception-url");
      }
      var checkPolicy,
        addExactPageUrl = selector.data("url");
      var anchorUrl =
        $j(".clickedPolicyLink").attr("href") !== undefined
          ? $j(".clickedPolicyLink").attr("href")
          : "";
      var checkPolicyChange = $j(e.target).parents(".changePolicyExecuted")
        .length
        ? window.location.pathname
        : "";
      if ($j(".clickedPolicyLink").hasClass("policyLink")) {
        checkPolicy = $j(".clickedPolicyLink")
          .data("policy")
          .toString()
          .toLowerCase();
      }
      if ($j(".clickedPolicyLink").hasClass("rad-lightbox")) {
        checkPolicy = $j(".clickedPolicyLink").text().trim().toLowerCase();
      }
      if (
        checkPolicy.indexOf("profits") > -1 ||
        anchorUrl.indexOf("profits") > -1 ||
        checkPolicyChange.indexOf("profits") > -1
      ) {
        addExactPageUrl += "/with-profits";
      } else if (
        checkPolicy.indexOf("unit") > -1 ||
        anchorUrl.indexOf("unit") > -1 ||
        checkPolicyChange.indexOf("unit") > -1
      ) {
        addExactPageUrl += "/unit-linked-fund-prices";
      } else if (
        checkPolicy.indexOf("personal") > -1 ||
        checkPolicy.indexOf("personal") > -1 ||
        anchorUrl.indexOf("personal") > -1 ||
        checkPolicyChange.indexOf("personal") > -1
      ) {
        addExactPageUrl += "/change-of-personal-information";
      } else if (
        checkPolicy.indexOf("subject") > -1 ||
        anchorUrl.indexOf("subject") > -1 ||
        checkPolicyChange.indexOf("subject") > -1
      ) {
        addExactPageUrl += "/subject-access-request-form";
      } else if (
        checkPolicy.indexOf("guides") > -1 ||
        anchorUrl.indexOf("guides") > -1 ||
        checkPolicy.indexOf("how") > -1 ||
        checkPolicy.indexOf("make a complain") > -1 ||
        checkPolicyChange.indexOf("guides") > -1
      ) {
        addExactPageUrl =
          "/customer-centre/help-centre/how-to-guides/how-to-guides-" +
          addExactPageUrl
            .substring(addExactPageUrl.lastIndexOf("/"))
            .replace("/manage-my-policy-", "");
      } else if (
        checkPolicy.indexOf("complaint") > -1 ||
        anchorUrl.indexOf("complaint") > -1 ||
        checkPolicyChange.indexOf("complaint") > -1
      ) {
        addExactPageUrl =
          "/customer-centre/help-centre/how-to-guides/how-to-guides-" +
          addExactPageUrl
            .substring(addExactPageUrl.lastIndexOf("/"))
            .replace("/manage-my-policy-", "") +
          "/make-a-complaint";
      } else if (
        checkPolicy.indexOf("request") > -1 ||
        anchorUrl.indexOf("request") > -1 ||
        checkPolicyChange.indexOf("request") > -1
      ) {
        addExactPageUrl += "/contact/retirement-pack-request-form";
      } else if (
        checkPolicy.indexOf("contact") > -1 ||
        anchorUrl.indexOf("contact") > -1 ||
        checkPolicyChange.indexOf("contact") > -1
      ) {
        addExactPageUrl += "/contact";
      } else if (
        window.location.pathname === "/about-phoenix-life/sustainability/sustainability-disclosure"
      ) {
        addExactPageUrl += "/contact/contact-form";
      } else {
        addExactPageUrl;
      }
      var date = new Date();
      var dateToSet = new Date(date.setDate(date.getDate() + 30));
      //document.cookie = "selectedInsurance=" + '{"name":"'+document.getElementById("cmbo3").value+'","url":"'+selector.data("url")+'"}'+ ";" + "expires=" + dateToSet + ";" + "path=/";
     document.cookie = `selectedInsurance={"name":"${
        document.getElementById("cmbo3").value
      }","url":"${selector.data(
        "url"
      )}","company": "${checkCompany}"};expires=${dateToSet};path=/`;
      $j(".policyModalPopup.modal .close").trigger("click");
      $j.ajax({
        url: addExactPageUrl,
        success: function (result, status, xhr) {
          location.href = addExactPageUrl;
        },
        error: function (xhr, status, error) {
          location.href = selector.data("url");
        },
      });
    };
  }
});
/* --- Policy:Setting up cookie on Button Click --- */

window.onscroll = function () {
  backToTop();
};

/* --- Document Ready Starts--- */
$j(document).ready(function () {
resizeIframe();
  changeYearSlide();
  inPageLinks();
  if (
    $j(".hero-banner__inner").innerHeight() > 400 &&
    $j(window).width() > 1100
  ) {
    $j(".hero-banner__inner").css("bottom", "80px");
  }
  if ($j(".rad-caption").length > 0) {
    if ($j(".rad-caption").length == 1) {
      $j(".rad-caption").prepend(
        "<span class='close-tt' tabindex='-1'><img src='/~/media/Images/P/Phoenix-HWU-V3/icons/glossary-cross.svg' alt='close icon'></span>"
      );
    } else {
      $j(".rad-caption").each(function () {
        $j(this).prepend(
          "<span class='close-tt' tabindex='-1'><img src='/~/media/Images/P/Phoenix-HWU-V3/icons/glossary-cross.svg' alt='close icon'></span>"
        );
      });
    }
  }
  if ($j(".rad-popup").length) {
    $j(".rad-popup").each(function () {
      $j(this).replaceWith(
        $j(
          '<a href="javascript:;" class="rad-popup" aria-label="Read more on ' +
            $j(this).contents()[0].textContent +
            '">' +
            $j(this).html() +
            "</a>"
        )
      );
    });
  }

  if ($j(".rad-link").length > 0) {
    $j(".rad-link").each(function () {
      var currentLink = $j(this).attr("href");
      var findIndex = currentLink.split("/");
      var accordionItem = currentLink.split("/").pop();
      var accordionPageUrl = currentLink.split(
        findIndex[findIndex.length - 3]
      )[0];
      accordionPageUrl =
        "/" +
        accordionPageUrl.substring(
          accordionPageUrl.toString().lastIndexOf("/"),
          1
        ) +
        "#" +
        accordionItem;
      $j(this).attr("href", accordionPageUrl);
    });
  }
  if (window.location.hash != "" || window.location.hash != "") {
    linkedSnapdown(window.location.hash.replace("#", ""));
  }
  if ($j(".loginRegister-page .combo__list").length < 1) {
    var clonedItems = $j(".combo__list").clone(false);
    clonedItems.find(".policy-holder-innerwrap").each(function () {
      if ($j(this).children().length > 0) {
        $j(this)
          .find("input")
          .each(function () {
            var currId = $j(this).attr("id");
            var gname = $j(this).attr("name");
            $j(this)
              .attr("name", gname + "1")
              .attr("id", currId + "1");
            $j(this)
              .next("label")
              .attr("for", currId + "1");
          });
      }
    });
    clonedItems.insertAfter($j(".loginRegister-page input"));
  }
  manageGlossary();
});

$j(document).on("click", ".rad-filter", function (e) {
  e.preventDefault();
  $j(".glossary-link").trigger("click");
});
$j(document).on("click", ".tab-a", function (){
  $j(this)
    .parents("section")
    .find(".tab-holder")
    .children(".tab")
    .removeClass("tab-active");
  $j(this)
    .parents("section")
    .find(".tab[data-id='" + $j(this).attr("data-id") + "']")
    .addClass("tab-active");
  $j(this).parents("section").find(".tab-a").removeClass("active-a");
  $j(this).parent().find(".tab-a").addClass("active-a");
  
});

$j(document).on("click", ".ddlSelectedValue", function (e) {
  e.preventDefault();
  if ($j(this).parent().hasClass("active_ddl")) {
   //$j(this).parent().parent().toggleClass('.300');
    $j(this).next("ul").slideUp(300).parent().removeClass("active_ddl");
    $j(this).next("ul").slideUp(300).parent().removeClass("active_ddl");
  } else {
  
    $j(this).next("ul").slideDown(300).parent().addClass("active_ddl");
  }
});

$j(document).on("click", ".dropdown-wrapper ul li", function () {
  var currentText = $j(this).text().trim();
  $j(this)
    .parents(".dropdown-wrapper")
    .find(".ddlSelectedValue")
    .text(currentText)
    .trigger("click")
    .parents(".dropdown-wrapper")
    .find("li")
    .removeClass("active-li");
  $j(this).addClass("active-li");
});

$j(document).on(
  "click",
  ".tab-main-wrapper .tab-inner ul li a, .custom-tab-wrapper ul li a",
