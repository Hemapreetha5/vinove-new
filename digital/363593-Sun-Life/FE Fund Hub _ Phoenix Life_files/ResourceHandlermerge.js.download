let bool = false;
var menuAccessFlag = 0;
var clickFlag = 0;
let dcYesWrapper, dcNoWrapper, prevBtn, dcMainWrapper, dcWrapper;
const getClass = (selector) => {
  return document.getElementsByClassName(selector)[0];
};
const manageBtns = () => {
  if (
    $j(".col-sm-12.content-wrapper > .button-wrapper.d-inline")
      .next("div.button-wrapper")
      .hasClass("d-inline")
  ) {
    var btnModule = $j(".col-sm-12.content-wrapper").children(
      ".button-wrapper.d-inline"
    );
    for (var i = 0, len = btnModule.length; i < len; i += 2) {
      btnModule
        .slice(i, i + 2)
        .wrapAll(
          `<section class="container ${
            document.getElementsByClassName("death-claim").length ? "pt-0" : ""
          }"></section>`
        );
    }
  } else if (
    $j(".col-sm-12.content-wrapper > .button-wrapper").next(
      "div.button-wrapper"
    ).length > 0
  ) {
    var btnModule = $j(".col-sm-12.content-wrapper").children(
      ".button-wrapper"
    );
    for (var i = 0, len = btnModule.length; i < len; i += 2) {
      btnModule
        .slice(i, i + 2)
        .wrapAll('<section class="container"></section>');
    }
  } else {
    var btnModule = $j(".col-sm-12.content-wrapper").children(
      ".button-wrapper"
    );
    for (var i = 0, len = btnModule.length; i < len; i++) {
      btnModule.wrapAll('<section class="container"></section>');
    }
  }
};
