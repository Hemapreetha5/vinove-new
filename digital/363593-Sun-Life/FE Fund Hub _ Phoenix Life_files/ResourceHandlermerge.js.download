//change icon on active of media link
function hasLinkAnimateAncestor(element) {
    var parent = element.parentElement;
    while (parent) {
      if (parent.classList && parent.classList.contains('link-animate')) {
        return true;
      }
      parent = parent.parentElement;
    }
    return false;
  }
  var linkTexts = document.querySelectorAll('.link-text');
  
  linkTexts.forEach(function(linkText) {
    linkText.addEventListener('mousedown', function() {
      var img = this.previousElementSibling;
      if (!hasLinkAnimateAncestor(this)) {
        var currentSrc = img.src;
        if (currentSrc.includes("media")) {
          img.src = "/~/media/Images/P/Phoenix-HWU-V3/icons/download-doc-link-grey.svg";
        } else if (currentSrc.includes("external")) {
          img.src = "/~/media/Images/P/Phoenix-HWU-V3/icons/external-link-grey.svg";
        }
      }
    });
  });
  
  // Function to handle click outside of link-text elements
  function handleClickOutside(event) {
    
    if (!event.target.closest('.link-text')) {
      
      var imgs = document.querySelectorAll('.link-icon');
      imgs.forEach(function(img) {
        img.src = "/~/media/Images/P/Phoenix-HWU-V3/icons/download-doc-link.svg"; 
      });
    }
  }
  
  document.addEventListener('click', handleClickOutside);
  
  
  
  
  
  
   
  
  
  //for unitlinkedprice/withprofit pages to check if policy is priviously selected or not
  var anchorElement1 = document.querySelector('#manage-my-policy-nav-nav-with-profits-level3 a');
  var anchorElement2 = document.querySelector('#manage-my-policy-nav-nav-unit-linked-fund-prices-level3 a');
  
  var anchorElement3 = document.querySelector('#customer-centre-nav-nav-manage-my-policy-level2 a');
  var selectedInsuranceCookie = getCookie("selectedInsurance");
  var cookieConsentV300 = v300Handler("__CookieConsentV300");
  var valChecker;
  function getCookie(name) { 
    var value = "; " + document.cookie;
    var parts = value.split("; " + name + "=");
    if (parts.length == 2) return parts.pop().split(";").shift();
  }
  function v300Handler(name){
   var value = "; " + document.cookie;
    var parts = value.split("; " + name + "=");
   if (parts.length == 2) {
      var cookieValue = JSON.parse(decodeURIComponent(parts.pop().split(";").shift()));
      valChecker = cookieValue.accepted; // Assign valChecker here
      console.log("v300 accepted value:", valChecker);
    }
  }
  function observeCookieConsent(anchorElement) {
    console.log("Observing cookie consent...");
    var observer = new MutationObserver(function(mutationsList, observer) {
      mutationsList.forEach(function(mutation) {
        if (mutation.type === 'attributes' && mutation.attributeName === 'checked') {
          console.log("Checked attribute changed");
          var cookieValue = JSON.parse(decodeURIComponent(getCookie("__CookieConsentV300")));
          if (cookieValue.checked === true) {
            console.log("Cookie consent accepted!");
            observer.disconnect();
            if (anchorElement) {
              console.log("Clicking anchor element...");
              anchorElement.click();
            }
          }
        }
      });
    });
      var config = { attributes: true, attributeFilter: ['checked'] };
    observer.observe(document.body, config);
  }
  function handleClick(anchorElement) {
    var interval = setInterval(function() {
      var cookieConsentV300 = getCookie("__CookieConsentV300");
      if (cookieConsentV300) {
        var cookieValue = JSON.parse(decodeURIComponent(cookieConsentV300));
        if (cookieValue.accepted === true) {
          clearInterval(interval);
          console.log("Cookie consent accepted! Clicking anchor element...");
          if (anchorElement) {
            anchorElement.click();
          }
        }
      }
    }, 1000); // Check every second for changes in the cookie value
  }
  
  if(window.location.href==='https://www.phoenixlife.co.uk/withprofits')
  {
      if(!selectedInsuranceCookie){
             console.log("Handling click for withprofits...");
          handleClick(anchorElement1);
      }
    //console.log("if:", window.location.href);
  
      //console.log({anchorElement2});
      //console.log("clicked");
      else
        {
      //console.log("cookie found");
      let obj = JSON.parse(selectedInsuranceCookie);
      let ar=window.location.href.split('/');
      //console.log('ar',ar);
      let len = ar.length;
      //console.log('url:',obj.url,ar[len-1]);
      let url_str=`${obj.url}/with-profits`;
      //console.log('raa url:',url_str);
      window.location.href = `${url_str}`;
      
        }   
  }  
    
    
  
  if(window.location.href==='https://www.phoenixlife.co.uk/unitlinked'){
    //console.log("else:", window.location.href);
    if(!selectedInsuranceCookie){
      handleClick(anchorElement2);
    }
    else
    {
      let obj = JSON.parse(selectedInsuranceCookie);
      let ar=window.location.href.split('/');
      //console.log('ar',ar);
      let len = ar.length;
      //console.log('url:',obj.url,ar[len-1]);
      let url_str=`${obj.url}/unit-linked-fund-prices`;
      //console.log('raa url:',url_str);
      window.location.href = `${url_str}`;
      
    }  
    
  }
  
// ineligible
if(window.location.href==='https://www.phoenixlife.co.uk/ineligible')
  {
      if(!selectedInsuranceCookie){
        handleClick(anchorElement3);
    }
      else{
        let obj = JSON.parse(selectedInsuranceCookie);
      let ar=window.location.href.split('/');
      let len = ar.length;
      let url_str=`${obj.url}`;
      window.location.href = `${url_str}`;
      }   
  }  
// end ineligible

    else if(window.location.href.includes("with-profits"))
    {
      if(!selectedInsuranceCookie){
        let anchorElement1 = document.querySelector('#manage-my-policy-nav-nav-with-profits-level3 a');
        //console.log({anchorElement});
        handleClick(anchorElement1);
      }
    }else if(window.location.href.includes("unit-linked-fund-prices")){
      if(!selectedInsuranceCookie){
        let anchorElement2 = document.querySelector('#manage-my-policy-nav-nav-unit-linked-fund-prices-level3 a');
        //console.log({anchorElement});
        handleClick(anchorElement2);
      }
    }  
  
  
  
/*!---- data-layer-----*/
$j(document).on("click", ".news-filter-row .button", function () {    
    var searchYear = document.querySelector(".tab-main-wrapper .tab-menu ul li a.active-a").textContent;
    var searchCategory = document.querySelector(".tab-main-wrapper .news-filter-row .category a").textContent;
    var searchTopic = document.querySelector(".tab-main-wrapper .news-filter-row .topics a").textContent;
    var searchTerm = document.querySelector(".tab-main-wrapper .news-filter-row .field__input").value;

    var searchAction = searchTerm ? 'Search Term - search results page' : 'Search Term - Latest news';

    var data = {
        'event': 'siteSearch',
        'searchAction': searchAction,
        'searchYear': searchYear,
        'searchCategory': searchCategory,
        'searchTopic': searchTopic
    };

    if (searchTerm) {
        data.searchTerm = searchTerm;
    }

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(data);
});


$j(document).on("click", ".news-content-wrap .latest-news-item .news-items .news-title a", function () {
	console.log("click on link");
    var searchYear = document.querySelector(".tab-main-wrapper .tab-menu ul li a.active-a").textContent;
    var searchCategory = document.querySelector(".tab-main-wrapper .news-filter-row .category a").textContent;
    var searchTopic = document.querySelector(".tab-main-wrapper .news-filter-row .topics a").textContent;
    var searchTerm = document.querySelector(".tab-main-wrapper .news-filter-row .field__input").value;
//     var linktext = document.querySelector(this).textContent.trim();
    var linktext = this.textContent.trim();

    window.dataLayer = window.dataLayer || [];    
    window.dataLayer.push({
        'event': 'siteSearch',
        'searchAction': 'Search Term - Link clicks',
        'searchYear': searchYear,
        'searchCategory': searchCategory,
        'searchTopic': searchTopic,
        'searchTerm': searchTerm,
        'searchResultsLink': linktext
    });
    

});

if (document.getElementsByClassName("btn-eligibility").length > 0) {
    document.getElementsByClassName("btn-eligibility")[0].onclick = function (
      e
    ) {
      var selector = "";
      let checkCompany;
      if ($j(".policy-holder-type-wrapper.show li input:checked").length > 0) {
        selector = $j(
          ".policy-holder-type-wrapper.show li input:checked"
        ).parent();
        checkCompany = $j(".policy-holder-type-wrapper.show li input:checked")
          .parent()
          .attr("data-centre");
      } else {
        selector = $j(".selected-insurance a");
        checkCompany = $j(".selected-insurance").attr("data-centre");
       console.log("checkCompany",checkCompany)
      }
      var checkPolicy,
      addExactPageUrl = selector.data("url");
      console.log("addExactPageUrl",addExactPageUrl)
      var checkPolicyChange = $j(e.target).parents(".loginRegister-page").length ? window.location.pathname : "";
      if (
        checkPolicyChange.indexOf("profits") > -1
      ) {
        addExactPageUrl += "/with-profits";
      } else if (
        checkPolicyChange.indexOf("unit") > -1
      ) {
        addExactPageUrl += "/unit-linked-fund-prices";
      } else if (
        checkPolicyChange.indexOf("personal") > -1
      ) {
        addExactPageUrl += "/change-of-personal-information";
      } else if (
        checkPolicyChange.indexOf("subject") > -1
      ) {
        addExactPageUrl += "/subject-access-request-form";
      } else if (
        checkPolicyChange.indexOf("guides") > -1
      ) {
        addExactPageUrl =
          "/customer-centre/help-centre/how-to-guides/how-to-guides-" +
          addExactPageUrl
            .substring(addExactPageUrl.lastIndexOf("/"))
            .replace("/manage-my-policy-", "");
      } else if (
        checkPolicyChange.indexOf("complaint") > -1
      ) {
        addExactPageUrl =
          "/customer-centre/help-centre/how-to-guides/how-to-guides-" +
          addExactPageUrl
            .substring(addExactPageUrl.lastIndexOf("/"))
           .replace("/manage-my-policy-", "") +
           "/make-a-complaint";
      } else if (
        checkPolicyChange.indexOf("request") > -1
      ) {
        addExactPageUrl += "/contact/retirement-pack-request-form";
      } else if (
        checkPolicyChange.indexOf("contact") > -1
      ) {
        addExactPageUrl += "/contact";
