  });
  $j.fn.wrapInTag = function(opts) {
	var fn= 'fnClass';
	var tag = opts.tag || 'strong',
		words = opts.words || [],
		regex = RegExp(words.join('|'), 'gi'),
		replacement = '<'+ tag +' class= '+fn+'>$&</'+ tag +'>';
  
	return this.html(function() {
	  return $j(this).html().replace(regex, replacement);
	});
  };
