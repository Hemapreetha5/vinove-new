function yearSlide(itemsPerSlide, isResized) {
  var $prev = $j(".tab-previous");
  var $next = $j(".tab-next");
  var $tabsList = $j(".tab-menu ul");
  var currentTransformX = 0;
  var $tabs = $j(".tab-menu ul li");
  var tabsLength = $tabs.length;
  var slideDifference = tabsLength - itemsPerSlide;
  var updatedDifference = slideDifference;
  var ulWidth = 0;
  var activeIndex = $j(".active-a").index(".tab-a") + 1;
  var liWidth = $j(".tab-menu").width() / itemsPerSlide;
  $j(".tab-menu ul li").width(liWidth);
  ulWidth = tabsLength * liWidth;
 
//console.log("activeIndex:",activeIndex);
// console.log("itemsPerSlide:",itemsPerSlide);
// console.log("tabsLength:",tabsLength);

  $j(".tab-menu ul").width(ulWidth);
  if (activeIndex > itemsPerSlide) {
    currentTransformX = -((activeIndex - itemsPerSlide) * liWidth);
$tabsList.css("transform", "translateX(" + currentTransformX + "px)");
    updatedDifference = tabsLength - activeIndex;
    //console.log("Updated Difference on active change ", updatedDifference);
  }

  if (tabsLength == activeIndex) {
    $next.addClass("disableTag");
  }
  if (activeIndex == 1) {
    $prev.addClass("disableTag");
  }
  $next.on("click", function () {
  
    if (window.innerWidth < 576) {
      if (isResized) return;
      if (
        $j(".active-a")
          .parents("ul")
          .find("li:last-child")
          .children(".active-a").length
      )
        return;
      $j(".active-a").parent().next().find(".tab-a").trigger("click");
      return;
    }
    if (updatedDifference != 0) {
      //$tabs.position().left;
      $prev.removeClass("disableTag");
      currentTransformX -= liWidth;
      $tabsList.css("transform", "translateX(" + currentTransformX + "px)");
      updatedDifference--;
      //console.log("Updated Difference on next ", updatedDifference);
    }
   
    if (updatedDifference == 0) {
      $next.addClass("disableTag");
      
    }
    // tabbbing index update
    if (updatedDifference == 1) {
      if($j("body").hasClass("show-focus-outlines")){
        $next.addClass("disableTag");
      }
    }
  });

  $prev.on("click", function () {
    if (window.innerWidth < 576) {
      if (isResized) return;
      if (
        $j(".active-a")
          .parents("ul")
          .find("li:first-child")
          .children(".active-a").length
      )
        return;
      $j(".active-a").parent().prev().find(".tab-a").trigger("click");
      return;
    }
    if (currentTransformX == 0) {
      return;
    }
    $next.removeClass("disableTag");
    currentTransformX += liWidth;
    $tabsList.css("transform", "translateX(" + currentTransformX + "px)");
    if (updatedDifference != slideDifference) {
      //console.log("Updated Difference on before prev inside if ", updatedDifference);
      updatedDifference++;
    }
    if (updatedDifference == slideDifference) {
      $prev.addClass("disableTag");
    }
    //console.log("Updated Difference on after prev ", updatedDifference);
  });
}
$j(window).on("resize", function () {
  // yearSlide();
  moveHeaderItems();
  changeYearSlide();
  manageListWidth();
  manageTooltipPosition();
  manageActiveTooltip();
  /* --- Our History Starts --- */
  if ($j(".our-history-white-item label.active").length > 0) {
    if ($j(window).width() > 767) {
      if (
        $j(".our-history-inner-container input:checked").next(
          ".our-history-timeline"
        ).length === 0
      ) {
        $j(".activeHistoryContent")
          .removeClass("open activeHistoryContent")
          .insertAfter($j(".our-history-inner-container input:checked"));
      }
    } else {
      if (
        $j("label.active").parent().next(".our-history-timeline ").length === 0
      ) {
        $j(
          ".our-history-inner-container input[id='" +
            $j("label.active").attr("for") +
            "']"
        )
          .next()
          .addClass("open activeHistoryContent")
          .insertAfter($j("label.active").parent());
      }
    }
  }
  /* --- Our History Ends --- */
  if ($j(".hero-banner__inner").length > 0) {
    if (
      $j(".hero-banner__inner").innerHeight() > 400 &&
      $j(window).width() > 1100
    ) {
      $j(".hero-banner__inner").css("bottom", "80px");
    } else {
      if ($j(".hero-banner__inner").attr("style") != "") {
        $j(".hero-banner__inner").attr("style", "");
      }
    }
  }
});
function inPageLinks() {
  if ($j(".inpage-link-wrapper").length > 0) {
    var links = [];
    $j(".inpage__links li:not(.inpage__title)").each(function () {
      links.push($j(this).attr("data-modules"));
    });
    $j("section[id='" + value + "']").addClass("linked-section");
    links.forEach(function (value) {
      $j("section[id='" + value + "']").addClass(
        "linked-section overflow-hidden"
      );
    });
    $j("article .linked-section:first").addClass("active");

    const changeNav = (entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.intersectionRatio >= 0.55) {
          document
            .querySelector(".inpage__link--active")
            .classList.remove("inpage__link--active");
          var id = entry.target.getAttribute("id");
          var newLink = document
            .querySelector(`[href="#${id}"]`)
            .parentElement.classList.add("inpage__link--active");
        }
      });
    };
    const options = {
      threshold: 0.55,
    };

    const observer = new IntersectionObserver(changeNav, options);

    // target the elements to be observed
    const sections = document.querySelectorAll("section.linked-section");
    sections.forEach((section) => {
      observer.observe(section);
    });
    var firstItemTop, lastItem, lastItemTop, linkWrapper, linkWrapperBottom;
    $j(window).on("resize", function () {
      firstItemTop = $j(
        "section[id='" +
          $j(".inpage-link-wrapper a").eq(0).attr("href").replace("#", "") +
          "']"
      ).offset().top;
      lastItem =
        $j(
          "section[id='" +
            $j(".inpage-link-wrapper a").last().attr("href").replace("#", "") +
            "']"
        ).offset().top +
        $j(
          "section[id='" +
            $j(".inpage-link-wrapper a").last().attr("href").replace("#", "") +
            "']"
        ).height();
      lastItemTop = $j(
        "section[id='" +
          $j(".inpage-link-wrapper a").last().attr("href").replace("#", "") +
          "']"
      ).offset().top;
      linkWrapper =
        $j(".inpage-link-wrapper").height() > 270
          ? $j(".inpage-link-wrapper").height() / 2 -
            ($j(".inpage-link-wrapper").height() - 270)
          : $j(".inpage-link-wrapper").height() / 2;
      linkWrapperBottom =
        $j(".inpage-link-wrapper").height() > 270
          ? $j(".inpage-link-wrapper").height()
          : $j(".inpage-link-wrapper").height() +
            ($j(".inpage-link-wrapper").height() - 270);
    });
    firstItemTop = $j(
      "section[id='" +
        $j(".inpage-link-wrapper a").eq(0).attr("href").replace("#", "") +
        "']"
    ).offset().top;
    lastItem =
      $j(
        "section[id='" +
          $j(".inpage-link-wrapper a").last().attr("href").replace("#", "") +
          "']"
      ).offset().top +
      $j(
        "section[id='" +
          $j(".inpage-link-wrapper a").last().attr("href").replace("#", "") +
          "']"
      ).height();
    lastItemTop = $j(
      "section[id='" +
        $j(".inpage-link-wrapper a").last().attr("href").replace("#", "") +
        "']"
    ).offset().top;
    linkWrapper =
      $j(".inpage-link-wrapper").height() > 270
        ? $j(".inpage-link-wrapper").height() / 2 -
          ($j(".inpage-link-wrapper").height() - 270)
        : $j(".inpage-link-wrapper").height() / 2;
    linkWrapperBottom =
      $j(".inpage-link-wrapper").height() > 270
        ? $j(".inpage-link-wrapper").height()
        : $j(".inpage-link-wrapper").height() +
          ($j(".inpage-link-wrapper").height() - 270);

    $j(".inpage-link-wrapper")
      .css("top", firstItemTop - linkWrapper)
      .parent()
      .addClass("showVisibility");

    if (document.readyState === "interactive") {
      $j(window).trigger("scroll");
    }

    $j(window).on("scroll", function () {
      if (
        $j(this).scrollTop() > firstItemTop &&
        $j(this).scrollTop() < lastItemTop - 40
      ) {
        $j(".inpage-link-wrapper")
          .attr("style", "")
          .parent()
          .addClass("sticky_links");
      } else if ($j(this).scrollTop() < firstItemTop) {
        $j(".inpage-link-wrapper")
          .css("top", firstItemTop - linkWrapper)
          .parent()
          .removeClass("sticky_links");
      } else {
        $j(".inpage-link-wrapper")
          .css("top", lastItemTop - linkWrapperBottom)
          .parent()
          .removeClass("sticky_links");
      }
    });
  }
}

function manageTooltipPosition(selector) {
  if (selector === undefined && $j(".open-tt").length) {
    selector = $j(".open-tt");
  }
  if ($j(selector).hasClass("open-tt").length > 0) {
    if ($j(selector).children(".rad-caption").offset().left < 0) {
      $j(selector)
        .children(".rad-caption")
        .css("left", $j(selector).offset().left / 2);
      var offset = $j(".open-tt").width() / 2;
      var style = document.createElement("style");
      style.setAttribute("id", "caption");
      style.innerHTML =

        ".open-tt .rad-caption:before { left:" + offset + "px }";
      if ($j("#caption").length < 1) {
        document.body.appendChild(style);
      } else {
        $j("#caption").html(
          ".open-tt .rad-caption:before { left:" + offset + "px }"
        );
      }
    } else {
      $j(".rad-caption").attr("style", "");
      $j("#caption").html("");
    }
  }
}
function manageListWidth(selector) {
  if (selector === undefined && $j(".policyPopup").is(":visible")) {
    selector = $j(".policyPopup .btn-list");
  }
  if ($j(".policyPopup").is(":visible")) {
    if ($j(window).width() > 599) {
      $j(selector)
        .parent()
        .find(".combo__list")
        .width(
          $j(selector).offset().left -
            $j(selector).offsetParent().offset().left +
            $j(selector).width() +
            64
        );
    } else {
      $j(selector)
        .parent()
        .find(".combo__list")
        .width($j(selector).parent().find("input").outerWidth());
    }
  }
}
function changeYearSlide(isResized) {
  if ($j(".tab-menu").length > 0) {
    if ($j(window).width() > 991 && $j(".tab-menu ul li").length > 6) {
      yearSlide(6);
    } else if (
      $j(window).width() < 992 &&
      $j(window).width() > 576 &&
      $j(".tab-menu ul li").length > 3
    ) {
      yearSlide(3);
    } else if (
      $j(window).width() < 992 &&
      $j(window).width() > 576 &&
      $j(".tab-menu ul li").length < 4
    ) {
      $j(".tabs").hide();
      $j(".tab-container").addClass("p-0");
      $j(".tab-menu ul,.tab-menu ul li").attr("style", "");
    } else if ($j(window).width() < 577) {
      if (!$j(".tabs").is(":visible")) {
        $j(".tabs").show();
        $j(".tab-container").removeClass("p-0");
      }
      yearSlide(1, isResized);
    } else if ($j(".tab-menu ul li").length < 7) {
      $j(".tab-menu ul,.tab-menu ul li").attr("style", "");
    } else {
      return;
    }
  }
}
function backToTop() {
  if (document.body.scrollTop > 50 || document.documentElement.scrollTop > 50) {
    $j(".b2t-wrapper,.glossary-wrapper").addClass("userScrolled");
    //document.querySelector(".b2t-wrapper").classList.add("userScrolled");
  } else {
    $j(".b2t-wrapper,.glossary-wrapper").removeClass("userScrolled");
    //document.querySelector(".b2t-wrapper").classList.remove("userScrolled");
  }
}

function linkedSnapdown(selector) {
  if (
    $j(".accordian-wrapper input[data-snapdown='" + selector + "']").length > 0
  ) {
    if (
      !$j(
        ".accordian-wrapper input[data-snapdown='" +
          selector +
          "'] + label + .section__content"
      ).is(":visible")
    ) {
      $j(".accordian-wrapper input[data-snapdown='" + selector + "']").trigger(
        "click"
      );
    }
    $j("html,body").animate(
      {
        scrollTop: $j(
          ".accordian-wrapper input[data-snapdown='" + selector + "'] + label"
        ).offset().top,
      },
      1000
    );
  }
}

function filterNewsItem() {
  var selectedCategory = $j(".dropdown-wrapper.category ul li.active-li").data(
    "cat"
  );
  var selectedTopic = $j(".dropdown-wrapper.topics ul li.active-li").data(
    "topic"
  );
  var searchText =
    $j(".news-filter-row input.field__input").val() == ""
      ? "*"
      : $j(".news-filter-row input.field__input").val();
  var url = window.location.origin + window.location.pathname;
  $j.ajax({
    url:
      url +
      (location.href.indexOf("?") > 0
        ? "&"
        : "?" +
          "async=1&category=" +
          selectedCategory +
          "&topic=" +
          selectedTopic +
          "&freetext=" +
          searchText),
    beforeSend: function () {
      $j(".loader-overlay").show();
    },
    complete: function () {
      $j(".loader-overlay").hide();
    },
    success: function (data) {
      $j(".news-content-wrap").remove();
      $j(".tab.tab-active").append(data);

      findAndReplaceDOMText(document.querySelector("body"), {
        find: /\?/g,
        wrap: "abbr",
        wrapClass: "fnClass",
      });
    },
  });
}

function moveHeaderItems() {
  if ($j(window).width() > 991) {
    if ($j(".navigation__topbar > li.level1").length > 0) {
      $j(".navigation__topbar > li.level1").appendTo(".nav_icons_wrapper");
    }
  } else {
    if ($j(".nav_icons_wrapper li:not(:first-child)").length > 0) {
      $j(".nav_icons_wrapper li:not(:first-child)").insertAfter(
        ".navigation__topbar .logo"
      );
    }
  }
}

/*------------ Main menu ---------------------*/

let focusableElements;
let focusableHFinalArray = [];
if (document.getElementsByClassName("our-history-inner-container")[0]) {
  focusableElements = document.querySelectorAll(
    ".our-history-white-item label[tabindex='0']"
  );
  focusableElements.forEach((el) => {
    let checkAccordion = el.getAttribute("for");
    focusableHFinalArray.push(el);
    if (
      document.querySelectorAll(
        `input[id="${checkAccordion}"] + .our-history-timeline .accordian-wrapper input`
      ).length > 0
    ) {
      document
        .querySelectorAll(
          `input[id="${checkAccordion}"] + .our-history-timeline .accordian-wrapper input`
        )
        .forEach((inp) => {
          focusableHFinalArray.push(inp);
        });
    }
  });
}
const historyFocusableElements = (e) => {
  if (!document.getElementsByClassName("our-history-inner-container")[0]) {
    return;
  }
  const index = focusableHFinalArray.indexOf(document.activeElement);
  let nextIndex = 0;
  if (e.shiftKey && e.keyCode === 9) {
    if (focusableHFinalArray.indexOf(document.activeElement) === 0) {
      return;
    }
    e.preventDefault();
    nextIndex = index > 0 ? index - 1 : 0;
    if (
      $j(document.activeElement).is("label:not(.active)") &&
      $j(focusableHFinalArray[nextIndex]).is("input") &&
      getComputedStyle(
        focusableHFinalArray[nextIndex].closest(".our-history-timeline")
      ).opacity == "0"
    ) {
      for (let i = nextIndex; i >= 0; i--) {
        if ($j(focusableHFinalArray[i]).is("label")) {
          nextIndex = i;
          break;
        }
      }
    }
    focusableHFinalArray[nextIndex].focus();
  } else if (e.keyCode === 9) {
    if (
      focusableHFinalArray.indexOf(document.activeElement) ==
      focusableHFinalArray.length - 1
    ) {
      return;
    }
    e.preventDefault();
    nextIndex = index + 1 < focusableHFinalArray.length ? index + 1 : index;
    if (
      $j(document.activeElement).is("label:not(.active)") &&
      $j(focusableHFinalArray[nextIndex]).is("input") &&
      getComputedStyle(
        focusableHFinalArray[nextIndex].closest(".our-history-timeline")
      ).opacity == "0"
    ) {
      for (let i = nextIndex; i < focusableHFinalArray.length; i++) {
        if ($j(focusableHFinalArray[i]).is("label")) {
          nextIndex = i;
          break;
        }
      }
    }
    focusableHFinalArray[nextIndex].focus();
  } else if (e.keyCode === 13 && e.target.tagName != "INPUT") {
    e.preventDefault();
    $j(e.target).trigger("click");
  }
};

document.addEventListener("keydown", function (e) {
  if (e.keyCode === 9) {
    $j("body").addClass("show-focus-outlines");
  }
  let currTarget = e.target;
  if (
    (currTarget.tagName === "LABEL" || currTarget.tagName === "INPUT") &&
    $j(".our-history-white-item").length
  ) {
    historyFocusableElements(e);
  }
});

