  /* --- Policy: Changing input value by keyup functionality --- */
  $j(document).on("keyup", "#cmbo3,#cmbo2", function () {
    let curValue = $j(this).val().toLowerCase();
    $j(this)
      .parent()
      .children(".combo__list")
      .children("li")
      .each(function () {
        if (
          $j(this).children("a").text().toLowerCase().indexOf(curValue) == 0 &&
          (curValue != "" || curValue != "")
        ) {
          $j(this).removeClass("invisible").addClass("show");
          if (!$j(this).parent(".combo__list").is(":visible")) {
            $j(this).parent(".combo__list").fadeIn();
          }  
          if (
            !$j(this)
              .parents(".input-field")
              .find(".icon-symbol")
              .children(".search-close")
              .is(":visible")
          ) {
            $j(this)
              .parents(".input-field")
              .find(".icon-symbol")
              .children("img:not(.search-close)")
              .hide();
            $j(this)
              .parents(".input-field")
              .find(".icon-symbol")
              .children(".search-close")
              .show();
          }
          if ($j(this).parent(".combo__list").attr("style").indexOf("px")) {
            $j(this).parent(".combo__list").css("width", "100%");
          }
        } else {
          $j(this).addClass("invisible").removeClass("show");
        }
        if (
          $j(this).children("a").text().toLowerCase().trim() == curValue &&
          $j(this)
            .parents(".modal-wrapper")
            .find(".btnPolicyCheck")
            .hasClass("disableTag")
        ) {
          $j(this)
            .parents(".modal-wrapper")
            .find(".btnPolicyCheck");
           // .removeClass("disableTag");
          return false;
        } else {
          if (
            !$j(this)
              .parents(".modal-wrapper")
              .find(".btnPolicyCheck")
              .hasClass("disableTag")
          ) {
            $j(this)
              .parents(".modal-wrapper")
              .find(".btnPolicyCheck")
              .addClass("disableTag");
          }
          if (
            !$j(this)
              .parents(".dc-no-wrapper")
              .find(".btnPolicyCheck")
              .hasClass("disableTag")
          ) {
            $j(this)
              .parents(".dc-no-wrapper")
              .find(".btnPolicyCheck")
              .addClass("disableTag");
          }
        }
      });
    if (curValue == "" || curValue == "") {
      $j(".combo__list li").removeClass("invisible");
      $j(".combo__list li").removeClass("selected-insurance");
      if ($j(this).next(".combo__list").is(":visible")) {
        $j(this).next(".combo__list").fadeOut();
      }
      if (
        !$j(this)
          .parent()
          .find(".icon-symbol")
          .children("img:not(.search-close)")
          .is(":visible")
      ) {
        $j(this).parent().find(".icon-symbol").children("img").hide();
        $j(this)
          .parent()
          .find(".icon-symbol")
          .children("img:not(.search-close)")
          .show();
      }
    }
  });
  /* --- Policy: Changing input value by keyup functionality --- */

  /* --- Policy: Clicking on policy list functionality --- */
  $j(document).on(
    "click",
    ".combo__list > li.combo__list-option",
    function (e) {
      e.preventDefault();
      if (
        $j(this)
          .parents(".model-filer")
          .find(".policy-holder-type-wrapper.show").length > 0
      ) {
        $j(this)
          .parents(".model-filer")
          .find(".policy-holder-type-wrapper.show")
          .find(".policy-holder-innerwrap li input")
          .prop("checked", false);
        $j(this)
          .parents(".model-filer")
          .find(".policy-holder-type-wrapper.show")
          .removeClass("show")
          .appendTo($j(this).parent().find(".selected-insurance"));
      }
      if (
        $j(this).find(".policy-holder-innerwrap").children("li").length > 0 &&
        ($j(e.target).parents(".policyModalPopup").length ||
          $j(e.target).parents(".dc-no-wrapper").length)
      ) {
        //$j(this).children(".policy-holder-type-wrapper").insertBefore(".policyModalPopup .model-filer .btnPolicyCheck").addClass("show");
        if ($j(e.target).parents(".dc-no-wrapper").length) {
          $j(this)
            .children(".policy-holder-type-wrapper")
            .insertBefore(
              $j(this).parents(".model-filer").find(".btnPolicyCheck").prev("p")
            )
            .addClass("show");
        } else {
          $j(this)
            .children(".policy-holder-type-wrapper")
            .insertBefore(
              $j(this).parents(".model-filer").find(".btnPolicyCheck")
            )
            .addClass("show");
        }
      }
      //$j(".combo__list li").removeClass("selected-insurance");
      $j(this)
        .parent(".combo__list")
        .children("li")
        .removeClass("selected-insurance");
      $j(this).addClass("selected-insurance");
      $j(this).parent().parent().children("input").val("");
      $j(this)
        .parent()
        .parent()
        .children("input")
        .val($j(this).children("a").text());
      //$j("#cmbo3").val("");
      //$j("#cmbo3").val($j(this).children("a").text());

      if (
        $j(this).find("a span").text().trim() ==
        $j(this).parent().parent().children("input").val().trim()
      ) {
        //if($j(".combo__list-option.selected-insurance a span").text().trim() == $j(this).parent().parent().children("input").val().trim()){
        if (
          $j(this)
            .parents(".modal-wrapper")
            .find(".btnPolicyCheck")
            .hasClass("disableTag")
        ) {
          $j(this)
            .parents(".modal-wrapper")
            .find(".btnPolicyCheck")
            .removeClass("disableTag");
        }
        if (
          $j(this)
            .parents(".dc-no-wrapper")
            .find(".btnPolicyCheck")
            .hasClass("disableTag")
        ) {
          $j(this)
            .parents(".dc-no-wrapper")
            .find(".btnPolicyCheck")
            .removeClass("disableTag");
        }
        if (
          !$j(this)
            .parents(".field-wrapper")
            .find(".icon-symbol")
            .children(".search-close")
            .is(":visible")
        ) {
          $j(this)
            .parents(".field-wrapper")
            .find(".icon-symbol")
            .children("img")
            .hide()
            .parent()
            .children(".search-close")
            .show();
        }
      }
    }
  );
  /* --- Policy: Clicking on policy list functionality --- */

  /* --- Policy: Open droplist on input focus --- */
