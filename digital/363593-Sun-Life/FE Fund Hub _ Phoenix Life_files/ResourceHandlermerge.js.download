var prevTabs = document.getElementsByClassName(".tab-menu ul")
var totalTabsLength =document.querySelectorAll(".tab-menu ul li").length;
var targetedTab = document.querySelectorAll(".tab-menu ul li")
//console.log(prevTabs);
//console.log("totaltabs:",totalTabsLength);
//console.log(targetedTab);
function clickedOnExtraTab(){
  var activeIndex = $j(".active-a").index(".tab-a") + 1;
  var totalTabsLength =document.querySelectorAll(".tab-menu ul li").length;
  if(activeIndex > 6){
    //console.log("clicked on extra tab");
    getTranslateXVal();
    cornerTab();
  }
  }
  function getTranslateXVal(){
// Get the ul element
var ulElement = $('.tab-menu ul')[0];
 
// Get the computed style of the ul element
var style = ulElement.style.transform || window.getComputedStyle(ulElement).getPropertyValue('transform');
 
// Parse the translateX value from the transform property
var matrix = new DOMMatrix(style);
var translateXValue = matrix.m41;
 
// Log the translateX value
//console.log('translateX value:', translateXValue);
 
 
}
function cornerTab(){

var activeAnchor = $('.tab-menu ul li a.active-a');

var fifthAnchor = activeAnchor.parent().prevAll('li').eq(4).find('a');

var anchorValue = fifthAnchor.text();

//console.log('Value of the anchor tag 5 elements before the active anchor:', anchorValue);

// Add event listener for focus event
fifthAnchor.on('focus', function () {
   // console.log('Focus went on the fifth anchor:', anchorValue);
    
    // Change the translateX value to 0
    $j('.tab-menu ul').css('transform', 'translateX(0)');
    $j('.tab-inner > a.tab-next').removeClass('disableTag');
    $j('.tab-inner > a.tab-previous').addClass('disableTag');
     $('.tab-inner > a.tab-previous').on('keydown', function (event) {
        // Prevent the default action (disable the link)
        if (event.key !== 'Tab') {
            event.preventDefault();
        }
    });
});
}

//focus functionality on mmenu
 
document.addEventListener('DOMContentLoaded', function () {
    // Find the elements
    var mobMenuLabel = document.querySelector('label.mob-menu');
    var mainElement = document.querySelector('main');
    var mainNavCheck = document.getElementById('main-nav-check');
    var navigationElement = document.querySelector('.header nav.navigation');
    var specificAnchor = document.querySelector('nav ul#nav-section-Homepage-level1 li#Homepage-nav-nav-register-level1 a');
    var nav = document.querySelector('nav.navigation');

    function handleEnterKey(event) {
        if (event.key === 'Enter') {
            mainNavCheck.checked = !mainNavCheck.checked;
            mainElement.classList.toggle('bk-menu-overlay');
            nav.classList.toggle('active-mmenu');
            //navigationElement.style.display = 'block';
            
        }
    }
    if(specificAnchor){
      document.addEventListener('keydown', function (event) {
                if (document.activeElement === specificAnchor && (event.key === 'Tab')) {
                console.log("clicked forced")
                    mobMenuLabel.click();
                }
            });
    }

    if (mobMenuLabel && mainElement) {
    
        mobMenuLabel.addEventListener('focus', function () {
            document.addEventListener('keypress', handleEnterKey);
			//document.addEventListener('click', toggleNavClass)
          
        });

        mobMenuLabel.addEventListener('blur', function () {
            document.removeEventListener('keypress', handleEnterKey);
        });
    }
});





/*on focus of hamburger icon block the megamenu*/

let currentOpenedLevel1;

document.addEventListener('keydown', function (event) {
  if (event.key === 'Escape') {
    hideLevel1Menu(currentOpenedLevel1);
  }
});

// Function to check if the screen width is above 991.98px
function isLargeScreen() {
  return window.innerWidth > 991.98;
}

function addEventListeners() {
  // Get all anchor tags inside li.level1 elements
  const level1Anchors = document.querySelectorAll('.navigation .ulLevel0 .level1 a');
  level1Anchors.forEach(anchor => {
    anchor.addEventListener('focus', function () {
      showLevel1MenuForLevel1(anchor.closest('.level1'));
    });
  });

  // Get all li.level1 elements
  const level1Items = document.querySelectorAll('.navigation .ulLevel0 .level1');

  level1Items.forEach(level1Item => {
    level1Item.addEventListener('mouseenter', function () {
      showLevel1Menu(this);
    });

    level1Item.addEventListener('mouseleave', function () {
      hideLevel1Menu(this);
    });

    level1Item.addEventListener('blur', function () {
      handleBlur(this);
      hideLevel1Menu(this);
    });

    const level1Menu = level1Item.querySelector('.ulLevel1');

    if (level1Menu) {
      // Add focusin event listener to the submenu itself
      level1Menu.addEventListener('focusin', function () {
        showLevel1Menu(level1Item);
      });

      // Add focusout event listener to the submenu itself
      level1Menu.addEventListener('focusout', function () {
        handleBlur(level1Item);
        hideLevel1Menu(level1Item);
      });
    }
  });
}

// Initial check and adding event listeners
if (isLargeScreen()) {
  addEventListeners();
}

// Event listener for window resize
window.addEventListener('resize', function () {
  if (isLargeScreen()) {
    addEventListeners();
  }
});

function showLevel1Menu(element) {
  const level1Menu = element.querySelector('.ulLevel1');
  if (level1Menu) {
    level1Menu.style.visibility = 'visible';
    level1Menu.style.opacity = '1';
    currentOpenedLevel1 = element;
  }
}

function hideLevel1Menu(element) {
  if (element) {
    const level1Menu = element.querySelector('.ulLevel1');
    if (level1Menu) {
      level1Menu.style.visibility = 'hidden';
      level1Menu.style.opacity = '0';
      currentOpenedLevel1 = null;
    }
  }
}

function showLevel1MenuForLevel1(level1Element) {
  // If the focus moves to a different level1 element, hide the previous ulLevel1
  hideLevel1Menu(currentOpenedLevel1);

  // Show the ulLevel1 for the newly focused level1
  showLevel1Menu(level1Element);
}

function handleBlur(level1Item) {
  const anchorInsideLevel1 = level1Item.querySelector('a.active-menu-element');
  if (anchorInsideLevel1) {
    anchorInsideLevel1.classList.remove('active-menu-element');
  }
}

