
/*!---- custom-----*/
$j(document).on("keydown",".modal-wrapper input",function(e){
	if($j(".combo__list").is(":visible")){
	  if(e.keyCode === 40){
		if(!$j(this).parent().find(".combo__list li.show").hasClass("focused")){
		  console.log("down pressed");
		  $j(this).parent().find(".combo__list li.show").first().addClass("focused").children("a").focus();
		}
	  }   
	}  
  });
  
  
  $j(document).on("keydown",".combo__list li",function(e){
	if($j(".combo__list").is(":visible")){
	  if(e.keyCode === 40){
		$j(".combo__list li").removeClass("focused");
		$j(this).addClass("focused").next().children("a").focus();
	  }
	}
  });
  
  /*-----------*/
  
  $j(document).on("keyup",".modal-wrapper input",function(e){
	if($j(".combo__list").is(":visible")){
	  if(e.keyCode === 38){
		if(!$j(this).parent().find(".combo__list li.show").hasClass("focused")){
		  console.log("down pressed");
		  $j(this).parent().find(".combo__list li.show").first().addClass("focused").children("a").focus();
		}
	  }    
	}  
	
  });
  
  
  $j(document).on("keyup",".combo__list li",function(e){
	if($j(".combo__list").is(":visible")){
	  if(e.keyCode === 38){
		$j(".combo__list li").removeClass("focused");
		$j(this).addClass("focused").prev().children("a").focus();
	  }
	}  
	
  });
  
  /*-------*/
  $j(document).on("keyup",function(e) {
	
	if (e.which == 27) {
	  if($j(".combo__list").is(":visible")){  
		$j(".modal-wrapper .combo__list").fadeOut(300);
	  }
	  else if($j(".modal").is(":visible")) {
		$j(".modal").fadeOut(300);
		$j(".combo__list li").removeClass("focused");
	  } else {
		return;
	  }    
	}  
  });
  
