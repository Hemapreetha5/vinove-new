      .find("a[href*='" + $j(this).attr("id") + "']")
      .each(function () {
        let attachFunction = $j(this)
          .attr("href")
          .substring(
            $j(this).attr("href").lastIndexOf("/") + 1,
            $j(this).attr("href").length
          );
        $j(this).attr("href", "javascript:void(0)");
        $j(this).attr("onclick", "linkedSnapdown('" + attachFunction + "')");
      });
  });

