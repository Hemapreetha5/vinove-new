  if ($j(".inpage__link").length > 1) {
    let modulesList = [],
      finalList = [];
    $j(".content-wrapper > *").each((i, e) => {
      modulesList.push($j(e).attr("id"));
    });

    modulesList.forEach((value, index) => {
      $j(".inpage__links > li:not(.inpage__title)").each((i, e) => {
        if (value == $j(e).data("modules")) {
          finalList.push($j(e));
        }
      });
    });

    $j(".inpage__links > li:not(.inpage__title)").remove();
    $j(".inpage__links").append(finalList);
    $j(".inpage__link.inpage__link--active").removeClass(
      "inpage__link--active"
    );
    $j(".inpage__links .inpage__link").eq(0).addClass("inpage__link--active");

    $j(document).on("click", ".inpage__link", (e, v) => {
