/* --- Receive PostMessage from Iframe Starts --- */
var eventMethod = window.addEventListener ? "addEventListener" : "attachEvent";
var eventer = window[eventMethod];
var messageEvent = eventMethod == "attachEvent" ? "onmessage" : "message";

eventer(messageEvent, function (e) {
    console.log("Log 1 " + e.data);
  setTimeout(function() {
   /* if (e.data.includes("iframe_form_submitted") || e.data.includes("form_submitted")) {
            jQuery('html, body').animate({
                scrollTop: 800 // Scroll 800 pixels from the top
            }); // You can adjust the duration as needed
        }
    }, 2000); // Delay of 2000 milliseconds (2 seconds) */
     if (typeof e.data === 'string' && (e.data.includes("form_submitted"))) {
            jQuery('html, body').animate({
                scrollTop: 800 // Scroll 800 pixels from the top
            }); // You can adjust the duration as needed
        }
    }, 2000); // Delay of 2000 milliseconds (2 seconds)

  if (typeof e.data === 'string' && e.data.indexOf("top-") > -1) {
      var srcurl = e.data.split("top-")[1];
      setTimeout(function () {
          scrollVal = $j('iframe[src="' + srcurl + '"]').offset().top;
          $j('html, body').animate({
              scrollTop: scrollVal
          }, 300);
      }, 300);
  }
  if (e.data === "scroll-up") {
      setTimeout(function () {
          scrollVal = $j('iframe').offset().top;
          $j('html, body').animate({
              scrollTop: scrollVal
          }, 300, "easeOutCirc");
      }, 300);
  }
  if (typeof e.data === 'object' && e.data.key === "scroll-down") {
      // Ensure that e.data.value is a number (e.g., by parsing it)
      var value = parseFloat(e.data.value);
      if (!isNaN(value)) {
          setTimeout(function () {
              scrollVal = $j('iframe').offset().top + value;
              $j('html, body').animate({
                  scrollTop: scrollVal
              }, 300, "easeOutCirc");
          }, 300);
      }
  }
}, false);



/* ---  Receive PostMessage from Iframe Ends --- */



/* --- Tooltip for News Item Starts --- */
$j(document).on("click", ".share-news-item", function () {
  var currentPosition = $j(this).position().left + $j(this).width() + 16;
  var closestShare = $j(this)
    .parents(".date-share-wrapper")
    .find(".news-item-share-wrapper");
  if (closestShare.hasClass("d-flex activeShare")) {
    closestShare.removeClass("d-flex activeShare");
  } else {
    $j(".news-item-share-wrapper")
      .removeClass("d-flex activeShare")
      .attr("style", "");
    //closestShare.addClass("d-flex activeShare").css("left",currentPosition + "px");
    closestShare.addClass("d-flex activeShare");
    manageActiveTooltip();
  }
});

function manageActiveTooltip() {
  if ($j(".activeShare").length > 0) {
    var activePosition =
      $j(".activeShare").offset().left + $j(".activeShare").width() + 50;
    var sharePosition =
      $j(".activeShare").parent().find(".share-news-item").offset().left - 110;
    var shareParentPosition =
      $j(".activeShare").parent().find(".share-news-item").position().left +
      $j(".activeShare").parent().find(".share-news-item").width() +
      16;
    if (
      $j(window).width() < 410 &&
      !$j(".activeShare").hasClass("makeTTDown")
    ) {
      $j(".activeShare").addClass("makeTTDown").css("left", "26px");
    } else if ($j(window).width() > 410) {
      $j(".activeShare")
        .removeClass("makeTTDown")
        .css("left", shareParentPosition);
    } else {
      return;
    }
  }
}
/* ---  Tooltip for News Item Ends  --- */

/*--- Manage Glossary Words Starts--- */
function manageGlossary() {
  var glossaryLetter = [];
  var glossaryWord = [];
  $j(".rad-filter").each(function () {
    if (glossaryLetter.indexOf($j(this).text().substring(0, 1)) < 0) {
      glossaryLetter.push($j(this).text().substring(0, 1));
      if (
        $j(
          ".word-content-wrapper[data-id='" +
            $j(this).text().toLowerCase() +
            "']"
        ).find("a[href^='#']").length > 0
      ) {
        $j(
          ".word-content-wrapper[data-id='" +
            $j(this).text().toLowerCase() +
            "']"
        )
          .find("a[href^='#']")
          .each(function () {
            var linkedWord = $j(this)
              .attr("href")
              .replace(/-/g, " ")
              .replace("#", "");
            var linkedLetter = linkedWord.substring(0, 1).toUpperCase();
            if (glossaryWord.indexOf(linkedWord) < 0) {
              glossaryWord.push(linkedWord);
            }
            if (glossaryLetter.indexOf(linkedLetter) < 0) {
              glossaryLetter.push(linkedLetter);
            }
          });
      }
    }
    if (glossaryWord.indexOf($j(this).text()) < 0) {
      glossaryWord.push($j(this).text().trim().toLowerCase());
    }
  });

  if (glossaryLetter < 1) {
    $j(".glossaryPanelTopContentNoWord").removeClass("hide");
    $j(".glossaryPanelTopContent").addClass("hide");
  }
  if (glossaryLetter.length > 0) {
    for (var letter in glossaryLetter) {
      $j(".panel-section#" + glossaryLetter[letter].toUpperCase()).addClass(
        "hasContent"
      );
      $j(
        ".glossary-index li a[href='#" +
          glossaryLetter[letter].toUpperCase() +
          "']"
      )
        .parent()
        .addClass("anchorHasContent");
    }
  }

  if (glossaryWord.length > 0) {
    for (var word in glossaryWord) {
      $j(
        ".word-content-wrapper[data-id='" + glossaryWord[word] + "']"
      ).addClass("existInPage");
    }
  }

  $j(".panel-section:not(.hasContent)").remove();
  $j(".glossary-index li:not(.anchorHasContent,.btnCloseGlossary)").remove();
  $j(".word-content-wrapper:not(.existInPage)").remove();
}
/*--- Manage Glossary Words Starts--- */

function handleInputFocusTransfer(e) {
  const focusableInputElements = document.querySelectorAll("li.level2 a");
  const focusable = [...focusableInputElements];
  const index = focusable.indexOf(document.activeElement);
  let nextIndex = 0;
  if (e.keyCode === 38) {
    e.preventDefault();
    nextIndex = index > 0 ? index - 1 : 0;
    focusableInputElements[nextIndex].focus();
  } else if (e.keyCode === 40) {
    e.preventDefault();
    nextIndex = index + 1 < focusable.length ? index + 1 : index;
    focusableInputElements[nextIndex].focus();
  }
}

