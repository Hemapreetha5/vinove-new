function filterNewsBasedOnTopics(selectedTopic) {
  $j(".news-filter-row .dropdown-wrapper.topics ul li").removeClass(
    "active-li"
  );
  $j(
    ".news-filter-row .dropdown-wrapper.topics ul li[data-topic='" +
      selectedTopic +
      "']"
  ).addClass("active-li");
  $j(".news-filter-row .dropdown-wrapper.topics .ddlSelectedValue").text(
    $j(
      ".news-filter-row .dropdown-wrapper.topics ul li[data-topic='" +
        selectedTopic +
        "']"
    ).text()
  );
  filterNewsItem();
  $j(".news-filter-row .lnk-reset").removeClass("filter_executed");
}

