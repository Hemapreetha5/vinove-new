  // national-provident-life-limited
  document.addEventListener('DOMContentLoaded', function () {
    // Select all radio buttons
    const radioButtons = document.querySelectorAll('input[name="group-52"]');
    // Check if a radio button ID is stored in sessionStorage
    const storedRadioButtonId = sessionStorage.getItem('selectedRadioButtonId');
    // If a radio button ID is stored, set the 'selected' class for that radio button
    if (storedRadioButtonId) {
      const storedRadioButton = document.getElementById(storedRadioButtonId);
      if (storedRadioButton) {
        storedRadioButton.parentElement.classList.add('selected');
        applyBodyClass(storedRadioButtonId);
      }
    }
    // Add event listener to each radio button
    radioButtons.forEach(function (radioButton) {
      radioButton.addEventListener('change', function () {
        // Remove the 'selected' class from all radio buttons' parent elements
        radioButtons.forEach(function (radioButton) {
          radioButton.parentElement.classList.remove('selected');
        });
        // Add the 'selected' class to the clicked radio button's parent element
        this.parentElement.classList.add('selected');
        // Store the ID of the clicked radio button in sessionStorage
        sessionStorage.setItem('selectedRadioButtonId', this.id);
        // Apply class to body tag based on the selected radio button
        applyBodyClass(this.id);
      });
    });
  });
  
  
  // Function to apply class to body tag based on the selected radio button
  function applyBodyClass(selectedId) {
    // Remove existing classes from body tag
    document.body.classList.remove('npi-limited-2012', 'npi-limited-2015');
    if (selectedId === 'an-npi-or-national-provident-life-policy-that-was-transferred-to-phoenix-life-limited-in-march-2012-npi-and-national-provident-life') {
      document.body.classList.add('npi-limited-2012');
    } else if (selectedId === 'a-national-provident-life-limited-policy-that-was-transferred-to-phoenix-life-assurance-limited-in-june-2015-npi-and-national-provident-life') {
      document.body.classList.add('npi-limited-2015');
    }
  }
  
  function getCookie(name) {
    let cookieArr = document.cookie.split(";");
    for (let i = 0; i < cookieArr.length; i++) {
      let cookiePair = cookieArr[i].split("=");
  
      // Remove whitespace at the beginning of the cookie name and compare it with the given string
      if (name == cookiePair[0].trim()) {
        return decodeURIComponent(cookiePair[1]);
      }
    }
    // Return null if not found
    return null;
  }
  // Function to check the cookie value and add class to body tag
  function addClassBasedOnCookie() {
    let cookieValue = getCookie("selectedInsurance");
    if (cookieValue) {
      // Parse the cookie value assuming it's a JSON string
      try {
        let parsedValue = JSON.parse(cookieValue);
        if (parsedValue.name === "NPI and National Provident Life") {
          document.body.classList.add("national-provident-life");
        }
      } catch (e) {
        //  console.error("Error parsing cookie value", e);
      }
    }
  }
  // Call the function on page load
  window.onload = addClassBasedOnCookie;
  // end npi / n
  
  // this is only for manage-my-policy-peterboroughn and manage-my-policy-peterboroughnpll
    document.addEventListener("DOMContentLoaded", function() {
        const contentNpll = document.querySelector(".content-npll");
        const contentN = document.querySelector(".content-n");
    
        if (contentNpll) {
            contentNpll.addEventListener("click", function(event) {
                event.preventDefault();
                setTimeout(function() {
                    document.body.classList.remove("npi-limited-2012");
                    document.body.classList.add("npi-limited-2015");
                }, 2000);
            });
        }
    
        if (contentN) {
            contentN.addEventListener("click", function(event) {
                event.preventDefault();
                setTimeout(function() {
                    document.body.classList.remove("npi-limited-2015");
                    document.body.classList.add("npi-limited-2012");
                }, 2000);
            });
        }
    });
