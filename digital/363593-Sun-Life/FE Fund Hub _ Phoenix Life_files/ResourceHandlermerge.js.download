var answerArray = [
  {
    name: "ans1",
    ans: [
      [1, 2, 1],
      [1, 1, 1],
      [1, 1, 2],
    ],
  },
  { name: "ans2", ans: [[1, 2, 2]] },
  {
    name: "ans3",
    ans: [
      [2, 2, 1],
      [2, 1, 1],
    ],
  },
  {
    name: "ans4",
    ans: [
      [2, 2, 2],
      [2, 1, 2],
    ],
  },
];

if (document.getElementById("btnOmbudsman") !== null) {
  document.getElementById("btnOmbudsman").onclick = (e) => {
    let selectedValues = [];
    document
      .querySelectorAll(".rbtn-selectorWrapper input:checked")
      .forEach((elm) => {
        selectedValues.push(elm.getAttribute("data-value"));
      });
    // console.log(selectedValues.toString());
    let filteredArray = answerArray
      .filter((element) =>
        element.ans.some((sub) => sub.toString() == selectedValues.toString())
      )
      .map((final) => final.name)
      .toString();
    //  console.log(filteredArray);
    if (
      !document.querySelector(".ans-data.open#" + filteredArray + "") &&
      document.querySelector(".ans-data.open")
    ) {
      document.querySelector(".ans-data.open").classList.remove("open");
    }
    document.getElementById(filteredArray).classList.add("open");
  };
}
/*--- 	Ombudsman Radio button End	---*/

/*---  Top header Font Size Link starts 	--- */
Array.from(document.getElementsByClassName("font-size-link")).forEach((elm) => {
  elm.onclick = (e) => {
    let clickedFont = e.target.getAttribute("class").split(" ")[1];
    let bodyElm = document.getElementsByTagName("html")[0];
    if (bodyElm.classList.toString().indexOf("selected-") > -1) {
      let regex = new RegExp("\\bselected-[^ ]*[ ]?\\b", "g");
      bodyElm.className = bodyElm.className.replace(regex, "");
    }
    bodyElm.classList.add(`selected-${clickedFont}`);
  };
});
/*--- 	Top header Font Size Link End 	---*/

