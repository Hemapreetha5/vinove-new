        $j(".loader-overlay").show();
      },
      complete: function () {
        $j(".loader-overlay").hide();
      },
      success: function (data) {
        $j(".content-wrapper").empty();
        history.pushState(null, null, newUrl);
        document.title = $j(data).filter("title").text();
        $j("article > .row.m-0").html($j(data).find(".row.m-0").html());
        $j(".panel-wrapper").html($j(data).find(".panel-wrapper").html());
        manageGlossary();
        $j(".loader-overlay").hide();
        changeYearSlide();
        inPageLinks();
        manageBtns();
        
        lastChildFocus();
        clickedOnExtraTab();
        resizeIframe();
