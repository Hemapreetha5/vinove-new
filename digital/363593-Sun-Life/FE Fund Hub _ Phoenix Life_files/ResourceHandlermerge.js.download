$j(
  ".navigation > ul > li.level1 > a,.navigation > ul > li.level1 > button.activePage"
).on("focus", function (e) {
  $j(".navigation ul.ulLevel1").removeClass("visibleUl");
  $j(
    ".navigation ul:not(.nav_icons_wrapper) li.level1 > a,.navigation ul:not(.nav_icons_wrapper) li.level1 > button.activePage"
  )
    .removeClass("active-menu-element")
    //.attr("aria-expanded", false);
  $j(this).addClass("active-menu-element");
  //$j(document).unbind("keydown");
  // Space / Enter checks
  $j(this).on("keydown", function (f) {
    //f.preventDefault();
    //f.stopImmediatePropagation();
    //console.log("Inside keydown");
    // Left Key
    if (f.keyCode === 37) {
      menuAccessFlag = 0;
      if ($j(f.target).parent().prev().length) {
        $j(
          ".navigation ul:not(.nav_icons_wrapper) li.level1 > a,.navigation ul:not(.nav_icons_wrapper) li.level1 > button.activePage"
        )
          .removeClass("active-menu-element")
          //.attr("aria-expanded", false);
        menuAccessFlag = 1;
        $j(f.target)
          .parent()
          .prev()
          .children()
          .first()
          //.attr("aria-expanded", "true")
          .trigger("focus")
          .trigger("click");
      }
    }

    // Down Key
    if (f.keyCode === 40) {
      f.preventDefault();
      // Triggering focus on First Element
      if ($j(f.target).hasClass("active-menu-element")) {
        $j(f.target)
          .siblings("ul")
          .find("li.level2")
          .first()
          .children("a")
          .trigger("focus")
          .trigger("click");

        document.addEventListener("keydown", handleInputFocusTransfer);
      }
    }

    // Right Key
    if (f.keyCode === 39) {
      menuAccessFlag = 0;
      $j(
        ".navigation ul:not(.nav_icons_wrapper) li.level1 > a,.navigation ul:not(.nav_icons_wrapper) li.level1 > button.activePage"
      )
        .removeClass("active-menu-element")
      // .attr("aria-expanded", false);
      if ($j(f.target).parent().next().hasClass("level1")) {
        menuAccessFlag = 1;
        $j(f.target)
          .parent()
          .next()
          .children()
          .first()
         // .attr("aria-expanded", "true")
          .trigger("focus")
          .trigger("click");
      }
    }

    // Tab and Enter Key
    if (f.keyCode === 13 || f.keyCode === 32) {
      f.stopImmediatePropagation();
      if ($j(f.target).hasClass("active-menu-element")) {
        f.preventDefault();
        menuAccessFlag = 1;
        //console.log(menuAccessFlag);
        //e.preventDefault();
        $j(f.target).trigger("click");
        //currentTarget.attr("aria-expanded",true).closest(".ulLevel1");
      }
    }

    

  });
});

$j(document).on(
  "click",
  ".navigation > ul > li.level1 > a,.navigation > ul > li.level1 > button.activePage",
  function (e) {
    if (menuAccessFlag == 1) {
      e.preventDefault();
      //console.log("Inside click");
      //console.log("clicked");
      var currentTarget = $j(e.target);
      if (
        currentTarget.attr("aria-expanded") == "true" &&
        currentTarget.parent().find(".ulLevel1").hasClass("visibleUl")
      ) {
        if (e.target.tagName === "A") {
          location.href = currentTarget.attr("href");
        } else {
          return;
        }
      } else {
        // $j(
        //    ".navigation ul:not(.nav_icons_wrapper) li.level1 > a,.navigation ul:not(.nav_icons_wrapper) li.level1 > button.activePage"
        //  ).attr("aria-expanded", false);
        $j(e.target)
          // .attr("aria-expanded", true)
          .parent()
          .find(".ulLevel1")
          .addClass("visibleUl");
      }
    }
  }
);
$j(document).on(
  "hover",
  ".navigation ul:not(.nav_icons_wrapper) li.level1 > a,.navigation ul:not(.nav_icons_wrapper) li.level1 > button.activePage",
  function (e) {
    if (menuAccessFlag == 1 && menuAccessFlag != 0) {
      menuAccessFlag = 0;
    }
    if ($j(".visibleUl").length > 0) {
      $j(".visibleUl").removeClass("visibleUl");
    }
    if ($j(".active-menu-element").length > 0) {
      $j(".active-menu-element").removeClass("active-menu-element");
    }
  }
);

