/*!---- main-2-----*/
function findLink() {
    let cookieValue = getCookie("selectedInsurance");
    //console.log(cookieValue, "cookies value")
    if (cookieValue) {
        try {
            let parsedValue = JSON.parse(cookieValue);
            if (parsedValue.company === "peterborough" || parsedValue.company === "liverpool") {
                var request = document.querySelector("#contact-us-nav-nav-death-claim-notification-level3");
                request.classList.add("death-claim-notification");
                let linkElement = document.querySelector('.death-claim-notification > a');
                if (linkElement) {
                    linkElement.href = 'https://www.myphoenix.co.uk/bereavement/relation-notification';
                    linkElement.setAttribute('target', '_blank');
                    linkElement.setAttribute('aria-label', 'Link to My Phoenix website');
                    linkElement.setAttribute('title', 'Link to My Phoenix website');
                } else {
                    // console.error('Element with class "request-retirement-pack" not found.');
                }
            }
        } catch (e) {
            //console.error('Error parsing cookie value:', e);
        }
    }
}
findLink();