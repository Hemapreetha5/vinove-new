if (window.location.search.indexOf("request=") > -1) {
  window.history.replaceState("", "", window.location.pathname);
}
if (document.getElementsByClassName("dc-no-wrapper").length) {
  dcYesWrapper = getClass("dc-yes-wrapper");
  dcNoWrapper = getClass("dc-no-wrapper");
  prevBtn = getClass("btnBackToPrev");
  dcMainWrapper = getClass("death-claim-wrapper");
  dcWrapper = getClass("dc-main-wrapper");
}
function deathClaim(
  dcYesWrapper,
  dcNoWrapper,
  prevBtn,
  dcMainWrapper,
  dcWrapper
) {
  if (document.getElementsByClassName("dc-no-wrapper").length) {
    /* --- Cloning and managing ID's of Policy List Starts --- */
    let clonedNode = Array.from(
      document.getElementsByClassName("combo__list")[0].cloneNode(true).children
    );
    // Remove abbey life from list since it is not required on Online Cash In App
//     if (document.getElementsByClassName("dc-online").length > 0) {
//       clonedNode = clonedNode
//         .filter(
//           (elm) =>
//             elm
//               .querySelector("span.combo__list-text")
//               .textContent.toLowerCase() != "abbey life"
//         )
//         .map((elm) => elm);
//     }
    clonedNode.forEach((elm) => {
      elm.setAttribute("id", `dc-${elm.getAttribute("id")}`);
      if (elm.querySelectorAll("input,label").length) {
        let currentID;
        elm.querySelectorAll("input,label").forEach((inp) => {
          if (inp.tagName === "INPUT") {
            currentID = inp.getAttribute("id");
            inp.setAttribute("id", `dc-${currentID}`);
          } else {
            inp.setAttribute("for", `dc-${currentID}`);
          }
        });
      }
    });
    let ulElm = document.createElement("ul");
    ulElm.classList.add("combo__list");
    document.querySelector(".dc-no-wrapper .input-field").appendChild(ulElm);
    Element.prototype.append.apply(
      document.querySelector(".dc-no-wrapper .combo__list"),
      clonedNode
    );
    //document.querySelector(".dc-no-wrapper .input-field").appendChild(...clonedNode);
    if (
      document.getElementsByClassName("dc-online").length > 0 &&
      document.cookie.indexOf("selectedInsurance") > -1
    ) {
      let readPolicyName = JSON.parse(
        document.cookie.split("selectedInsurance=")[1].split(";")[0]
      ).name;
      let checkClonedElements = setInterval(() => {
        if (
          document.querySelector(".dc-online .combo__list").children.length >
            0 &&
          document.querySelector(
            `.dc-online li[data-policyname='${readPolicyName}']`
          )
        ) {
          //console.log("DC Online true");
          document
            .querySelector(`.dc-online li[data-policyname='${readPolicyName}']`)
            .click();
          clearInterval(checkClonedElements);
        } else {
          clearInterval(checkClonedElements);
        }
      }, 2500);
    }
    /* --- Cloning and managing ID's of Policy List Ends --- */

    /* --- Managing Redirection of Policy Based on Selection Starts --- */
    /* --- Custom Functions Starts --- */

    const cSlideUp = (selector, duration) => {
      Object.assign(selector.style, {
        height: selector.clientHeight + "px",
        transition: `all ${duration}s ease`,
        overflow: "hidden",
        margin: "0",
        padding: "0",
      });
      setTimeout(() => {
        selector.style.height = 0;
        selector.addEventListener(
          "transitionend",
          () => {
            let topPos =
              window.pageYOffset +
              dcMainWrapper.querySelector(".container").getBoundingClientRect()
                .y;
            window.scrollTo({ top: topPos, behavior: "smooth" });
            selector.style = "";
            selector.classList.remove("showBlock");
            selector.classList.add("hide");
          },
          { once: true }
        );
      }, 1);
    };
    const cSlideDown = (selector, duration) => {
      selector.classList.add("showBlock");
      Object.assign(selector.style, {
        transition: `all ${duration}s ease`,
        overflow: "hidden",
      });
      let height = selector.clientHeight + "px";
      selector.style.height = 0;
      setTimeout(() => {
        selector.style.height = height;
        selector.addEventListener(
          "transitionend",
          () => {
            let topPos =
              window.pageYOffset +
              dcMainWrapper.querySelector(".container").getBoundingClientRect()
                .y;
            window.scrollTo({ top: topPos, behavior: "smooth" });
            selector.style = "";
            selector.classList.remove("hide");
          },
          { once: true }
        );
      }, 1);
    };

    const managePopup = (selector, reverseWords) => {
      selector = selector === undefined ? "modalExternalLink" : selector;
      if (reverseWords) {
        Array.from(
          getClass(selector).getElementsByClassName("rad-case")
        ).forEach((e, i) => {
          if (i == 0) {
            e.textContent = "Peterborough";
          } else {
            e.textContent = "Glasgow";
          }
        });
      }
      Object.assign(getClass(selector).style, {
        transition: "all 0.3s ease",
        display: "block",
        opacity: "0",
      });
      setTimeout(() => {
        getClass(selector).classList.add("active-modal");
        getClass(selector).style.opacity = "1";
      }, 1);
    };
    const checkDataCentre = (selector) => {
      let activeDcElm = getClass("activeDc");
      let selectedCentre = selector.getAttribute("data-centre");
      let selectedUrl =
        selector.getAttribute("data-url") === null
          ? selector.getElementsByTagName("a")[0].getAttribute("data-url")
          : selector.getAttribute("data-url");
      let selectedOther = selector.getAttribute("data-other-company");
      switch (selectedCentre) {
        case "peterborough":
        case "liverpool":
          managePopup();
          break;

        case "glasgow":
          if (getClass("dc-online")) {
            if (activeDcElm) {
              activeDcElm.classList.remove("activeDc");
            }
            getClass("dc-glasgow-wrapper").classList.add(
              "activeDc",
              "fromPolicyList"
            );
            cSlideUp(dcNoWrapper, 0.4);
            cSlideDown(getClass("dc-glasgow-wrapper"), 0.4);
          } else {
                      //console.log('>>> raa',selectedUrl);
            
                         if(bool === true){
                         //console.log('>>> raa true')
				window.location =  "/customer-centre/manage-my-policy/manage-my-policy-GlasgowA/contact/death-claim-notification-form"
			}
            else{
            //console.log('>>> raa false')
            window.location = `${selectedUrl}/contact/contact-form?request=notify-us-of-the-death-of-a-policyholder`;
            }
          }
          break;

        default:
          window.location =
            selectedOther !== null || selectedOther !== ""
              ? `${selectedUrl}/contact`
              : selectedOther;
      }
    };
    /* --- Custom Functions Ends --- */

    /* --- Clone external popup Starts --- */
    if (getClass("dc-online")) {
      let cloneExternalPopup = getClass("modalExternalLink").cloneNode(true);
      cloneExternalPopup.classList.add("warningPopup");
      cloneExternalPopup.querySelector(".modal__text").innerHTML =
        getClass("dc-online").getAttribute("expop-online");
      cloneExternalPopup
        .querySelector(".modal--center a")
        .removeAttribute("target");
      cloneExternalPopup.querySelector(".modal--center a").textContent = "Yes";
      cloneExternalPopup
        .querySelector(".modal--center a")
        .setAttribute("href", "javascript:;");
      cloneExternalPopup
        .querySelector(".modal--center a")
        .classList.add("exDcYes");
      cloneExternalPopup.querySelector(
        ".modal--center button.close"
      ).textContent = "No";
      getClass("dc-online").append(cloneExternalPopup);
    }

    /* --- Clone external popup Ends --- */
    // let clonePrevTxt = getClass("dc-prevPolicy").querySelector("a").cloneNode(true);
    // clonePrevTxt.children[0].textContent = "click here";
    // dcNoWrapper.getElementsByClassName("model-filer")[0].insertBefore(clonePrevTxt,dcNoWrapper.getElementsByClassName("model-filer")[0].lastElementChild)

    Array.from(getClass("dc-btn-wrapper").getElementsByTagName("a")).forEach(
      (elm) => {
        if (
          elm.getAttribute("data-query") !== null &&
          elm.getAttribute("data-query") !== ""
        ) {
          let href = elm.getAttribute("href");
          let query = elm.getAttribute("data-query");
          elm.setAttribute("href", `${href}?${query}`);
        }
      }
    );
    getClass("btnDc").onclick = (e) => {
      if (
        e.target.parentElement.querySelector(
          ".policy-holder-type-wrapper.show input:checked"
        )
      ) {
        checkDataCentre(
          e.target.parentElement.querySelector(
            ".policy-holder-type-wrapper.show input:checked"
          ).parentElement
        );
        return;
      }
      checkDataCentre(
        e.target.closest(".model-filer").querySelector(".selected-insurance")
      );
      
     
    let slctdIns = document.querySelector('li.selected-insurance').getAttribute("data-policyname");
    let chckIns = "Abbey Life";
    let chckIns1 = "Century Life plc";
    let chckIns2 = "Century Life" 
    let selectedIns = ["Century Life plc", "Century Life", "Black Sea and Baltic General Insurance Company", "Century Group", "City of Edinburgh Life Assurance Company", "Colonial Life Insurance Company (UK)", "Consumers Life Insurance Company", "Credit & Commerce Life Assurance", "Crown Assurance Company", "Equico International", "Growth & Secured Life Assurance Society", "Hiscox Insurance Company", "Lamont Life Assurance Company", "Langham Life Assurance Company", "Mutual Life Assurance","National Australia Life Company", "National Employers Life Assurance Company", "NEL Britannia Assurance Company", "Old Mutual Life Assurance Company", "Oxford Life Assurance Company", "Prosperity Financial Services", "Prosperity Life Assurance", "Providence Capitol Life Assurance Company", "Sentinel Life", "Shield Assurance", "UK Life Assurance Company","Unit Assurance Company"]
    
    let deathFormForGlasgowA = ["Britannia Life","Britannia Life Limited","Crescent Life","Crusader Insurance","Crusader Insurance plc","Foreman & Staff Mutual Benefit Society","FS Assurance","LAS Investment Assurance","LAS Pensions Management","Life Association of Scotland"]
    let deathFormForGlasgowB = ["Allianz Cornhill","Allianz Cornhill Insurance plc","Britannic","Britannic Assurance","Britannic Assurance plc","Britannic Retirement Solutions","Britannic Unit Linked Assurance","British Legal Life Assurance Company"]
    let deathFormForGlasgowBR = ["Evergreen Retirement Assurance"]
    let deathFormForGlasgowSM = ["Scottish Mutual","Scottish Mutual Assurance Limited","Scottish Mutual Assurance plc","Scottish Mutual Assurance Society","Scottish Temperance","Scottish Temperance Life Assurance Society"]
	let deathFormForGlasgowSP = ["PFM Assurance","Prolific Life & Pensions","Provincial Life Assurance","Provincial Life Assurance Company Limited","Provincial Pensions","Scottish Provident","Scottish Provident Assurance Limited","Scottish Provident Institution","Scottish Provident Limited","Scottish Provident Managed Pension Funds Limited"]    
let lifetimeMortgages = ["Papilio", "Legal & General", "Northern Rock", "Papilio ERM Limited"]
 if(chckIns == slctdIns){
   
    if (window.location.href.indexOf("death-claim-notification") > -1) {
    let curentUri = "contact";
    let rediUri = "/customer-centre/manage-my-policy/manage-my-policy-bournemouth/contact/death-claim-notification-form";
    
    window.location.pathname = rediUri;
    
    }
    }
    if(selectedIns.includes(slctdIns)){
        if (window.location.href.indexOf("death-claim-notification") > -1) {
            let rediUri = "/customer-centre/manage-my-policy/manage-my-policy-romford/contact/death-claim-notification-form";
            window.location.pathname = rediUri;
            }
    }
    if(deathFormForGlasgowA.includes(slctdIns)){
   
		if (window.location.href.indexOf("death-claim-notification") > -1) {
       // if(deathFormForGlasgowA === "Alba Life" || "Alba Life Limited"){
       // bool = false;
       // }
       // else{
    		let rediUri = "/customer-centre/manage-my-policy/manage-my-policy-GlasgowA/contact/death-claim-notification-form";
            window.location.pathname = rediUri;
    	//}
        
        }
    }
    if(deathFormForGlasgowB.includes(slctdIns)){
    	if (window.location.href.indexOf("death-claim-notification") > -1) {
    		let rediUri = "/customer-centre/manage-my-policy/manage-my-policy-GlasgowB/contact/death-claim-notification-form";
            window.location.pathname = rediUri;
    	}
    }
    if(deathFormForGlasgowBR.includes(slctdIns)){
    	if (window.location.href.indexOf("death-claim-notification") > -1) {
    		let rediUri = "/customer-centre/manage-my-policy/manage-my-policy-GlasgowBR/contact/death-claim-notification-form";
            window.location.pathname = rediUri;
    	}
    }
    if(deathFormForGlasgowSM.includes(slctdIns)){
    	if (window.location.href.indexOf("death-claim-notification") > -1) {
    		let rediUri = "/customer-centre/manage-my-policy/manage-my-policy-GlasgowSM/contact/death-claim-notification-form";
            window.location.pathname = rediUri;
    	}
    }
    if(deathFormForGlasgowSP.includes(slctdIns)){
    	if (window.location.href.indexOf("death-claim-notification") > -1) {
    		let rediUri = "/customer-centre/manage-my-policy/manage-my-policy-GlasgowSP/contact/death-claim-notification-form";
            window.location.pathname = rediUri;
    	}
    }
    if(lifetimeMortgages.includes(slctdIns)){
        if (window.location.href.indexOf("death-claim-notification") > -1) {
            let rediUri = "/customer-centre/manage-my-policy/manage-my-policy-phoenix-group-lifetime-mortgages";
            window.location.pathname = rediUri;
        }
    } 
    };
    $j(".death-claim-wrapper .dc-no-wrapper button.btnPolicyCheck").click(
      function () {
        $j(this).parent().parent().removeClass("d-block");
      }
    );
    /* --- Online Application for links Starts --- */
    if (
      document.querySelector("a[data-online='glasgow']") &&
      getClass("dc-online")
    ) {
      document
        .querySelector("a[data-online='glasgow']")
        .setAttribute("href", "javascript:;");
    }
    /* --- Online Application for links Ends --- */

    let clickElement;
    document.onclick = (e) => {
      //e.stopImmediatePropagation();
      let topPos =
        window.pageYOffset +
        dcMainWrapper.querySelector(".container").getBoundingClientRect().y;
      let activeDcElm = getClass("activeDc");
      if (e.target.classList.contains("dc-no")) {
        if (activeDcElm) {
          activeDcElm.classList.remove("activeDc");
        }
        cSlideUp(dcWrapper, 0.4);
        cSlideDown(dcNoWrapper, 0.4);
        dcNoWrapper.classList.add("activeDc");
        prevBtn.classList.add("showBlock");
      } else if (e.target.classList.contains("dc-yes")) {
        if (activeDcElm) {
          activeDcElm.classList.remove("activeDc");
        }
        cSlideUp(dcWrapper, 0.4);
        cSlideDown(dcYesWrapper, 0.4);
        dcYesWrapper.classList.add("activeDc");
        prevBtn.classList.add("showBlock");
      } else if (e.target.classList.contains("btnBackToPrev")) {
        if (document.querySelector(".dc-glasgow-wrapper.activeDc")) {
          cSlideUp(getClass("dc-glasgow-wrapper"), 0.4);
          if (getClass("fromPolicyList")) {
            cSlideDown(dcNoWrapper, 0.4);
            getClass("dc-glasgow-wrapper").classList.remove(
              "activeDc",
              "fromPolicyList"
            );
            dcNoWrapper.classList.add("activeDc");
          } else {
            cSlideDown(dcYesWrapper, 0.4);
            getClass("dc-glasgow-wrapper").classList.remove("activeDc");
            dcYesWrapper.classList.add("activeDc");
          }
        } else if (getClass("activeDc")) {
          cSlideUp(activeDcElm, 0.4);
          cSlideDown(dcWrapper, 0.4);
          e.target.classList.remove("showBlock");
          setTimeout(() => {
            activeDcElm.classList.remove("activeDc");
            window.scrollTo({ top: topPos, behavior: "smooth" });
          }, 400);
        } else {
          cSlideUp(getClass("toggleWBtn"), 0.4);
          cSlideDown(getClass("online-app-main-wrapper"), 0.4);
        }
      } else if (e.target.classList.contains("btnDcToggle")) {
      /* --- Online Application Starts --- */
        cSlideUp(e.target.parentElement, 0.4);
        cSlideDown(getClass("toggleWBtn"), 0.4);
      } else if (e.target.classList.contains("btnDcYes")) {
        clickElement = e.target;
        if (
          e.target.getAttribute("data-linktype") == "external" &&
          document.cookie.indexOf("selectedInsurance") < 0
        ) {
          e.preventDefault();
          managePopup();
        }
        if (!getClass("dc-online")) return;
        let readCompanyName;
        if (document.cookie.indexOf("selectedInsurance") > -1) {
          readCompanyName = JSON.parse(
            document.cookie.split("selectedInsurance=")[1].split(";")[0]
          ).company;
        }

        // Check Glasgow and show respective content
        if (
          e.target.getAttribute("data-online") == "glasgow" &&
          getClass("dc-glasgow-wrapper")
        ) {
          if (readCompanyName == "peterborough") {
            managePopup("warningPopup", true);
            return;
          }
          if (activeDcElm) {
            activeDcElm.classList.remove("activeDc");
          }
          getClass("dc-glasgow-wrapper").classList.add("activeDc");
          cSlideUp(getClass("dc-yes-wrapper"), 0.4);
          cSlideDown(getClass("dc-glasgow-wrapper"), 0.4);
        }
        if (
          e.target.getAttribute("data-online") == "peterborough" &&
          getClass("dc-glasgow-wrapper")
        ) {
          e.preventDefault();
          if (readCompanyName == "glasgow") {
            managePopup("warningPopup");
            return;
          }
          managePopup();
        }
      } else if (e.target.classList.contains("exDcYes")) {
        if (clickElement.getAttribute("data-online") == "glasgow") {
          if (activeDcElm) {
            activeDcElm.classList.remove("activeDc");
          }
          getClass("dc-glasgow-wrapper").classList.add("activeDc");
          cSlideUp(getClass("dc-yes-wrapper"), 0.4);
          cSlideDown(getClass("dc-glasgow-wrapper"), 0.4);
        } else if (clickElement.getAttribute("data-online") == "peterborough") {
          managePopup();
        }
      }
      /* --- Online Application Ends --- */
    };
    /* --- Managing Redirection of Policy Based on Selection Starts --- */
  }
}
