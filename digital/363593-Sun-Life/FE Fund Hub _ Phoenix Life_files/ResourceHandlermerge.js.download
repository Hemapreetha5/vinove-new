// Function to check radio buttons and configure button class
 
function handlePolicyPopup() {
    //console.log("handlePolicyPopup function called");
    var popup = document.querySelector('.policyModalPopup');
    // Check if popup exists and is visible
    if (popup && getComputedStyle(popup).display === 'block') {
      //console.log("Popup found and visible");
      var btnSaveInsurance = popup.querySelector('.btnsaveInsurance');
      // Check if .policy-holder-type-wrapper is already present
      setTimeout(checkPolicyHolderWrapper, 1000);
      var observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.type === 'childList') {
            // Check if .policy-holder-type-wrapper is added to the DOM
            if (mutation.addedNodes.length > 0) {
              mutation.addedNodes.forEach(function(node) {
                if (node.classList && node.classList.contains('policy-holder-type-wrapper')) {
                 // console.log(".policy-holder-type-wrapper added to the DOM");
                  checkPolicyHolderWrapper();
                }
              });
            }
          }
        });
      });

      observer.observe(popup, {
        childList: true,
        subtree: true
      });
    } else {
      //console.log("Popup not found or not visible");
    }
  }
        
// Function to check if .policy-holder-type-wrapper is present and add disabledTag class if needed

function checkPolicyHolderWrapper() {
 var popup = document.querySelector('.model-filer');
//console.log("inside checkPolicyHolderWrapper");
  var btnSaveInsurance = document.querySelector('.model-filer .btnsaveInsurance');
  var policyHolderWrappers = popup.querySelectorAll('.policy-holder-type-wrapper');
  policyHolderWrappers.forEach(function(policyHolderWrapper) {
  //console.log("found .policy-holder-type-wrapper");
    var closestComboList = policyHolderWrapper.closest('ul.combo__list');
    //console.log(closestComboList);
    if (!closestComboList) {
      //console.log("Policy holder wrapper found and not within ul.combo__list");
      var radioInputs = policyHolderWrapper.querySelectorAll('input[type="radio"]');
      if (radioInputs.length > 0) {
      console.log(radioInputs);
        var isChecked = Array.from(radioInputs).some(function(input) {
          return input.checked;
        });
        if (!isChecked) {
        
          btnSaveInsurance.classList.add('disableTag');
          console.log("disabledTag class added to btnSaveInsurance");
        } else {
          console.log("At least one checkbox is already checked, disableTag not added to btnSaveInsurance");
        }

        // Add event listener to each radio input
        radioInputs.forEach(function(radioInput) {
          radioInput.addEventListener('change', function() {
            // Check if any radio input is checked
            var isChecked = Array.from(radioInputs).some(function(input) {
              return input.checked;
            });
            // If any radio input is checked, remove disableTag class from btnSaveInsurance
            if (isChecked) {
            //console.log("here")
            
              btnSaveInsurance.classList.remove('disableTag');
              console.log("disabledTag class removed from btnSaveInsurance");
            }
          });
        });
      } else {
        //console.log("No radio inputs found");
      }
    } else {
      //console.log(".policy-holder-type-wrapper not found")
      //console.log("current policy holder type wrapper:", policyHolderWrapper);
    }
  });
}


