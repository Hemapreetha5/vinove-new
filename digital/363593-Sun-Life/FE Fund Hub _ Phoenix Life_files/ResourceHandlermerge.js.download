$j(document).on("click", ".btnIframe", function (e) {
  e.preventDefault();
  var clickedId = $j(this).parent().data("id");
  if ($j(this).attr("aria-expanded") == "false") {
    $j(this).attr("aria-expanded", "true");
  } else {
    $j(this).attr("aria-expanded", "false");
  }
  if (
    $j(".external-content-wrapper[data-frameid='" + clickedId + "']").hasClass(
      "activeIframe"
    )
  ) {
    $j(
      ".external-content-wrapper[data-frameid='" + clickedId + "']"
    ).removeClass("activeIframe"); //.slideUp(200)
  } else {
    $j(".external-content-wrapper[data-frameid='" + clickedId + "']")
      .addClass("activeIframe")
      .slideDown(200, function () {
        $j("html,body").animate(
          {
            scrollTop: $j(
              ".external-content-wrapper[data-frameid='" +
                clickedId +
                "'] iframe"
            ).offset().top,
          },
          200
        );
      });
    $j(window).trigger("resize");
  }
});

//Tooltip
$j(document).on("click", ".rad-popup", function (e) {
  e.preventDefault();
  if (!$j(e.target).hasClass("rad-caption")) {
    if ($j(this).hasClass("open-tt")) {
      $j(this).removeClass("open-tt").find(".close-tt").attr("tabindex", "-1");
    } else {
      $j(".rad-popup").removeClass("open-tt");
      $j(this)
        .addClass("open-tt")
        .find(".close-tt")
        .attr("tabindex", "0")
        .focus();
    }
  }
  $j(".rad-caption").attr("style", "");
  manageTooltipPosition($j(this));
});

$j(document).on("keypress", ".close-tt", function (e) {
  if (e.keyCode === 13) {
    $j(e.target).parents(".rad-popup").trigger("click");
  }
});

//history

$j(document).on("click", ".our-history-white-item label", function (e) {
  var currentLabel = $j(this);
  $j(
    ".our-history-inner-container .our-history-timeline[style*='margin-top']"
  ).removeAttr("style");
  if ($j(".our-history-timeline.activeHistoryContent").length > 0) {
    $j(".our-history-timeline.activeHistoryContent")
      .removeClass("open activeHistoryContent")
      .insertAfter($j(".our-history-inner-container input:checked"));
  }
  if ($j(this).hasClass("active")) {
    $j(this).removeClass("active");
    if ($j(window).width() < 768) {
      $j(".our-history-timeline.activeHistoryContent")
        .removeClass("open activeHistoryContent")
        .insertAfter($j(".our-history-inner-container input:checked"));
    }
  } else {
    $j(".our-history-inner-container input").prop("checked", false);
    $j(".our-history-white-item label").removeClass("active");
    $j(this).addClass("active");
    if ($j(this).parent().next().length > 0 && $j(window).width() < 768) {
      $j(
        ".our-history-inner-container input[id='" + $j(this).attr("for") + "']"
      )
        .next()
        .addClass("open activeHistoryContent")
        .insertAfter($j(this).parent());
      setTimeout(function () {
        $j("html,body").animate({ scrollTop: currentLabel.offset().top });
      }, 350);
    } else {
      var previousItemTop = $j(this).parent().prev(".our-history-white-item");

      if (previousItemTop.length > 0) {
        setTimeout(function () {
          var currentItemTop =
            previousItemTop.offset().top +
            previousItemTop.innerHeight() -
            $j(
              ".our-history-inner-container input[id='" +
                currentLabel.attr("for") +
                "']"
            )
              .next()
              .offset().top;
          if (window.innerWidth > 767) {
            $j(
              ".our-history-inner-container input[id='" +
                currentLabel.attr("for") +
                "']"
            )
              .next()
              .css("margin-top", currentItemTop);
          }
          currItem = $j(
            ".our-history-inner-container input[id='" +
              currentLabel.attr("for") +
              "']"
          ).next();
          setTimeout(function () {
            $j("html,body").animate({
              scrollTop:
                previousItemTop.offset().top + previousItemTop.innerHeight(),
            });
          }, 350);
        }, 300);
      } else {
        setTimeout(function () {
          $j("html,body").animate({ scrollTop: currentLabel.offset().top });
        }, 350);
      }
    }
  }
});

