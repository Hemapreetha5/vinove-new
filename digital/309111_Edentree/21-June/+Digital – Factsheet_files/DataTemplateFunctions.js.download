//#region JQuery data template related. 

function CreateMap(input) {
    // the { } symbols cannot be used in the temaplte, this is a workaround
    return eval("({ " + input + " })");
}

function DataToImage(data, imageMap, cssClass, alt, tooltip, defaultImageUrl, defaultText) {

    var map = CreateMap(imageMap);
    var altComponent = alt ? 'alt="' + alt +' ' + data + '"' : '';
    var toolTipComponent = tooltip ? ' title="' + tooltip + '"' : '';
    var keyData = data && typeof (data) == "string" ? data.replace(' ', '') : data;   // white space removed from key to put it in Json format. ColumnDataTemplateParameters of rating column should not have white space(be a single word). Ex: columnId: 460
    var imgClass = cssClass ? 'class="' + cssClass + '"' : '';

    var imageSrc = map[keyData];
    if (imageSrc) {
        return imageSrc == 'ignoreimage' ? data : '<img src="' + imageSrc + '" ' + imgClass + altComponent + toolTipComponent + ' />';  // 'ignoreimage' has been used in ColumnDataTemplateParameters table. used for displaying text instead image for some ratings. Ex: columnId: 460
    }
    else {
        if (defaultImageUrl != null) {
            return '<img src="' + defaultImageUrl + '" ' + imgClass + altComponent + toolTipComponent + ' />';
        }
        else if (defaultText != null) {
            return defaultText;
        }
        else {
            return '';
        }
    }
}

function TemplatedLinkImage(linkLocation, imageLocation) {
    if (linkLocation != null) {
        return '<a href="' + linkLocation + '"><img src="' + imageLocation + '" alt="Link" /></a>';
    }
    else {
        return '';
    }
}

function FormatPercentage(data, nullDisplay, decimalPointDigits, decSeparator) {
    var decimalFormated = FormatDecimal(data, nullDisplay, decimalPointDigits, decSeparator);
    if (decimalFormated != nullDisplay) {
        return decimalFormated + '%';
    }
    else {
        return decimalFormated;
    }
}

function FormatMoney(data, nullDisplay, decimalPointDigits, alwaysShowPlusSign, decSeparator) {

    if (data != null) {
        var num = new Number(data.DisplayAmount);
        var prefix = data.Prefix;
        if (alwaysShowPlusSign && prefix.charAt(0) != '-') {
            prefix = '+' + prefix;
        }
        var amount = NumberToString(num, nullDisplay, decimalPointDigits, decSeparator, false);
        return prefix + amount + data.Suffix;
    }
    else {
        return nullDisplay;
    }
}

function FormatData(data, nullDisplay) {
    if (data != null) {
        return data;
    }
    else {
        return nullDisplay;
    }
}

function FormatBenchmarkBreakdownData(breakdowndata, benchmarkData, standard, target, constraint, comparator, viewBenchmarks, nullvaluedisplaytext) {
    var targetArray = new Array();
    var constraintArray = new Array();
    var comparatorArray = new Array();
    var standardArray = new Array();

    var standardTranslated = standard + ": ";
    var targetTranslated = target + ": ";
    var constraintTranslated = constraint + ": ";
    var comparatorTranslated = comparator + ": ";
    if (benchmarkData != null || breakdowndata.length > 0) {
        if (benchmarkData != null) {
            standardArray.push(benchmarkData);
        }
        if (breakdowndata.length > 0) {
            for (var i = 0; i < breakdowndata.length; i++) {
                if (breakdowndata[i].BenchmarkTypeCode.startsWith('T')) {
                    if (!standardArray.includes(breakdowndata[i].BenchmarkName)) {
                        targetArray.push(breakdowndata[i].BenchmarkName);
                    }
                } else if (breakdowndata[i].BenchmarkTypeCode.startsWith('C')) {
                    if (!standardArray.includes(breakdowndata[i].BenchmarkName) &&
                        !targetArray.includes(breakdowndata[i].BenchmarkName)) {
                        constraintArray.push(breakdowndata[i].BenchmarkName);
                    }
                } else {
                    if (!standardArray.includes(breakdowndata[i].BenchmarkName) &&
                        !targetArray.includes(breakdowndata[i].BenchmarkName) &&
                        !constraintArray.includes(breakdowndata[i].BenchmarkName)) {
                        comparatorArray.push(breakdowndata[i].BenchmarkName);
                    }
                }
            }
        }
        var innerHtml = '';
        innerHtml = '<div class=\"tooltip\">';
        innerHtml += viewBenchmarks;
        innerHtml += '<div class=\"fe-benchmarkbreakdown-div-css\" style=\"display:block\"><ul>';
        if (standardArray.length > 0) {
            standardTranslated += standardArray.join(", ");
            innerHtml += '<li>' + standardTranslated + '</li>';
        }
        if (targetArray.length > 0) {
            targetTranslated += targetArray.join(", ");
            innerHtml += '<li>' + targetTranslated + '</li>';
        }
        if (constraintArray.length > 0) {
            constraintTranslated += constraintArray.join(", ");
            innerHtml += '<li>' + constraintTranslated + '</li>';
        }
        if (comparatorArray.length > 0) {
            comparatorTranslated += comparatorArray.join(", ");
            innerHtml += '<li>' + comparatorTranslated + '</li>';
        }
        innerHtml += "</ul></div></div>";
        return unescape(innerHtml);
    } else {
        return nullvaluedisplaytext;
    }
}

function FormatDocument(data, nullDisplay, openLinkConfigured, cssClass, toolTip, callingFunction) {
    if (data != null) {
        var innerHtml = '';
        if (data.indexOf('::') === -1) {
            innerHtml = '<a class="' + cssClass + '" href="javascript:void(0)" role="button" onclick="' + callingFunction + '(\'' + data + '\', event); return false;" target="' + openLinkConfigured + '" title="' + toolTip + '" ><img src="/Assets/images/transparent-1x1.png" role="presentation" alt="' + toolTip + '" /></a >';
        }
        else if (data.split(',').length === 1) {
            innerHtml = '<a class="' + cssClass + '" href="javascript:void(0)" role="button" onclick="' + callingFunction + '(\'' + data.split('::')[1] + '\', event); return false;" target="' + openLinkConfigured + '" title="' + toolTip + '" ><img src="/Assets/images/transparent-1x1.png" role="presentation" alt="' + toolTip + '" /></a >';
        }
        else {
            innerHtml = "<div class=\"fe-documentdropdownbutton\"  title='" + toolTip + "' onClick=\"toggleMultiDocument(event)\" tabindex=\"0\">";
            innerHtml += "<span class='fe-fund-multidocument-icon'>";
            innerHtml += "<div class=\"fe-multidocument-div-css\" style=\"display:none\"><ul>";
            var arrayOfDocument = data.split(',');
            for (i = 0; i < arrayOfDocument.length; i++) {
                var details = arrayOfDocument[i].split('::');
                innerHtml += '<li><a href="javascript:void(0)" onclick="' + callingFunction + '(\'' + details[1] + '\', event); return false;" target="' + openLinkConfigured + '" >' + details[0] + '</a></li>';
            }

            innerHtml += "</ul></div>";
            innerHtml += "</span></div>";
        }

        return unescape(innerHtml);
    }
    else {
        return nullDisplay;
    }
}

function FormatBool(data, nullDisplay, trueValue, falseValue) {
    if (data != null) {
        if (data) {
            return trueValue;
        }
        else {
            return falseValue;
        }
    }
    else {
        return nullDisplay;
    }
}

function FormatDate(data, nullDisplay, dateTimeFormat) {
    if (data != null) {
        var jsDate = moment.utc(data);
        if (!jsDate.isValid())	// -62135596800000 is datetime min.  Couldn't find a nicer way to compare this.
            return nullDisplay;
        return jsDate.format(ConvertToMomentSupportedFormat(dateTimeFormat));
    }
    return nullDisplay;
}

/**
 * Function to convert the unsupport date formats to moment supported format
 * e.g., yyyy converted to YYYY, respectively
 * @param {any} dateTimeFormat
 */
function ConvertToMomentSupportedFormat(dateTimeFormat) {
    dateTimeFormat = dateTimeFormat.replace(/yy/g, 'YY');
    dateTimeFormat = dateTimeFormat.replace(/dd/g, 'DD');
    return dateTimeFormat;
}

function FormatDecimal(data, nullDisplay, decimalPointDigits, decSeparator) {
    return NumberToString(data, nullDisplay, decimalPointDigits, decSeparator, false);
}

function FormatDecimalWithPlus(data, nullDisplay) {
    return NumberToString(data, nullDisplay, 2, '.', true);
}

function FormatInt(data, nullDisplay) {
    if (data != null) {
        var numericData = Number(data);
        if (!isNaN(numericData)) {
            return numericData.toFixed(0);
        }
        else {
            return data;
        }
    }
    else {
        return nullDisplay;
    }
}

function SwapImage(imageElement) {
    var img = $(imageElement);
    var temp = img.attr('src');
    img.attr('src', img.data('swapimg'));
    img.data('swapimg', temp);
}

function NumberToString(value, defaultValue, decimalPlaces, separator, alwaysShowSign) {
    if (value != null) {
        if (this.data != null && this.data.Name == 'Quartile') {
            decimalPlaces = 0;
        }
        var floatData = parseFloat(value);
        if (floatData != null) {
            if (alwaysShowSign && floatData > 0) {
                return '+' + floatData.toFixed(decimalPlaces).replace('.', separator);
            }
            else {
                return floatData.toFixed(decimalPlaces).replace('.', separator);
            }
        }
        else {
            return value;
        }
    }
    else {
        return defaultValue;
    }

}

function RankinSectorFormat(value, defaultValue,valueT) {
    if (value != null && valueT != null)
    {
        return (value + '/' + valueT);
    }
    else
    {
        return defaultValue;
    }
    }

function ShowPscanHtmlFootNote(footnote) {
    return footnote ? "block" : "none";
}

//#endregion