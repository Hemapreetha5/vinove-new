function UpdateManagersFilter(managerCode) {
    var managerDropDown = $('#ManagerCode');
    if (managerDropDown.length > 0) {
        managerDropDown.val(managerCode);

        if (managerDropDown.val()) {
            managerDropDown.prop("disabled", true);
        }
    }
}

function GetFundCentreModel(fundInfo, pagingState, sortingState, isClearButton) {
    var toolid = fundInfo.GetToolIdbyToolControl();
    var model = {};

    var filteringOptions;
    if (readCookie('FromBackButton') == 'yes') {
        filteringOptions = JSON.parse('[' + readCookie('RetainFilterData_' + toolid) + ']');
    }
    if (filteringOptions && filteringOptions[0] != null) {
        model.FilteringOptions = filteringOptions[0];
    }
    else {
        if (isClearButton == undefined)
            isClearButton = false;
        model.FilteringOptions = FundCentre.AdvancedSearchFilters.GetFilteringOptions(toolid, isClearButton);
        GetShowMainUnits(toolid, model.FilteringOptions);

    }

    AddBasicModelInformation(model, pagingState, sortingState);
    if (fundInfo.data('selectedspecialunittype') != 'DEFAULT') {
        model.SelectedSpecialUnitType = fundInfo.data('selectedspecialunittype');
    }

    return model;
}

function GetShowMainUnits(toolid, filteringOptions) {

    if (toolid == ToolIds.FundCentreId)
        filteringOptions.ShowMainUnits = $(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-FundCentre').is(':checked');
    else if (toolid == ToolIds.FundCentreAMId)
        filteringOptions.ShowMainUnits = $(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-FundCentreAM').is(':checked');
    else if (toolid == ToolIds.AllFundsAMId)
        filteringOptions.ShowMainUnits = $(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-AllFundsAM').is(':checked');
    // This is a fix for browsers that don't support the HTML5 placeholder functionality.
    if (filteringOptions.SearchText) {
        if ((browser.msie || typeof ($('#SearchText-' + toolid)[0].placeholder == "undefined")) &&
            $('#SearchText-' + toolid).val() === $('#SearchText-' + toolid).attr("placeholder")) {
            filteringOptions.SearchText = "";
        }
    }
}
function AddBasicModelInformation(model, pagingState, sortingState) {
    model.ProjectName = modelContents.ProjectName;
    model.LanguageCode = modelContents.LanguageCode;
    model.LanguageId = modelContents.LanguageId;
    model.Theme = modelContents.Theme;
    model.SortingStyle = modelContents.SortingStyle; // this is not required imo

    model.PageNo = pagingState.PageNo;
    model.PageSize = pagingState.PageSize;
    model.OrderBy = sortingState.OrderByColumn;
    model.IsAscOrder = sortingState.IsOrderByAsc;
    model.OverrideDocumentCountryCode = getParameterByNameIgnoreCase('DocumentCountry');
    model.PerformanceCurrency = $('.currencyList').val();

    var filteringOptions = {};

    if (model.FilteringOptions)
    {
        filteringOptions = model.FilteringOptions;
        filteringOptions.MPCategoryCode = filteringOptions.MPCategoryCode ? filteringOptions.MPCategoryCode : getParameterByNameIgnoreCase('MPCategoryCode');
    }
    else {
        filteringOptions.MPCategoryCode = filteringOptions.MPCategoryCode ? filteringOptions.MPCategoryCode : getParameterByNameIgnoreCase('MPCategoryCode');
        filteringOptions.CategoryId = getParameterByNameIgnoreCase('category');
        filteringOptions.Category2Id = getParameterByNameIgnoreCase('category2');
    }

    model.FilteringOptions = filteringOptions;
}

