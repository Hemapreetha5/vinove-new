// Display funds and tabs only if 'display funds on initial load' project level setting is enabled and search is performed
function DisplayFunds(showFunds) {
    if (showFunds == true) {
        $(".fundCentreContent").show();
        $("#selectSearchCriteria").hide();
    }
    else {
        $(".fundCentreContent").hide();
        $("#selectSearchCriteria").show();
    }
}

function DisplayCaveat(showCaveat)
{
    if (showCaveat) $("[data-id=fe-footer-container]").show();
    else $("[data-id=fe-footer-container]").hide();
}

function DisplayDisclaimerPopup() {
    if (modelContents.DisplayDisclaimer) {
        _localStorageHelper.getByLang('disclaimer', 'accept', function(res) {
            if (!res) {
                $(".disclaimer-popup-container").dialog({
                    dialogClass: "disclaimer-popup-main",
                    modal: true,
                    height: 'auto',
                    width: 'auto'
                });
            } else {
                ToolkitUI.disclaimerAgreed = true;
            }
        });
    }

    $(".btn-diclaimer-disagree").on("click", function() {
        window.location.href = $(this).attr("data-returnUrl");
    });

    $(".btn-diclaimer-agree").on("click", function () {
        _localStorageHelper.setByLang('disclaimer', 'accept', true, function(res) {
            ToolkitUI.disclaimerAgreed = true;
            $(".disclaimer-popup-container").dialog('close');
            window.scrollTo(0, 0);
        });
    });
}

_localStorageHelper = {
    getByLang: function(moduleName, propertyName, callback) {
        var langCode = modelContents.LanguageCode;
        var keyName = this.getKeyName(moduleName);
        localforage.getItem(keyName).then(function(storageModel) {
                if (storageModel == null) {
                    storageModel = {};
                }
                var langResult = storageModel[langCode];
                var langModel = {};
                if (langResult != null) {
                    langModel = storageModel[langCode];
                }

                var value = langModel[propertyName];

                if (callback) {
                    callback(value);
                }
            },
            function(err, value) {
                console.log(err);
            });
    },
    setByLang: function(moduleName, propertyName, value, callback) {
        var langCode = modelContents.LanguageCode;
        var keyName = this.getKeyName(moduleName);
        localforage.getItem(keyName).then(function(storageModel) {
                if (storageModel == null) {
                    storageModel = {};
                }
                var langResult = storageModel[langCode];
                var langModel = {};
                if (langResult != null) {
                    langModel = storageModel[langCode];
                }

                langModel[propertyName] = value;
                storageModel[langCode] = langModel;
                localforage.setItem(keyName, storageModel).then(function(model) {
                    if (callback) {
                        callback(model);
                    }
                }).catch(function(err) {
                    console.log(err);
                });
            },
            function(err, value) {
                console.log(err);
            });
    },
    getKeyName: function(moduleName) {
        var projName = modelContents.ProjectName;
        return (projName + '_' + moduleName).toLowerCase();
    }
};

function isSameSiteCookieSupported() {
    var agent = getAgentDetails();

    //Samesite=none not supported for mac OS version 10 and google chrome version lesser than 67
    if ((agent.os.name == "Macintosh" && agent.os.version < 11)
        || ((agent.os.name == "iPhone" || agent.os.name == "iPad") && agent.os.version < 13)
        || (agent.browser.name == "Chrome" && agent.browser.version < 67)
        || (agent.browser.name == "Safari" && agent.browser.version < 13))
        return false;

    return true;
}

function getAgentDetails() {
    'use strict';

    var module = {
        options: [],
        header: [navigator.platform, navigator.userAgent, navigator.appVersion, navigator.vendor, window.opera],
        dataos: [
            { name: 'Windows Phone', value: 'Windows Phone', version: 'OS' },
            { name: 'Windows', value: 'Win', version: 'NT' },
            { name: 'iPhone', value: 'iPhone', version: 'OS' },
            { name: 'iPad', value: 'iPad', version: 'OS' },
            { name: 'Kindle', value: 'Silk', version: 'Silk' },
            { name: 'Android', value: 'Android', version: 'Android' },
            { name: 'PlayBook', value: 'PlayBook', version: 'OS' },
            { name: 'BlackBerry', value: 'BlackBerry', version: '/' },
            { name: 'Macintosh', value: 'Mac', version: 'OS X' },
            { name: 'Linux', value: 'Linux', version: 'rv' },
            { name: 'Palm', value: 'Palm', version: 'PalmOS' }
        ],
        databrowser: [
            { name: 'Chrome', value: 'Chrome', version: 'Chrome' },
            { name: 'Firefox', value: 'Firefox', version: 'Firefox' },
            { name: 'Safari', value: 'Safari', version: 'Version' },
            { name: 'Internet Explorer', value: 'MSIE', version: 'MSIE' },
            { name: 'Opera', value: 'Opera', version: 'Opera' },
            { name: 'BlackBerry', value: 'CLDC', version: 'CLDC' },
            { name: 'Mozilla', value: 'Mozilla', version: 'Mozilla' }
        ],
        init: function () {
            var agent = this.header.join(' '),
                os = this.matchItem(agent, this.dataos),
                browser = this.matchItem(agent, this.databrowser);

            return { os: os, browser: browser };
        },
        matchItem: function (string, data) {
            var i = 0,
                j = 0,
                html = '',
                regex,
                regexv,
                match,
                matches,
                version;

            for (i = 0; i < data.length; i += 1) {
                regex = new RegExp(data[i].value, 'i');
                match = regex.test(string);
                if (match) {
                    regexv = new RegExp(data[i].version + '[- /:;]([\\d._]+)', 'i');
                    matches = string.match(regexv);
                    version = '';
                    if (matches) { if (matches[1]) { matches = matches[1]; } }
                    if (matches) {
                        matches = matches.split(/[._]+/);
                        for (j = 0; j < matches.length; j += 1) {
                            if (j === 0) {
                                version += matches[j] + '.';
                            } else {
                                version += matches[j];
                            }
                        }
                    } else {
                        version = '0';
                    }
                    return {
                        name: data[i].name,
                        version: parseFloat(version)
                    };
                }
            }
            return { name: 'unknown', version: 0 };
        }
    };

    var e = module.init(),
        debug = '';

    return e;
}