var suppressSearch = false;

//#region Document Ready Function
$(function () {

    InitializeUIControls();

    $(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-FundCentre').on("click", function () {

        if ($(this).is(':checked')) {
            $(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-FundCentre').prop('checked', true);
        }
        else {
			$(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-FundCentre').prop('checked', false);
        }

        Search();
    });

    // Moved to setup.js
    //if ($(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-FundCentreAM').length > 0) {
    //    $(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-FundCentreAM').attr('checked', 'checked');
    //}

    //if ($(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-AllFundsAM').length > 0) {
    //    $(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-AllFundsAM').attr('checked', 'checked');
    //}

    $(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-FundCentreAM').on("click", function () {

        if ($(this).is(':checked')) {
			$(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-FundCentreAM').prop('checked', true);
        }
        else {
			$(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-FundCentreAM').prop('checked', false);
        }

        Search(ToolIds.FundCentreAMId);
    });

    $(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-AllFundsAM').on("click", function () {

        if ($(this).is(':checked')) {
			$(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-AllFundsAM').prop('checked', true);
        }
        else {
			$(" .fe-paging-showmainunits input[name='showmainunits']", '.fe-tabs-container-AllFundsAM').prop('checked', false);
        }

        Search(ToolIds.AllFundsAMId);
    });

    //Load default tab data
    var advSearchContainer = $('#advancedSearchContainer');
    if (advSearchContainer.length == 0 || ($(advSearchContainer).attr('data-filter-loaded') == 'True')) {
        executeFundCentreLoadOnFilterReady();
    }

    // shortlist specific - move away along with other shortlist stuff
    // TODO : figure this out 
    // $('#menuTabs').bind("tabsselect", MasterTabSelected);   

    // glossary tab specific - creates custom tab with in glosaary tab
    if (modelContents.EnableScrollTabs) {
        $("#tabs.tabGlossaryContainer").scrollTabs({
            create: function (event, ui) {
                ui.tab.addClass("ui-tabs-selected");
            }
        });
    } else {
        $("#tabs.tabGlossaryContainer").tabs({
            create: function (event, ui) {
                ui.tab.addClass("ui-tabs-selected");
            }
        });
    }
    
});

var invalidXmlCookieName = modelContents.ProjectName + '_xmlInvalidCodes';
function displayInvalidFundsWarningInXMLImport() {
    var invalidCodes = readCookie(invalidXmlCookieName);
    if (invalidCodes) {
        eraseCookie(invalidXmlCookieName);
        var formattedCodes = formatInvalidInstruments(invalidCodes);
        ShowErrorDialog(modelContents.GetTranslation("XMLImportFailureWarningTitle"), (modelContents.GetTranslation("XMLImportFailureWarningMessage") + formattedCodes));
    }
}

function formatInvalidInstruments(codes) {
    codes = codes.split(',');
    var html = '';
    if (codes.length > 0) {
        var ulTag = $("<ul/>", { id: "xmlImportInvalidCodes", "class": "xmlImportInvalidCodesList" });
        for (var i = 0; i < codes.length; i++) {
            $('<li />', { html: codes[i] , "class" : "item"+i }).appendTo(ulTag);
        }
        
        html = $('<div>').append($(ulTag).clone()).html();
    }
    
    return html;
}

function executeFundCentreLoadOnFilterReady()
{
    if ((modelContents.DisplayFundsOnLoad == "True" || modelContents.DisplayFundForUrlParam) && ($('#advancedSearchContainer').length == 0 || $('#advancedSearchContainer').attr('data-filter-loaded') == "True")) {
        var keys = Object.keys(ToolIdMaps);
        var searchExecuted = false;
        $.each($('.fe-search-fileters-dropdown'), function (j, filter) {
            if ($(filter).val() != '' && $(filter).attr("name") != "PerformanceOperator" && !modelContents.DisplayFundForUrlParam) {
                searchExecuted = true;
                return false;
            }
        });

        for (var i = 0; i < keys.length; i++) {
            if (!(searchExecuted && keys[i] == 1)) {
                Search(keys[i]);
            }
        }
    }
    else {
        DisplayFunds(false);
    }

    DisplayCaveat(modelContents.DisplayCaveatOnLoad == "True" || modelContents.DisplayFundsOnLoad == "True" || modelContents.DisplayFundForUrlParam);
}

//Basic search function
function Search(toolId, resetPaging, isClearButton, source) {
    if (typeof resetPaging == "undefined" || resetPaging) {
        resetPaging = true;
    }
    var control = ToolIdMaps[toolId];
       
    if (!control)
        control = ToolIdMaps[ToolIds.FundCentreId];

    if (!suppressSearch) {
        DisplayFunds(true);
        DisplayCaveat(true);
        if ($(control).length > 0) {
            $(control).FundInfoLoadData(true, resetPaging, false, isClearButton, source);
        }
    }

}

function SearchByListitem(toolId, resetPaging, isClearButton, source, showAllAsOption, isAutoSearch) {
    if ($(source).is(':checkbox')) {
        var checked = $('input[type=checkbox]:checked', $(source).closest('.fe-filterlist-content')).not('input[id$="' + $(source).closest('.fe-filterlist-content').attr('id') + 'All"]').length;

        if (showAllAsOption) {
            if (checked == 0) {
                $('input[type=button]', $(source).closest('.fe-filterlist-content')).prop("disabled", true);
            } else {
                $('input[type=button]', $(source).closest('.fe-filterlist-content')).prop("disabled", false);
            }
        } else {
            if (checked == 0) {
                $(source).prop("checked", true);
                $(source).closest('label').toggleClass("checked", true);
                return;
            }
        }
    }
    else if ($(source).is(':radio')) {
        $('input[type=button]', $(source).closest('.fe-filterlist-content')).prop("disabled", false);
        $('label', $(source).closest('.fe-filterlist-content')).toggleClass("checked", false);
        $(source).closest('label').toggleClass("checked", true);
    }

    if ($(source).closest('.fe-filterlist-content').is('[data-isCascading]')) {
        var projectToolId = $(source).closest("form").attr("data-projectToolId");
        FundCentre.AdvancedSearchFilters.GetFilterData($(source).closest('.fe-filterlist-content').prop('id'), false, toolId, projectToolId);
    }

    if (isAutoSearch) {
        Search(toolId, resetPaging, isClearButton, source);
    }
}

function clearSelection(source, toolid, isAutoSearch, showAllAsOption) {
    $('input[type=checkbox],input[type=radio]', $(source).closest('.fe-filterlist-content')).prop('checked', false);
    $('label.checked', $(source).closest('.fe-filterlist-content')).removeClass('checked');
    $(source).prop("disabled", true);
    SearchByListitem(toolid, false, false, source, showAllAsOption, isAutoSearch);

}

