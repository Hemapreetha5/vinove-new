function LoadTool(filePath, event) {
    var currencyValue = $('#currencyList').val();
    var hasPerformanceCurrencyParam = (filePath.indexOf('PerformanceCurrency') !== -1);

    if (currencyValue !== undefined && !hasPerformanceCurrencyParam) {
        var newUrl = filePath.split("?")[0];
        newUrl += "?PerformanceCurrency=" + currencyValue;
        var queryParams = filePath.split("?")[1];
        if (queryParams) {
            newUrl += "&" + queryParams;
        }

        filePath = newUrl;
    }

    LoadDocument(filePath, event, 1);
}


function LoadOriginalDoc(filePath, event) {
    LoadDocument(filePath, event, 2);
}

//Refactoring: Download Tool uses a similar method above need find possible ways to merge with this method.
function LoadDocument(filePath, event, loaderIdentifier) {
    var eventObj = (window.event || event) ? $.event.fix(event || window.event) : null;
    if (eventObj != null) {
        eventObj.preventDefault();
    }
    var openWindowMethod = "";
    if (eventObj && (eventObj.target) && ($(eventObj.target).attr('target'))) {
        openWindowMethod = eventObj.target.attributes['target'].value;
    }

    if (eventObj && (eventObj.currentTarget) && (eventObj.currentTarget.className == "fe-icon-chart" || eventObj.currentTarget.className == "fe-icon-factsheet") && (eventObj.target.attributes['target'] != undefined && eventObj.target.attributes['target'].value == '_blank') && typeof GetFilteringOptions !== 'undefined' && $("[id^='searchform-']").length > 0) {
        var toolId = $("[id^='searchform-']").attr('data-toolid');
        var filteringOptions = GetFilteringOptions(toolId, false);
        GetShowMainUnits(toolId, filteringOptions);
        createCookie(("RetainFilterData_" + toolId), JSON.stringify(filteringOptions));
    }

    if (ToolkitUI.disclaimerAgreed && loaderIdentifier === 1) {
        var loc = getLocation(filePath);
        // Append parameter only for cross domain urls
        if (location.host.toLowerCase() !== loc.host.toLowerCase()) {
            filePath = filePath + (loc.search ? '&dc=1' : '?dc=1');
        }
    }
        
    // encodeURIComponent = encodeURI + encodes the following characters: , / ? : @ & = + $ #
    var absolutePath = '/' + GetLoader(loaderIdentifier) + '?FilePath=' + encodeURIComponent(filePath) + "&themeName=" + modelContents.Theme + "&projectName=" + modelContents.ProjectName;
    if (!(eventObj) || !(eventObj.target) || !(eventObj.currentTarget) ||
        (eventObj.currentTarget.className != "fe-icon-chart"))
        window.open(absolutePath, (openWindowMethod == "" ? '_blank' : openWindowMethod));
    else {
        window.open(absolutePath, (openWindowMethod == "" ? '_self' : openWindowMethod));
    }
}

function GetLoader(loaderTypeId) {
    /**
    1 - FE tools
    2 - Documents
    3 - Custom URL (need to implement)
    **/
    switch(loaderTypeId)
    {
        case 1:
            return "LoadTool";
            break;
        case 2:
            return "LoadDocuments";
            break;
        default:
            return "LoadDoc";
            break;
    }
}

function LoadDocumentWithProgress(filePath, interval, windowName) {
    // encodeURIComponent = encodeURI + encodes the following characters: , / ? : @ & = + $ #
    var absolutePath = '/Assets/Html/Static/LoadDocWithProgressBar.htm?FilePath=' + encodeURIComponent(filePath) + "&length=" + interval;
    if (windowName) {
        window.open(absolutePath, windowName);

    } else {
        window.open(absolutePath);

    }
}

function LoadMercerDocument(value, event) {
    //SendEventTrackingData('Document', 'Download', 'Mercer');
    var citiCode = $(event.currentTarget || event.srcElement).attr("data-CitiCode");
    var docCode = $(event.currentTarget || event.srcElement).attr("data-doccode");

    var model = $.extend({ "Value1": docCode }, { "Value2": citiCode });

    //Does the name already exist
    $(this).sendJsonAsString(modelContents.GetMercerDocumentUrl, model,
        function (result) {
            if (result.success) {
                location.href = result.documentUrl;
            } else {
                ShowErrorDialog("Load Document", "An Error has occured whilst processing your request");
            }
        });
}

function LoadUSDocument(value, event) {
    //SendEventTrackingData('Document', 'Download', 'US');
    var citiCode = $(event.currentTarget || event.srcElement).attr("data-CitiCode");
    var docCode = $(event.currentTarget || event.srcElement).attr("data-doccode");

    var parameters = "?documentCode=" + docCode + "&citiCode=" + citiCode + "#startofdoc";
    var win = window.open(modelContents.GetUSDocument + parameters);
}

function LoadMercerProfileDocument(value, event) {
    var typeCode = $(event.currentTarget || event.srcElement).attr("data-typecode");

    var inputObj = { 'Value1': typeCode };

    //Does the name already exist
    $(this).sendJsonAsString(modelContents.GetMercerProfileDocumentUrl, inputObj,
        function (result) {
            if (result.success) {
                window.open(result.documentUrl);
            } else {
                ShowErrorDialog("Load Document", "An Error has occured whilst processing your request");
            }
        });
}


function LoadManagerFundReports(value, event) {

    var citiCode = $(event.currentTarget || event.srcElement).attr("data-code");
    var container = $('#ManagerReportsDlg');
    container.dialog({
        height: 200,
        width: 300,
        position: [event.clientX, event.clientY],
        close: function () {
            container.html('<p>&nbsp;</p>');
        }
    });

    var inputObj = { 'Value1': citiCode };

    $(this).sendJsonAsString(modelContents.FundCentreManagerReportsActionUrl, inputObj,
        function (response, status, xhr) {
            container.html(response);
        });
}

function OpenDownloadTool(filePath, event) {
    RefreshHistory(this, "#priceHtmlContainer", "#btnPriceHistory");
    var eventObj = (window.event || event) ? $.event.fix(event || window.event) : null;
    if (eventObj) {
        eventObj.preventDefault();
    }
    var citicode = event ? $(event.currentTarget || event.srcElement).attr("data-code") : null;
    var tab = $('#menuTabs');
    var selectedTab = tab.find('.fe-menuTabs-list li a')[modelContents.EnableScrollTabs
        ? tab.scrollTabs('option', 'active')
        : tab.tabs('option', 'active')];
    var selectedTabId = selectedTab ? selectedTab.id : null;  // Use unique Id of the Selected Tab.
    var isPortfolioToolLevelDownload = $(event.currentTarget || event.srcElement).attr("id") == "btn-portfolio-downloadTool";
    var onlyStatementTabConfigured = ($('.fe-price-container').length +
            $('.fe-dividend-container').length +
            $('.fe-documents-container').length) === 0;
    $('#pricefundOptions').empty();
    $('#dividendfundOptions').empty();
    $('#documentsfundOptions').empty();
    $('#statementfundOptions').empty();
    if (!onlyStatementTabConfigured) {
        if (isPortfolioToolLevelDownload) {
            DownloadTool.Download.GetFundOptions(citicode,
                null,
                null,
                selectedTabId == "PortfolioMasterTab" ? 7 : null);
        } else if (!modelContents.ShowAllFunds) {
            var priipProductCode = getParameterByNameFromURLIgnoreCase('PriipProductCode', filePath);
            if (priipProductCode) {
                priipProductCode = $.trim(priipProductCode);
            }
            DownloadTool.Download.GetFundOptions(citicode, null, null, null, null, priipProductCode);
        } else {
            var rangeCode = getParameterByNameFromURLIgnoreCase('rangecode', filePath);
            if (rangeCode) {
                rangeCode = $.trim(rangeCode);
            }
            var category = getParameterByNameFromURLIgnoreCase('category', filePath);
            if (category) {
                category = $.trim(category);
            }
            var category2 = getParameterByNameFromURLIgnoreCase('category2', filePath);
            if (category2) {
                category2 = $.trim(category2);
            }

            var forSaleIn = getParameterByNameFromURLIgnoreCase('forsalein', filePath);
            if (forSaleIn) {
                forSaleIn = $.trim(forSaleIn);
            }
            var priipProductCode = getParameterByNameFromURLIgnoreCase('PriipProductCode', filePath);
            if (priipProductCode) {
                priipProductCode = $.trim(priipProductCode);
            }

            DownloadTool.Download.GetFundOptions(citicode, rangeCode, category, null, forSaleIn, priipProductCode, category2);
        }
    }

    $('#DownloadToolContainer').dialog({
        resizable: true,
        draggable: false,
        width: 820,
        height: 'auto',
        dialogClass: "fe-ui-dialog fe-ui-form-dialog fe-dialog-createDownloadTool-container",
        title: modelContents.GetTranslation("DownloadToolName"),
        open: function () {
            MakeCloseButtonWorking($(".fe-dialog-createDownloadTool-container"));
            if ($('.fe-statement-container').length > 0) {
                GenerateAutoComplete(ToolIds.DownloadToolId, DownloadTool.Download.SelectFundFromAutoComplete, DownloadTool.Download.OnAutoCompleteTextChange, true);
            }
        },
        close: function() {
            if ($('.fe-statement-container').length > 0) {
                $('.fe-statement-container input:text').val('');
                if (StatementData != null) {
                    StatementData.LastAdded = '';
                }
            }
        }
    });

    if (modelContents.ShowAllFunds && citicode) {
        $(".downloadtool_funds").each(function (index) {
            $(this).val(citicode.toUpperCase());
        });

        $('form.mfs').mfs('refresh');
    }
}

