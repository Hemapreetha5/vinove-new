function RemoveFromPortfolio(value, event) {

    var eventObj = (window.event || event) ? $.event.fix(event || window.event) : null;
    if (eventObj) eventObj.preventDefault();
    // event.srcElement for IE prior to 9
    var codeToRemove = $(event.currentTarget || event.srcElement).attr("data-code");

    if (!showMultipleWatchlists) {
        var fundItem = $('.fe-icon-portfolio-remove a, .fe-fund-tableBody').filter(function (index) {

            return $(this).attr('data-code') === codeToRemove;
        });

        if (fundItem.length > 0) {
            fundItem.parent().removeClass('fe-icon-portfolio-remove');
            fundItem.parent().addClass('fe-icon-portfolio-add');
        }

        masterContainer.portfolioContainer.Remove(new ContainerInfo(null, codeToRemove));
        masterContainer.portfolioComparisonContainer.Remove(new ContainerInfo(null, codeToRemove));
        if (modelContents.AllowSavingOfPortfolios == "True") {
            CurrentPortfolioChanged();
        }
    }
    else {
        var tabsPortfolio = GetInternalState($("#tabs-portfolio"));
        var activeContainer = tabsPortfolio.ActiveContainer[0];
        SetPositionOfAjaxLoader(activeContainer, true);
        var currentWatchlistItems = multipleWatchlists.getCurrentOptionWatchlistItems();
        var watchlistName = currentWatchlistItems.watchlistName;

        multipleWatchlists.RemoveFromWatchlistContentLocalStorage(watchlistName, [{ Code: codeToRemove }]);
        var parsedWatchlistData = watchlistData[watchlistName] || null;

        if (parsedWatchlistData !== null) {
            const indexToRemove = parsedWatchlistData.DataList.findIndex(item => item.Common && item.Common.TypeCode === codeToRemove);

            // Remove the item if found
            if (indexToRemove !== -1) {
                parsedWatchlistData.DataList.splice(indexToRemove, 1);
                watchlistData[watchlistName] = parsedWatchlistData;
            }
        }

        multipleWatchlists.DeleteUserWatchlistItems(currentWatchlistItems.watchlistId, watchlistName, [codeToRemove]);
    }
}

