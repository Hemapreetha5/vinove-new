function WeightChanged(modelValue, event) {
    // event.srcElement for IE prior to 9
    var eventSource = $(event.currentTarget || event.srcElement);
    var code = eventSource.attr("data-code");
    var containerItem = GetItemWithCode(masterContainer.portfolioContainer.Get(), code);

    if (containerItem != null) {
        var typedWeight = ConvertToFloat(eventSource.val(), 0);
        if (typedWeight < 0) {
            typedWeight = 0;
        }

        containerItem.Weight = typedWeight;
        masterContainer.portfolioContainer.PersistState();

        eventSource.val(typedWeight);
    }

    RecalculateTotalWeight(eventSource.parents("table"));
    if (modelContents.AllowSavingOfPortfolios == "True") {
        CurrentPortfolioChanged();
    }
}

