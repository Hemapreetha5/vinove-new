function GetTemplateAndSectionInfos(container, searchText, toolId) {
    var sectionIds = $('div[id^="' + searchText + '_"]', container).map(function (index) {
        return this.id.split('_')[1];
    });

    sectionIds = $.uniqueSort(sectionIds);

    var templateIds = $('[id^="template_' + toolId + '_' + searchText + '_"]').map(function (index) {
        return this.id.split('_')[3];
    });

    templateIds = $.uniqueSort(templateIds);

    return { SectionIds: sectionIds, TemplateIds: templateIds };
}

