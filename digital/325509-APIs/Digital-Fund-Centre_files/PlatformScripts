function comparer(index, dateFormat, isDateColumn) {
    return function (a, b) {
        var valA = getCellValue(a, index), valB = getCellValue(b, index)
        if (isDateColumn) {
            dateFormat = dateFormat.toUpperCase();
            var dateA = moment(valA, dateFormat).toDate();
            var modifiedDateA = dateA == "Invalid Date" ? new Date(1900, 0, 1) : dateA;
            var dateB = moment(valB, dateFormat).toDate();
            var modifiedDateB = dateB == "Invalid Date" ? new Date(1900, 0, 1) : dateB;
            return modifiedDateA - modifiedDateB;

        }
        return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
    }
}

