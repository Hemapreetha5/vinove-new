function CheckBenchmarkSettingsForScan(errorMsg, weightedUnits, portfolioStartDateFormat) {
    // check if benchmark is selected. Should have exactly one benchmark selected
    if (!IsBenchmarkInputValid()) {
        errorMsg = modelContents.GetTranslation("PScanBenchmarkValidation");
        return errorMsg;
    }

    // should have exactly one time period selected
    var dateFormat = $("#customPortfolioStartDatePicker").attr('data-dateFormat');
    if (!IsTimePeriodValid(dateFormat)) {
        errorMsg = modelContents.GetTranslation("PScanTimePeriodValidation");
        return errorMsg;
    }

    // if there is a start date selected as time period, check that date is valid and falls within the constituents history
    if ($('#ddTimePeriod').val() == "") {
        if (!IsCustomStartDateValid(dateFormat)) {
            errorMsg = modelContents.GetTranslation("InvalidDateError");
            return errorMsg;
        }

        if (!IsCustomStartDateHasHistory(weightedUnits, portfolioStartDateFormat)) {
            errorMsg = modelContents.GetTranslation("PortfolioStartDateHistoryValidation");;
            return errorMsg;
        }
    }

    return errorMsg;
}

