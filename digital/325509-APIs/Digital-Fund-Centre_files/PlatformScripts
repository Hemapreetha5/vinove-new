function SetNewIconAndOrdering(sortedColumn, isAsc, fundInfo, isSortButton) {
    var orderByOptions = GetOrderByOptions(fundInfo);
    var state = GetInternalState(fundInfo);
    state.OrderByOptions = orderByOptions;
    var activeContainer = state.ActiveContainer;
    var isFirstTime;
    if (!sortedColumn) {
        sortedColumn = orderByOptions.OrderByColumn.replace(':init', '');
        isAsc = orderByOptions.IsOrderByAsc;
        isFirstTime = true;
    }

    if (orderByOptions.OrderByColumn != null) {
        //There was ordering in place - clear the icon				
        var oldIcon, orderbyColumn;
        orderbyColumn = orderByOptions.OrderByColumn.replace(':init', '');
        if (isSortButton != null && isSortButton.toLowerCase() == 'true') {
            oldIcon = GetSortingIcon(activeContainer, orderbyColumn);
            ClearIcon(oldIcon);
        } else {
            oldIcon = GetGridSortingIcon(activeContainer, orderbyColumn);
            ClearGridIcon(oldIcon);
        }

        if (isAsc == null) {
            // if the ordering is not specified then we swtich it alternatively (1 arrow)
            if (orderByOptions.OrderByColumn == sortedColumn) {
                orderByOptions.IsOrderByAsc = !orderByOptions.IsOrderByAsc;
            }
            else {
                orderByOptions.OrderByColumn = sortedColumn;
                orderByOptions.IsOrderByAsc = false; //default value
            }
        } else {
            orderByOptions.IsOrderByAsc = isAsc;
            if (!isFirstTime) {
                orderByOptions.OrderByColumn = sortedColumn;
            }
        }

    }
    else {
        orderByOptions.OrderByColumn = sortedColumn;
        orderByOptions.IsOrderByAsc = isAsc || false;
    }

    SetInternalState(fundInfo, state);

    if (isSortButton != null && isSortButton.toLowerCase() == 'true') {
        var newIcon = GetSortingIcon(activeContainer, sortedColumn);
        SetSortingIcon(newIcon, orderByOptions.IsOrderByAsc);
    } else {
        var newIcon = GetGridSortingIcon(activeContainer, sortedColumn);
        SetGridSortingIcon(newIcon, orderByOptions.IsOrderByAsc);
    }

    // save the option changes
    SetInternalState(fundInfo, state);

    function SetGridSortingIcon(icon, isAsc) {

        if (icon.SortingStyle == 1 || !icon.SortingStyle) {
            var newClass;
            if (!isAsc) {
                newClass = 'ui-icon-triangle-1-s';
            }
            else {
                newClass = 'ui-icon-triangle-1-n';
