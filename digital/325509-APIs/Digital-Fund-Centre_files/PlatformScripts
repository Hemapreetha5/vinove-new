//Refactoring: Download Tool uses a similar method above need find possible ways to merge with this method.
function LoadDocument(filePath, event, loaderIdentifier) {
    var eventObj = (window.event || event) ? $.event.fix(event || window.event) : null;
    if (eventObj != null) {
        eventObj.preventDefault();
    }
    var openWindowMethod = "";
    if (eventObj && (eventObj.target) && ($(eventObj.target).attr('target'))) {
        openWindowMethod = eventObj.target.attributes['target'].value;
    }

    if (eventObj && (eventObj.currentTarget) && (eventObj.currentTarget.className == "fe-icon-chart" || eventObj.currentTarget.className == "fe-icon-factsheet") && (eventObj.target.attributes['target'] != undefined && eventObj.target.attributes['target'].value == '_blank') && typeof GetFilteringOptions !== 'undefined' && $("[id^='searchform-']").length > 0) {
        var toolId = $("[id^='searchform-']").attr('data-toolid');
        var filteringOptions = GetFilteringOptions(toolId, false);
        GetShowMainUnits(toolId, filteringOptions);
        createCookie(("RetainFilterData_" + toolId), JSON.stringify(filteringOptions));
    }

    if (ToolkitUI.disclaimerAgreed && loaderIdentifier === 1) {
        var loc = getLocation(filePath);
        // Append parameter only for cross domain urls
        if (location.host.toLowerCase() !== loc.host.toLowerCase()) {
            filePath = filePath + (loc.search ? '&dc=1' : '?dc=1');
        }
    }

    // encodeURIComponent = encodeURI + encodes the following characters: , / ? : @ & = + $ #
    var absolutePath = '/' + GetLoader(loaderIdentifier) + '?FilePath=' + encodeURIComponent(filePath) + "&themeName=" + modelContents.Theme + "&projectName=" + modelContents.ProjectName;
    if (!(eventObj) || !(eventObj.target) || !(eventObj.currentTarget) ||
        (eventObj.currentTarget.className != "fe-icon-chart"))
        window.open(absolutePath, (openWindowMethod == "" ? '_blank' : openWindowMethod));
    else {
        window.open(absolutePath, (openWindowMethod == "" ? '_self' : openWindowMethod));
    }
}

