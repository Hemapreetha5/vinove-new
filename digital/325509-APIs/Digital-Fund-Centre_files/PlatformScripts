function sortDropDownListByText(element) {
    var foption = element.find('option:first');
    var soptions = null;
    if (foption.val() == '') {
        var soptions = element.find('option:not(:first)');
        sortList(soptions);
    }
    else {
        var soptions = element.find('option');
        sortList(soptions);
    }

    element.html(soptions).prepend(foption);
};

function sortList(soptions) {
    var arr = soptions.map(function (_, o) {
        return {
            t: $(o).text(),
            v: o.value
        };
    }).get();
    arr.sort(function (o1, o2) {
        return o1.t.toUpperCase() > o2.t.toUpperCase() ? 1 : o1.t.toUpperCase() < o2.t.toUpperCase() ? -1 : 0;
    });
    soptions.each(function (i, o) {
        o.value = arr[i].v;
        $(o).text(arr[i].t);
    });
};
