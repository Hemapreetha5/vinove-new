function GetPortfolioUnits(selectedTab) {
    var weightedUnits = [];
    if ($('.fe-column-portfolio-value').length > 0) {
        $('.fe-column-portfolio-value', selectedTab).each(function () {
            var valueUnit = $(this);
            var value = ConvertToFloat(valueUnit.val().replace(/[^0-9\.]/g, ""), 0);
            if (value > 0) {
                var unit = new Unit(valueUnit.attr('data-citi'),
                    valueUnit.attr('data-code'),
                    valueUnit.attr('data-pricedate'),
                    valueUnit.attr('data-sectorcode'),
                    "0", value.toString());
                weightedUnits.push(unit);
            }
        });

        var totalWeight = 0;
        for (var i = 0; i < weightedUnits.length; i++) {
            var weight = ConvertToFloat((weightedUnits[i].Value / GetTotalPortfolioValue(selectedTab)) * 100);
            if (i !== weightedUnits.length - 1) {
                weightedUnits[i].Weight = weight;
                totalWeight += weight;
            } else {
                if (totalWeight + weight !== 100) {
                    weightedUnits[i].Weight = 100 - totalWeight;
                } else {
                    weightedUnits[i].Weight = weight;
                }
            }
        }
    } else {
        $('.fe-column-weight', selectedTab).each(function () {
            var weightedUnit = $(this);
            var weight = ConvertToFloat(weightedUnit.val(), 0);
            if (weight > 0) {
                // weight.toString() is called because there is some kind of an issue with the binder converting js float to c# decimal on the ASP.MVC side. Works fine with string
                var unit = new Unit(weightedUnit.attr('data-citi'),
                    weightedUnit.attr('data-code'),
                    weightedUnit.attr('data-pricedate'),
                    weightedUnit.attr('data-sectorcode'),
                    weight.toString(), "0");
                weightedUnits.push(unit);
            }
        });
    }

    return weightedUnits;
}

