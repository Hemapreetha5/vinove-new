function RecalculateTotalWeight(tableElement) {
    var totalValueElement = tableElement.find(".fe-portfolio-totalValue");
    var total = 0.0;

    tableElement.find(".fe-column-weight").each(function (index, txt) {
        var parsedValue = ConvertToFloat(txt.value, 0);
        if (parsedValue < 0) {
            parsedValue = 0;
        }

        total = total + parsedValue;
    });

    if (total)
        totalValueElement[0].innerHTML = total.toFixed(2);
}

function RecalculateTotalPortfolio(tableElement) {
    var totalValueElement = tableElement.find(".fe-totalPortfolioValue");
    var total = 0.0;

    tableElement.find(".fe-column-portfolio-value").each(function (index, txt) {
        var parsedValue = ConvertToFloat(txt.value.replace(/[^0-9\.]/g, ""), 0);
        if (parsedValue < 0) {
            parsedValue = 0;
        }
        total = total + parsedValue;
    });

    if (total)
        totalValueElement[0].innerHTML = total.toLocaleString();
}

function GetTotalPortfolioWeight(selectedTab) {
    return ConvertToFloat($('.fe-portfolio-totalValue', selectedTab)[0].innerHTML);
}

function GetTotalPortfolioValue(selectedTab) {
    return ConvertToFloat($('.fe-totalPortfolioValue', selectedTab)[0].innerHTML.replace(/[^0-9\.]/g, ""), 0);
}

function GetItemWithCode(containerItems, code) {
    for (var i in containerItems) {
        if (containerItems.hasOwnProperty(i)) {
            if (containerItems[i].Code === code) {
                return containerItems[i];
            }
        }
    }

    return null;
}

function ConvertToFloat(value, defaultValue) {
    var parsedValue = parseFloat(value).toFixed(2);
    parsedValue = parseFloat(parsedValue); // toFixed returns a string

    if (isNaN(parsedValue)) {
        parsedValue = defaultValue;
    }

    return parsedValue;
}

PortfolioTool.Benchmark = function () {

    setBenchmarkSettings = function (pscanSource) {
        var selectedTab = $('a', '.fe-tabs-container-Portfolio .ui-tabs-active');
        var selectedTabHref = selectedTab.attr('href');

        //Check weighting total 100%
        if ($('.fe-column-weight', selectedTabHref).length > 0) {
