function GenerateBreakdownsCharts(container, model) {
    $.each($('.breakdownsChart', container), function (index) {
        $chart = $(this);

        var chartId = $chart.attr('id');

        // give the chart an ID if it doesn't have one	
        if (chartId === undefined) {
            chartId = 'breakdownsChart_' + index;
            $chart.attr('id', chartId);
        }

        // If the chart hasn't already been drawn
        if ($chart.children().length == 0) {

            // Draw the chart if it's container is visible
            if ($chart.closest(".fe-section-accordion-container").length == 0 || $chart.closest(".fe-section-accordion-container").is(':visible')) {
                RenderBreakdownsChart(model, chartId, $chart);

            } else {
