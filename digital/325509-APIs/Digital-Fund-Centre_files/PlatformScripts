                            // fire the event without the timeout once, so the weight values are rendered (VSTS:47246) and not sure about the below logic, so carry on with that.
                            FireEvent("OnTabRendered", fundInfo, container, isFirstTime);

                            for (var retryCount = 0; retryCount < 5; retryCount++) {

                                var width = $(document).width();
                                var height = document.body.clientHeight + 30;

                                setTimeout(function () {
                                    FireEvent("OnTabRendered", fundInfo, container, isFirstTime);
                                }, 1000);

                                if (!(width == 0 && height == 30 && retryCount < 5)) {
                                    break;
                                }

                            }
                        }
                    } else {
                        HideFundTableAndShowNoResult(container.parent());
                        HideFundListsAndShowNoResult(container);

                        //If its a firsttime this will be true, when we dont want to send the height
                        if (!isFirstTime && !modelContents.FundCentreAMEnabled) {
