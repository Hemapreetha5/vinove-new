function SearchByListitem(toolId, resetPaging, isClearButton, source, showAllAsOption, isAutoSearch) {
    if ($(source).is(':checkbox')) {
        var checked = $('input[type=checkbox]:checked', $(source).closest('.fe-filterlist-content')).not('input[id$="' + $(source).closest('.fe-filterlist-content').attr('id') + 'All"]').length;

        if (showAllAsOption) {
            if (checked == 0) {
                $('input[type=button]', $(source).closest('.fe-filterlist-content')).prop("disabled", true);
            } else {
                $('input[type=button]', $(source).closest('.fe-filterlist-content')).prop("disabled", false);
            }
        } else {
            if (checked == 0) {
                $(source).prop("checked", true);
                $(source).closest('label').toggleClass("checked", true);
                return;
            }
        }
    }
    else if ($(source).is(':radio')) {
        $('input[type=button]', $(source).closest('.fe-filterlist-content')).prop("disabled", false);
        $('label', $(source).closest('.fe-filterlist-content')).toggleClass("checked", false);
        $(source).closest('label').toggleClass("checked", true);
    }

    if ($(source).closest('.fe-filterlist-content').is('[data-isCascading]')) {
        var projectToolId = $(source).closest("form").attr("data-projectToolId");
        FundCentre.AdvancedSearchFilters.GetFilterData($(source).closest('.fe-filterlist-content').prop('id'), false, toolId, projectToolId);
    }

    if (isAutoSearch) {
        Search(toolId, resetPaging, isClearButton, source);
    }
}

function clearSelection(source, toolid, isAutoSearch, showAllAsOption) {
    $('input[type=checkbox],input[type=radio]', $(source).closest('.fe-filterlist-content')).prop('checked', false);
    $('label.checked', $(source).closest('.fe-filterlist-content')).removeClass('checked');
    $(source).prop("disabled", true);
    SearchByListitem(toolid, false, false, source, showAllAsOption, isAutoSearch);

}

