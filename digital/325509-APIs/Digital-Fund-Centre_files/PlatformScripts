            PlotBarChart(model, state.ChartCachedModel[typeCodes.toString() + sectionId + state.PagingState.PageNo], sectionId, chartFilters, obj, toolId);
        }
        else {

            var searchModel = GetSearchModel(toolId, 0);
            searchModel.RangeCode = model.RangeCode;
            if (!searchModel.RangeCode && $("#RangeId-" + toolId)) {
                searchModel.RangeCode = $("#RangeId-" + toolId).val();
            }
            var chartModel = $.extend(searchModel, { ChartFilters: chartFilters });

            chartModel.PerformanceCurrency = getQueryStringValue("PerformanceCurrency");
            $(this).sendJsonAsString(modelContents.FundDiscretePerformanceUrl, chartModel,
                function (response) {
                    //typeCodes are used as part of key as citicodes are already used for line chart cache
                    state.ChartCachedModel[typeCodes.toString() + sectionId + state.PagingState.PageNo] = response;
                    PlotBarChart(model, response, sectionId, chartFilters, obj, toolId);
                }, null, chartFilters.length);
        }
    });


    $.each(templateSectionIds, function (count, sectionId) {

        if (($.inArray(sectionId, sectionids) == -1) && (!state.ChartCachedModel[typeCodes.toString() + sectionId + state.PagingState.PageNo])) {
            //Request for data list    
            var chartFilters = $.map(model.DataList, function (v) {
                return {
                    Name: v.FundInfo.Name,
                    TypeCode: v.FundInfo.TypeCode,
                    Currency: v.Price.Currency_UnitLevel,
                    BenchmarkCurrencyCode: v.FundInfo.BenchmarkCurrencyCode,
                    SectorCurrencyCode: v.FundInfo.SectorCurrencyCode,
                    CitiCode: v.FundInfo.CitiCode,
                    SectionId: sectionId,
                    SectorClassCode: v.FundInfo.SectorClassCode,
                    BenchmarkTypeCode: v.FundInfo.BenchmarkTypeCode,
                    Sector: v.FundInfo.Sector,
                    Benchmark: v.FundInfo.Benchmark,
                    BenchmarkBreakdowns: v.FundInfo == undefined || v.FundInfo.BenchmarkBreakdowns.length == 0 ? null : v.FundInfo.BenchmarkBreakdowns,
                    PriceType: v.Price.PriceType,
                    SpecialUnitPriceType: v.FundInfo.DefaultSpecialUnitPriceType,
                    SpecialUnitTypeCode: v.FundInfo.DefaultSpecialUnitTypeCode,
                    SpecialUnitName: v.FundInfo.DefaultSpecialUnitName,
                    SpecialUnitType: v.FundInfo.DefaultSpecialUnitType
                };
            });

            var searchModel = GetSearchModel(toolId, 0);
            searchModel.RangeCode = model.RangeCode;
            if (!searchModel.RangeCode && $("#RangeId-" + toolId)) {
                searchModel.RangeCode = $("#RangeId-" + toolId).val();
            }

            var chartModel = $.extend(searchModel, { ChartFilters: chartFilters });
            chartModel.PerformanceCurrency = getQueryStringValue("PerformanceCurrency")

            $(this).sendJsonAsString(modelContents.FundDiscretePerformanceUrl, chartModel,
                function (response) {
                    //typeCodes are used as part of key as citicodes are already used for line chart cache
                    state.ChartCachedModel[typeCodes.toString() + sectionId + state.PagingState.PageNo] = response;
                }, null, chartFilters.length);
        }
    });

}

function PlotBarChart(model, response, sectionId, chartFilters, container, toolId) {

    $.each(chartFilters, function (i, chartFilter) {
        var fundPerformance = response.DiscretePerformance != null ? $.map(response.DiscretePerformance, function (val) { if (val.TypeCode == chartFilter.TypeCode) return val; }) : null;
        var fundData = $.map(model.DataList, function (val) { if (val.FundInfo.TypeCode == chartFilter.TypeCode) return val; });

        if (!response.DiscretePerformance || response.DiscretePerformance.length == 0 || fundPerformance.length == 0) {
            $("#PerfBarChartSection_" + sectionId + "_" + fundData[0].FundInfo.CitiCode).empty();
            $("#PerfBarChartSection_" + sectionId + "_" + fundData[0].FundInfo.CitiCode).text(modelContents.GetTranslation('NoPerformanceChart'));
            $("#PerfBarChartResetButton_" + sectionId + "_" + fundData[0].FundInfo.CitiCode).hide();
        }
    });

    if (response.DiscretePerformance == null || response.DiscretePerformance.length == 0) {
        return;
    }

    $.each(chartFilters, function (i, chartFilter) {
        ////When NAV unit is passed the ordinary and special unit has same typecode and different pricetype
        var isNAVUnit = (chartFilter.SpecialUnitPriceType != null || chartFilter.SpecialUnitPriceType != '') && chartFilter.SpecialUnitPriceType != chartFilter.PriceType;
        var fundPerformance = $.map(response.DiscretePerformance, function (val) { if (val.TypeCode == chartFilter.TypeCode && (isNAVUnit && val.FormattedTypeCode.indexOf('~' + chartFilter.PriceType) > 0 || !isNAVUnit)) return val; });
        var specialUnitPerf = $.map(response.DiscretePerformance, function (val) { if (val.TypeCode == chartFilter.SpecialUnitTypeCode && (isNAVUnit && val.FormattedTypeCode.indexOf('~' + chartFilter.SpecialUnitPriceType) > 0 || !isNAVUnit)) return val; });
        var sectorPerformance = $.map(response.DiscretePerformance, function (val) { if (val.TypeCode == chartFilter.SectorClassCode) return val; });
        var benchmarkPerformance = $.map(response.DiscretePerformance, function (val) { if (val.TypeCode == chartFilter.BenchmarkTypeCode) return val; });

        if (response.AutoloadBenchmarkBreakdown) {
            var benchmarkBreakdownPerformances = new Array();
            if (chartFilter.BenchmarkBreakdowns) {
                for (i = 0; i < chartFilter.BenchmarkBreakdowns.length; i++) {
                    benchmarkBreakdownPerformances.push($.map(response.DiscretePerformance,
                        function (val) {
                            if (val.TypeCode ==
                                chartFilter.BenchmarkBreakdowns[i].BenchmarkInstrType +
                                chartFilter.BenchmarkBreakdowns[i].BenchmarkCode) return val;
                        }));
                }
            }
        }

        var fundData = $.map(model.DataList, function (val) { if (val.FundInfo.TypeCode == chartFilter.TypeCode) return val; });
        if (model.RangeCode) {
            fundData.TempData = {};
            fundData.TempData.RangeCode = model.RangeCode;
        }

        $("#PerfBarChartSection_" + sectionId + "_" + fundData[0].FundInfo.CitiCode).empty();
        if (fundPerformance[0] == null || fundPerformance[0]['P12M'] == null) {
            $("#PerfBarChartSection_" + sectionId + "_" + fundData[0].FundInfo.CitiCode).text(modelContents.GetTranslation('No1YrPerformanceChartHistory'));
            $("#PerfBarChartResetButton_" + sectionId + "_" + fundData[0].FundInfo.CitiCode).hide();
            return;
        }

        var fundChartData = null;
        var specialUnitChartData = null;
        var sectorChartData = null;
        var benchmarkChartData = null;
        var benchmarkBreakdownChartDatas = new Array();
        var autoLoadUnit = response.AutoLoadUnit == null ? true : response.AutoLoadUnit;
        if (fundPerformance.length > 0 && autoLoadUnit) {
            //TODO: These harcoding of column names need to be addressed in IHUB-2044
            var fundHistory = $.map(fundPerformance[0], function (value, key) {
                if (value != null) {
                    if (key.indexOf('P12') != -1 || key.indexOf('24') != -1 || key.indexOf('36') != -1 || key.indexOf('48') != -1 || key.indexOf('To60') != -1)
                        return [{ name: key, y: value }];
                }
            });

            fundChartData = {
                name: fundData[0].FundInfo.Name,
                data: fundHistory,
                color: $(this).HighCharAddHashToColor(response.FundColour)
            };
        }

        var highChartsHelper = new HighChartsHelper();
        if (response.AutoLoadSpecialUnit) {
            var isSpecialUnitSameAsOrdinaryUnit = chartFilter.TypeCode == chartFilter.SpecialUnitTypeCode && (chartFilter.PriceType == chartFilter.SpecialUnitPriceType || chartFilter.SpecialUnitPriceType == null || chartFilter.SpecialUnitPriceType == '');
            var specialUnitHistory = null;
            ///Normal unit is not same as special unit
            if (!isSpecialUnitSameAsOrdinaryUnit || !autoLoadUnit) {
                if (specialUnitPerf.length > 0) { //Show special unit
                    specialUnitHistory = highChartsHelper.GetValidInstrumentHistory(fundPerformance, specialUnitPerf);
                }

                var specialUnitName = chartFilter.SpecialUnitName;
                //Use Ordn Unit name 
                var useOrdnUnitName = response.AutoLoadSpecialUnit && !response.AutoLoadUnit;
                if (specialUnitName == null || specialUnitName == '' || useOrdnUnitName) {
                    specialUnitName = fundData[0].FundInfo.Name;
                }

                if (isNAVUnit && !useOrdnUnitName) {
                    specialUnitName = GetNavSpecialUnitName(specialUnitName, chartFilter.SpecialUnitType);
                }

                if (specialUnitHistory != null) {
                    specialUnitChartData = {
                        name: specialUnitName,
                        data: specialUnitHistory,
                        color: $(this).HighCharAddHashToColor(response.SpecialUnitColour)
                    };
                }
            }
        }

        if (sectorPerformance.length > 0) {
            var sectorHistory = highChartsHelper.GetValidInstrumentHistory(fundPerformance, sectorPerformance);

            sectorChartData = {
                name: fundData[0].FundInfo.Sector,
                data: sectorHistory,
                color: $(this).HighCharAddHashToColor(response.SectorColour)
            };
        }

        if (benchmarkPerformance.length > 0) {
            var benchmarkHistory = highChartsHelper.GetValidInstrumentHistory(fundPerformance, benchmarkPerformance);

            benchmarkChartData = {
                name: fundData[0].FundInfo.Benchmark,
                data: benchmarkHistory,
                color: response.AutoloadBenchmarkBreakdown ? (response.BenchmarkBreakdownColours.split(",").length > 0 ? response.BenchmarkBreakdownColours.split(",")[0] : "#000000") : $(this).HighCharAddHashToColor(response.BenchmarkColour)
            };
        }
        if (response.AutoloadBenchmarkBreakdown && benchmarkBreakdownPerformances != undefined) {
            for (i = 0; i < benchmarkBreakdownPerformances.length; i++) {
                var benchmarkBreakdownHistory = highChartsHelper.GetValidInstrumentHistory(fundPerformance, benchmarkBreakdownPerformances[i]);

                benchmarkBreakdownChartDatas.push({
                    name: fundData[0].FundInfo.BenchmarkBreakdowns[i].BenchmarkName,
                    data: benchmarkBreakdownHistory,
                    color: $(this).HighCharAddHashToColor(response.BenchmarkBreakdownColours.split(",").length > i + 1 ? response.BenchmarkBreakdownColours.split(",")[i + 1] : "#000000")
                });
            }
        }


        var dataToPlot = [];
        if (fundChartData != null) {
            dataToPlot.push(fundChartData);
        }

        if (specialUnitChartData != null) {
            dataToPlot.push(specialUnitChartData);
        }

        if (sectorChartData != null) {
            dataToPlot.push(sectorChartData);
        }

        if (benchmarkChartData != null) {
            dataToPlot.push(benchmarkChartData);
        }

        if (response.AutoloadBenchmarkBreakdown && benchmarkBreakdownChartDatas != undefined) {
            for (i = 0; i < benchmarkBreakdownChartDatas.length; i++) {
                dataToPlot.push(benchmarkBreakdownChartDatas[i]);
            }
        }

        var options = GetBarChartSettings(response, fundData, sectionId, toolId, dataToPlot);


        $("#PerfBarChartSection_" + sectionId + "_" + fundData[0].FundInfo.CitiCode).highcharts(options);

        $("#PerfBarChartResetButton_" + sectionId + "_" + fundData[0].FundInfo.CitiCode).on("click", function () {

            //Reseting the visibility based on drill down changes from user.
            var chart = $("#PerfBarChartSection_" + sectionId + "_" + fundData[0].FundInfo.CitiCode).highcharts();
            $.each(chart.series, function (index, s) {
                options.series[index].visible = s.visible;
            });

            $("#PerfBarChartSection_" + sectionId + "_" + fundData[0].FundInfo.CitiCode).highcharts(options);

        });
    });
}

function GetBarChartSettings(response, fundData, sectionId, toolId, dataToPlot) {
    return {
        chart: {
            type: 'column',
            height: response.ChartHeight ? response.ChartHeight : ChartDefaults.Height
        },
        xAxis: {
            categories: response.TimePeriodTranslated,
            labels: {
                style: {
                    fontSize: (response.ChartFontSize ? response.ChartFontSize + 'pt' : ChartDefaults.FontSize)
                }
            }
        },
        yAxis: {
            title: {
                text: ''
            },
            labels: {
                style: {
                    fontSize: (response.ChartFontSize ? response.ChartFontSize + 'pt' : ChartDefaults.FontSize)
                },
                format: '{value:.' + response.NumberOfDecimal + 'f}'
            }
        },
        tooltip: {
            useHTML: true,
            formatter: function () {
                return this.series.name +
                    "<br>" +
                    this.x +
                    " </b> : <b> " +
                    this.y.toFixed(response.NumberOfDecimal);
            }
        },
        title: {
            text: response.ShowAsAtDate == 1 ? modelContents.GetTranslation('AsAt') + ' ' + response.AsAtDate : '',
            align: 'left',
            //x: 70,
            style: {
                fontSize: (response.ChartFontSize ? response.ChartFontSize + 'pt' : ChartDefaults.FontSize)
            }
        },
        subtitle: {
            text: '',
            style: {
                fontSize: (response.ChartFontSize ? response.ChartFontSize + 'pt' : ChartDefaults.FontSize)
            }
        },
        legend: {
            enabled: true,
            itemStyle: {
                fontSize: (response.ChartFontSize ? response.ChartFontSize + 'pt' : ChartDefaults.FontSize)
            }
        },
        credits: {
            enabled: false
        },
        plotOptions: {
            series: {
                borderWidth: 0,
                dataLabels: {
                    enabled: response.ShowDataLabels == 1 ? true : false,
                    formatter: function () {
                        return this.y ? this.y.toFixed(response.NumberOfDecimal ? 2 : response.NumberOfDecimal) : this.y;
                    },
                    style: {
                        fontSize: (response.ChartFontSize ? response.ChartFontSize + 'pt' : ChartDefaults.FontSize)
                    }
                }
            },
            column: {
                cursor: 'pointer',
                point: {
                    events: {
                        click: function (e) {
                            // This can be handled in the drilldown event but our requirements with drilldown need this event implementation
                            SetChart(e, fundData, sectionId, toolId);
                        }
                    }
                }
            }
        },
        series: dataToPlot
    };
}

function SetChart(e, fundData, sectionId, toolId) {
    if (!e.seriesOptions) {
        var chart = $("#PerfBarChartSection_" + sectionId + "_" + fundData[0].FundInfo.CitiCode).highcharts();

        //Collecting the index of series hidden by user by clicking on the legend icon.
        var hiddenSeriesIndexes = [];
        $.each(chart.series, function (index, s) {
            if (!s.visible) {
                hiddenSeriesIndexes.push(index);
            }
        });

        //Request for data list    
        var chartFilters = $.map(fundData, function (v) {
            return {
                Name: fundData[0].FundInfo.Name,
                TypeCode: fundData[0].FundInfo.TypeCode,
                Currency: fundData[0].Price.Currency_UnitLevel,
                BenchmarkCurrencyCode: v.FundInfo.BenchmarkCurrencyCode,
                SectorCurrencyCode: v.FundInfo.SectorCurrencyCode,
                CitiCode: fundData[0].FundInfo.CitiCode,
                SectionId: sectionId,
                SectorClassCode: fundData[0].FundInfo.SectorClassCode,
                BenchmarkTypeCode: fundData[0].FundInfo.BenchmarkTypeCode,
                Sector: fundData[0].FundInfo.Sector,
                Benchmark: fundData[0].FundInfo.Benchmark,
                BenchmarkBreakdowns: v.FundInfo == undefined || v.FundInfo.BenchmarkBreakdowns.length == 0 ? null : v.FundInfo.BenchmarkBreakdowns,
                PriceType: fundData[0].Price.PriceType,
                TimePeriodString: e.point.name,
                SpecialUnitPriceType: fundData[0].FundInfo.DefaultSpecialUnitPriceType,
                SpecialUnitTypeCode: fundData[0].FundInfo.DefaultSpecialUnitTypeCode,
                SpecialUnitName: fundData[0].FundInfo.DefaultSpecialUnitName,
                SpecialUnitType: fundData[0].FundInfo.DefaultSpecialUnitType
            };
        });

        var searchModel = GetSearchModel(toolId, 0);
        if (fundData.TempData) {
            searchModel.RangeCode = fundData.TempData.RangeCode;
        }
        if (!searchModel.RangeCode && $("#RangeId-" + toolId)) {
            searchModel.RangeCode = $("#RangeId-" + toolId).val();
        }

        var chartModel = $.extend(searchModel, { ChartFilters: chartFilters });

        chartModel.PerformanceCurrency = getQueryStringValue("PerformanceCurrency")

        $(this).sendJsonAsString(modelContents.FundDiscretePerformanceUrl, chartModel,
            function (drilldownResponse) {
                ////When NAV unit is passed the ordinary and special unit has same typecode and different pricetype
                var isNAVUnit = (chartFilters[0].SpecialUnitPriceType != null || chartFilters[0].SpecialUnitPriceType != '') && chartFilters[0].SpecialUnitPriceType != chartFilters[0].PriceType;
                var ddfundPerformance = $.map(drilldownResponse.DiscretePerformance, function (val) { if (val.TypeCode == chartFilters[0].TypeCode && (isNAVUnit && val.FormattedTypeCode.indexOf('~' + chartFilters[0].PriceType) > 0 || !isNAVUnit)) return val; });
                var ddSpecialUnitPerformance = $.map(drilldownResponse.DiscretePerformance, function (val) { if (val.TypeCode == chartFilters[0].SpecialUnitTypeCode && (isNAVUnit && val.FormattedTypeCode.indexOf('~' + chartFilters[0].SpecialUnitPriceType) > 0 || !isNAVUnit)) return val; });
                var ddsectorPerformance = $.map(drilldownResponse.DiscretePerformance, function (val) { if (val.TypeCode == chartFilters[0].SectorClassCode) return val; });
                var ddbenchmarkPerformance = $.map(drilldownResponse.DiscretePerformance, function (val) { if (val.TypeCode == chartFilters[0].BenchmarkTypeCode) return val; });
                var ddBenchmarkBreakdownPerformances = new Array();
                if (drilldownResponse.AutoloadBenchmarkBreakdown) {
                    if (chartFilters[0].BenchmarkBreakdowns) {
                        for (i = 0; i < chartFilters[0].BenchmarkBreakdowns.length; i++) {
                            ddBenchmarkBreakdownPerformances.push($.map(drilldownResponse.DiscretePerformance,
                                function (val) {
                                    if (val.TypeCode ==
                                        chartFilters[0].BenchmarkBreakdowns[i].BenchmarkInstrType +
                                        chartFilters[0].BenchmarkBreakdowns[i].BenchmarkCode) return val;
                                }));
                        }
                    }
                }


                var fundDrilldownData = null;
                var splUnitDrilldownData = null;
                var sectorDrilldownData = null;
                var benchmarkDrilldownData = null;
                var benchmarkBreakdownDrilldownData = new Array();


                var autoLoadUnit = drilldownResponse.AutoLoadUnit == null ? true : drilldownResponse.AutoLoadUnit;

                if (ddfundPerformance.length > 0) {
                    var ddfundHistory = $.map(ddfundPerformance[0], function (value, key) {
                        if (value != null && (key.indexOf('1M') != -1 || key.indexOf('To2M') != -1 || key.indexOf('3M') != -1 || key.indexOf('4M') != -1
                            || key.indexOf('5M') != -1 || key.indexOf('6M') != -1 || key.indexOf('7M') != -1 || key.indexOf('8M') != -1
                            || key.indexOf('8M') != -1 || key.indexOf('9M') != -1 || key.indexOf('10M') != -1 || key.indexOf('11M') != -1 || key.indexOf('11To12M') != -1))
                            return [[key, value]];
                    });

                    fundDrilldownData = {
                        name: fundData[0].FundInfo.Name,
                        data: ddfundHistory.reverse(),
                        color: $(this).HighCharAddHashToColor(drilldownResponse.FundColour)
                    };
                }

                if (drilldownResponse.AutoLoadSpecialUnit) {
                    var isSpecialUnitSameAsOrdinaryUnit = chartFilters[0].TypeCode == chartFilters[0].SpecialUnitTypeCode && (chartFilters[0].PriceType == chartFilters[0].SpecialUnitPriceType || chartFilters[0].SpecialUnitPriceType == null || chartFilters[0].SpecialUnitPriceType == '');
                    if ((!isSpecialUnitSameAsOrdinaryUnit || !autoLoadUnit) && ddSpecialUnitPerformance.length > 0) {
                        var ddSplUnitHistory = $.map(ddSpecialUnitPerformance[0], function (value, key) {
                            //TODO: These harcoding of column names need to be addressed in IHUB-2044
                            if (value != null && (key.indexOf('1M') != -1 || key.indexOf('To2M') != -1 || key.indexOf('3M') != -1 || key.indexOf('4M') != -1
                                || key.indexOf('5M') != -1 || key.indexOf('6M') != -1 || key.indexOf('7M') != -1 || key.indexOf('8M') != -1
                                || key.indexOf('8M') != -1 || key.indexOf('9M') != -1 || key.indexOf('10M') != -1 || key.indexOf('11M') != -1 || key.indexOf('11To12M') != -1))
                                return [[key, value]];
                        });

                        var specialUnitName = fundData[0].FundInfo.DefaultSpecialUnitName;
                        var useOrdnUnitName = drilldownResponse.AutoLoadSpecialUnit && !drilldownResponse.AutoLoadUnit;
                        if (specialUnitName == null || specialUnitName == '' || useOrdnUnitName) {
                            specialUnitName = fundData[0].FundInfo.Name;
                        }
                        if (isNAVUnit && !useOrdnUnitName) {
                            specialUnitName = GetNavSpecialUnitName(specialUnitName, fundData[0].FundInfo.DefaultSpecialUnitType);;
                        }

                        splUnitDrilldownData = {
                            name: specialUnitName,
                            data: ddSplUnitHistory.reverse(),
                            color: $(this).HighCharAddHashToColor(drilldownResponse.SpecialUnitColour)
                        };
                    }
                }


                if (ddsectorPerformance.length > 0) {
                    var ddsectorHistory = $.map(ddsectorPerformance[0], function (value, key) {
                        //TODO: These harcoding of column names need to be addressed in IHUB-2044
                        if (value != null && (key.indexOf('1M') != -1 || key.indexOf('To2M') != -1 || key.indexOf('3M') != -1 || key.indexOf('4M') != -1
                            || key.indexOf('5M') != -1 || key.indexOf('6M') != -1 || key.indexOf('7M') != -1 || key.indexOf('8M') != -1
                            || key.indexOf('8M') != -1 || key.indexOf('9M') != -1 || key.indexOf('10M') != -1 || key.indexOf('11M') != -1 || key.indexOf('11To12M') != -1))
                            return [[key, value]];
                    });

                    sectorDrilldownData = {
                        name: fundData[0].FundInfo.Sector,
                        data: ddsectorHistory.reverse(),
                        color: $(this).HighCharAddHashToColor(drilldownResponse.SectorColour)
                    };
                }

                if (ddbenchmarkPerformance.length > 0) {
                    var ddbenchmarkHistory = $.map(ddbenchmarkPerformance[0], function (value, key) {
                        if (value != null && (key.indexOf('1M') != -1 || key.indexOf('To2M') != -1 || key.indexOf('3M') != -1 || key.indexOf('4M') != -1
                            || key.indexOf('5M') != -1 || key.indexOf('6M') != -1 || key.indexOf('7M') != -1 || key.indexOf('8M') != -1
                            || key.indexOf('8M') != -1 || key.indexOf('9M') != -1 || key.indexOf('10M') != -1 || key.indexOf('11M') != -1 || key.indexOf('11To12M') != -1))
                            return [[key, value]];
                    });

                    benchmarkDrilldownData = {
                        name: fundData[0].FundInfo.Benchmark,
                        data: ddbenchmarkHistory.reverse(),
                        color: $(this).HighCharAddHashToColor(drilldownResponse.BenchmarkColour)
                    };
                }

                if (ddBenchmarkBreakdownPerformances.length > 0) {
                    var ddBenchmarkBreakdownHistory = new Array();
                    for (i = 0; i < ddBenchmarkBreakdownPerformances.length; i++) {
                        //var ddBenchmarkBreakdownPerformancesValue = ddBenchmarkBreakdownPerformances[i];
                        ddBenchmarkBreakdownHistory = $.map(ddBenchmarkBreakdownPerformances[i][0], function (value, key) {
                            if (value != null && (key.indexOf('1M') != -1 || key.indexOf('To2M') != -1 || key.indexOf('3M') != -1 || key.indexOf('4M') != -1
                                || key.indexOf('5M') != -1 || key.indexOf('6M') != -1 || key.indexOf('7M') != -1 || key.indexOf('8M') != -1
                                || key.indexOf('8M') != -1 || key.indexOf('9M') != -1 || key.indexOf('10M') != -1 || key.indexOf('11M') != -1 || key.indexOf('11To12M') != -1))
                                return [[key, value]];
                        });

                        benchmarkBreakdownDrilldownData[i] = {
                            name: fundData[0].FundInfo.BenchmarkBreakdowns[0].BenchmarkName,
                            data: ddBenchmarkBreakdownHistory,
                            color: $(this).HighCharAddHashToColor(drilldownResponse.BenchmarkBreakdownColours.split(",").length > i + 1 ? drilldownResponse.BenchmarkBreakdownColours.split(",")[i + 1] : "#000000")
                        };

                    };
                }

                var drilldownCategory = e.point.category;

                if (chart.series.length > 3)
                    chart.series[3].remove(false);
                if (chart.series.length > 2)
                    chart.series[2].remove(false);
                if (chart.series.length > 1)
                    chart.series[1].remove(false);
                if (chart.series.length > 0)
                    chart.series[0].remove(false);

                var categories = drilldownResponse.MonthsTranslated;
                chart.xAxis[0].setCategories(categories, false);
                chart.options.plotOptions.series.dataLabels.enabled = false;
                chart.options.plotOptions.column.point.events.click = null;

                // order of plot is fund, sector and benchmark. If there is no data to plot, key is not shown. Set second key to benchmark
                // when there is no sector to plot.
                if (autoLoadUnit) {
                    chart.addSeries(fundDrilldownData);
                }

                if (splUnitDrilldownData != null) {
                    chart.addSeries(splUnitDrilldownData);
                }

                if (sectorDrilldownData != null && benchmarkDrilldownData != null) {
                    chart.addSeries(sectorDrilldownData);
                    chart.addSeries(benchmarkDrilldownData);
                }
                else if (sectorDrilldownData != null && benchmarkDrilldownData == null) {
                    chart.addSeries(sectorDrilldownData);
                }
                else if (sectorDrilldownData == null && benchmarkDrilldownData != null) {
                    chart.addSeries(benchmarkDrilldownData);
                }

                if (benchmarkBreakdownDrilldownData != null) {
                    for (i = 0; i < benchmarkBreakdownDrilldownData.length; i++) {
                        chart.addSeries(benchmarkBreakdownDrilldownData[i]);

                    }
                }

                chart.setTitle(undefined, { text: drilldownCategory });

                //Reseting the series visibility option.
                $.each(hiddenSeriesIndexes, function (i, value) {
                    chart.series[value].hide();
                });

                chart.redraw();
            }, null, chartFilters.length);
    }
}

