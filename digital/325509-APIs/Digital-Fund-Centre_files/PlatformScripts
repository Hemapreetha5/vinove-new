function InitializeTextSection(obj) {
    $(".ellipsis", $(obj)).each(function () {
        var showChar = $(this).attr("CharacterLimit");

        if (showChar != "") {
            var ellipsestext = "...";
            var lesslink = "fe-readless";
            var morelink = "fe-readmore";

            $(this).shorten({
                "showChars": showChar,
                "ellipsesText": ellipsestext,
                "moreLink": morelink
            });

            $(".fe-readmore", $(this)).on("click", function () {
                $(this).toggleClass(lesslink, !$(this).hasClass(lesslink));
                $(this).parent().prev().toggle("slow");
                $(this).prev().toggle("slow", function () {
                    if ($(this).css('display') == 'inline-block') {
                        $(this).css('display', 'inline');
                    }
                    ToolkitUI.Common.ResizeIFrame();
                });
                return false;
            });
        }
    });
}


