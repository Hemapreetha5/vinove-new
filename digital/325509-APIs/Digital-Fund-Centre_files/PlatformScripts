            hChart.series[seriesId++].setData(specialUnitHistory, false);
        }

        if (sectorHistory) {
            hChart.series[seriesId++].setData(sectorHistory, false);
        }

        if (benchmarkHistory) {
            hChart.series[seriesId++].setData(benchmarkHistory, false);
        }

        if (benchmarkBreakdownHistory.length > 0) {
            for (var i = 0; i < benchmarkBreakdownHistory.length; i++) {
                hChart.series[seriesId++].setData(benchmarkBreakdownHistory[i], false);
            }
        }

        // Allow the chart redraw after a timeout, because this method is called when setExtremes is triggered,..
        // Which also triggers a redraw with wrong values
        setTimeout(function () {
            hChart.redraw();
        },
            100);
    }
}

