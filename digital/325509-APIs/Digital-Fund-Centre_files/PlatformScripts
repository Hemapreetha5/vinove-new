            var portfolioValue = GetTotalPortfolioValue(selectedTabHref);
            if (portfolioValue < 1) {
                var errorMsg = modelContents.GetTranslation("PortfolioValueErrorMessage");
                ShowPScanError(errorMsg);
                return 0;
            }
        }

        weightedUnits = GetPortfolioUnits(selectedTabHref);
        $("#PScanSourceAction").val(pscanSource);
        var title = modelContents.GetTranslation("PScanBenchmarkDialogTitle");
        if (pscanSource == PortfolioTool.PortfolioScanSource.PortfolioScanHtmlSource) {
            if (modelContents.AreAnyPortfolioSettingEnabledForHtml) {

                $('.fe-portfolioSettings-portfoliodetails-html').show();
                $('.fe-portfolioSettings-portfoliodetails-pdf').hide();
                $('.fe-portfolioSettings-selectbenchmark').hide();
                title = modelContents.GetTranslation("PortfolioDetails");

            }
            else {
                $('.fe-portfolioSettings-portfoliodetails-html').hide();
                $('.fe-portfolioSettings-portfoliodetails-pdf').hide();
                $('.fe-portfolioSettings-selectbenchmark').show();
            }

        }
        else if (pscanSource == PortfolioTool.PortfolioScanSource.PortfolioScanPdfSource) {
            if (modelContents.AreAnyPortfolioSettingEnabledForPdf) {

                $('.fe-portfolioSettings-portfoliodetails-html').hide();
                $('.fe-portfolioSettings-portfoliodetails-pdf').show();
                $('.fe-portfolioSettings-selectbenchmark').hide();
                title = modelContents.GetTranslation("PortfolioDetails");
            }
            else {
                $('.fe-portfolioSettings-portfoliodetails-html').hide();
                $('.fe-portfolioSettings-portfoliodetails-pdf').hide();
                $('.fe-portfolioSettings-selectbenchmark').show();
            }
        }
        ShowPortfolioScanBenchmarkContainer(weightedUnits, title);

    };

    startPortfolioScan = function (pscanSource, portfolioId) {



        $("#PScanSourceAction").val(pscanSource);
        var title = modelContents.GetTranslation("PScanBenchmarkDialogTitle")
        if (pscanSource == PortfolioTool.PortfolioScanSource.PortfolioScanHtmlSource) {
            if (modelContents.AreAnyPortfolioSettingEnabledForHtml) {

                $('.fe-portfolioSettings-portfoliodetails-html').show();
                $('.fe-portfolioSettings-portfoliodetails-pdf').hide();
                $('.fe-portfolioSettings-selectbenchmark').hide();
                title = modelContents.GetTranslation("PortfolioDetails")

            }
            else {
                $('.fe-portfolioSettings-portfoliodetails-html').hide();
                $('.fe-portfolioSettings-portfoliodetails-pdf').hide();
                $('.fe-portfolioSettings-selectbenchmark').show();
            }

        }
        else if (pscanSource == PortfolioTool.PortfolioScanSource.PortfolioScanPdfSource) {
            if (modelContents.AreAnyPortfolioSettingEnabledForPdf) {

                $('.fe-portfolioSettings-portfoliodetails-html').hide();
                $('.fe-portfolioSettings-portfoliodetails-pdf').show();
                $('.fe-portfolioSettings-selectbenchmark').hide();
                title = modelContents.GetTranslation("PortfolioDetails")
            }
            else {
                $('.fe-portfolioSettings-portfoliodetails-html').hide();
                $('.fe-portfolioSettings-portfoliodetails-pdf').hide();
                $('.fe-portfolioSettings-selectbenchmark').show();
            }
        }

        var model = $.extend({ ProjectName: modelContents.ProjectName }, { ToolName: modelContents.ToolName }, { LangCode: modelContents.LangCode },
            { RangeCode: modelContents.RangeCode }, { Category: modelContents.Category }, { 'Value1': portfolioId });
        $(this).sendJsonAsString(modelContents.GetPortfolioConstituentDetailsUrl, model,
            function (result) {

                if (result != null) {
                    var constituents = result.portfolioConstituents;
                    var weightedUnits = [];
                    for (var i = 0; i < constituents.length; i++) {
                        var constituent = constituents[i];
                        var unit = new Unit(constituent.CitiCode, constituent.TypeCode, constituent.FirstPriceDate, constituent.SectorClassCode, constituent.Weight);
                        weightedUnits.push(unit);
                    }

                    var benchmarkDialogContext = $('.fe-pscan-benchmarkContainer');
                    resetBenchmarkDialog();
                    $("#chkWeightedSectorAverageContainer", benchmarkDialogContext).val('');

                    if (result.IsWeightedSector == true) {
                        $("#chkWeightedSectorAverageContainer", benchmarkDialogContext).prop('checked', true);
                    }
                    else if (result.BenchmarkTypeCode.substring(0, 1) == "X") {
                        $("#fundSectors", benchmarkDialogContext).val(result.BenchmarkTypeCode);
                    }
                    else if (result.BenchmarkTypeCode.substring(0, 1) == "N") {
                        $("#indices", benchmarkDialogContext).val(result.BenchmarkTypeCode);
                    }
                    ShowPortfolioScanBenchmarkContainer(weightedUnits, title);

                    $('#benchmarkContainer').mfs('refresh');
                }
                else {
                    alert('Error getting portfolio constituents');
                }
            });
    };

    portfolioScanDetails = function (clientName, portfolioName, preparedBy, datePrepared, summaryText, performanceCurrency) {
        this.ClientName = clientName;
        this.PortfolioName = portfolioName;
        this.PreparedBy = preparedBy;
        this.DatePrepared = datePrepared;
        this.SummaryText = summaryText;
        this.PerformanceCurrency = performanceCurrency;
    }

    return {
        SetBenchmarkSettings: setBenchmarkSettings,
        PortfolioScanDetails: portfolioScanDetails,
        StartPortfolioScan: startPortfolioScan
    };
}();

