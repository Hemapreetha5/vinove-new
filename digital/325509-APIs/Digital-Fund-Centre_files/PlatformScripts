    // prefix with 'X' even if sector class code itself is 'X'
    if (sectorClassCode && sectorClassCode.toUpperCase().indexOf("X") == 0 && !sectorClassCode.toUpperCase().indexOf("X:") == 0) {
        this.SectorClassCode = sectorClassCode;
