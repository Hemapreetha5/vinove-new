            function FetchCiticodeDetailsByCiticodesForMultipleWatchlists(model, container, fundInfo, isFirstTime, source, actionLocation) {
                if (typeof model.CodesList !== 'undefined' && model.CodesList.length > 0) {
                    var missingCodes = [];

                    parsedWatchlistData = watchlistData[source] || null; // Fetch the watchlist data from memory

                    if (parsedWatchlistData !== null && parsedWatchlistData !== '') {
                        var watchlistStorageitems = multipleWatchlists.GetCodeListFromWatchlist(source);

                        missingCodes = watchlistStorageitems.filter(function (code) {
                            return !parsedWatchlistData.DataList.some(function (item) {
                                return item.Common.TypeCode === code;
                            });
                        }).map(function (code) {
                            return code.trim();
                        });
                    }

                    if (source === 'sort') {
                        FetchCiticodeDetailsByCiticodes(model, container, fundInfo, isFirstTime, source, actionLocation);
                    }
                    else if (missingCodes.length === 0 && parsedWatchlistData !== null) {
                        OnUnitsReceived(parsedWatchlistData, container, fundInfo, isFirstTime, source);
                    }
                    else {
                        if (missingCodes.length > 0) {
                            model.CodesList = missingCodes;
                        }

                        $(this).sendJsonAsString(modelContents.AzureUrlForCitiCode, model,
                            function (model) {
                                if (model != null && model != '') {
                                    model = JSON.parse(model);
                                    if (model.IsSuccessful) {
                                        $.when(GetFundManagerHistory(model, container, fundInfo, isFirstTime, source), GetHoldingsAndBreakdowns(model, container, fundInfo, isFirstTime, source)).done(function () {
                                            if (source != null && source != undefined && source != '') {
                                                if (parsedWatchlistData != null && parsedWatchlistData != undefined && parsedWatchlistData.DataList != null) {
                                                    model.DataList = parsedWatchlistData.DataList.concat(model.DataList);
                                                } else {
                                                    model.DataList = model.DataList;
                                                }

                                                parsedWatchlistData = model;
                                                watchlistData[source] = model;
                                                OnUnitsReceived(model, container, fundInfo, isFirstTime, source);
                                            }
                                        });
                                    }
                                } else {
                                    ShowNoResult(container, isFirstTime);
                                }
                            },
                            function (req, status, error) {
                                GetFundMasterDataRequest(actionLocation,
                                    model,
                                    container,
                                    fundInfo,
                                    isFirstTime,
                                    source);
                            }
                        );
                    }
                }
                else {
                    UpdateFundCentreViewForPortfolioWithMultipleWatchlists();
                    HideFundTableAndShowNoResult(container.parent());
                    HideFundListsAndShowNoResult(container);
                    $('html').hideLoading();
                }
            }

            function OnUnitsReceived(model, container, fundInfo, isFirstTime, source, renderOnly, dropdownCurrencyChange) {

                if (!isMultipleWatchlistEnabled) {

                    if (model.ToolId == 6 || model.ToolId == 7) {
                        AddToBasketCache(model, fundInfo);
                    }

                    // Fix for Keyboardaccessibility
                    if ($(source).is("input[type=checkbox]") || $(source).is("input[type=radio]")) {
                        if (source.parentElement.classList.contains('checked')) {
                            source.checked = true;
                        }
                        else
                            source.checked = false;
                    }

                    OnDataReceived(model, container, fundInfo, isFirstTime, source, renderOnly, dropdownCurrencyChange);

                } else {

                    var escapedSource = $.escapeSelector(source);

                    if ($(escapedSource).is("input[type=checkbox]") || $(escapedSource).is("input[type=radio]")) {
                        if (escapedSource.parentElement.classList.contains('checked')) {
                            escapedSource.checked = true;
                        }
                        else
                            escapedSource.checked = false;
                    }

                    OnDataReceived(model, container, fundInfo, isFirstTime, escapedSource, renderOnly, dropdownCurrencyChange);
                }
            }

            function CheckCache(model) {
                var codeArray = model.CodesList;
                var isFound = 0;
                var matchedFunds = [];
                var basketFunds = GetInternalState($('#AddedFunds_List')) != undefined && GetInternalState($('#AddedFunds_List')).CachedModel != undefined && GetInternalState($('#AddedFunds_List')).CachedModel.DataList != undefined ? GetInternalState($('#AddedFunds_List')).CachedModel.DataList : null;
                var basketState;

                codeArray = jQuery.grep(codeArray, function (value) {
                    return value != undefined;
                });

                if (GetInternalState($("#tab-fundCentre")).CachedModel != null) {
                    $(GetInternalState($("#tab-fundCentre")).CachedModel.DataList).each(function (index, element) {
                        codeArray = jQuery.grep(codeArray, function (value) {
                            if (value == element.FundInfo.TypeCode) {
                                matchedFunds.push(element);
                            }
                            return value != element.FundInfo.TypeCode;
                        });

                        if (codeArray.length <= 0) {
                            isFound = 1;
                            return false;
                        }
                    });
                }

                var fundsToBasket = $.extend(true, [], matchedFunds);

                if (isFound == 0 && basketFunds != null) {
                    $(basketFunds).each(function (index, element) {
                        codeArray = jQuery.grep(codeArray, function (value) {
                            if (value == element.FundInfo.TypeCode) {
                                matchedFunds.push(element);
                            }
                            return value != element.FundInfo.TypeCode;
                        });

                        if (codeArray.length <= 0) {
                            isFound = 1;
                            return false;
                        }
                    });
                }


                if (fundsToBasket.length > 0) {
                    if (basketFunds == null) {
