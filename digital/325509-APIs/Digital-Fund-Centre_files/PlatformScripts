        tableElement.find('.holding-table-row').each(function (index, rowElem) {
            var jqRowElem = $(rowElem);
            var elemWeight = jqRowElem.find(".holdings-instrument-weightage");
            var parsedValue = ConvertToFloat(elemWeight.val().replace(/[^0-9\.]/g, ""), 0);
            if (parsedValue < 0) {
                parsedValue = 0;
            }

            var assetClass = jqRowElem.attr("data-assetClassCode");
            var currentInstrumentName = jqRowElem.find(".holding-instrument-name").text();
            var isAlreadyAvailable = false;
            for (var i in allocationJson) {
                if (allocationJson.hasOwnProperty(i)) {
                    if (allocationJson[i].assetClass == assetClass) {
                        allocationJson[i].Weight = allocationJson[i].Weight + parsedValue;
                        allocationJson[i].breakdown.push({
                            name: currentInstrumentName,
                            weight: parsedValue
                        });
                        isAlreadyAvailable = true;
                        break;
                    }
                }
            }

            if (!isAlreadyAvailable) {
                var item = {};
                item["assetClass"] = assetClass;
                item["Weight"] = parsedValue;
                item["breakdown"] = [{
                    name: currentInstrumentName,
                    weight: parsedValue
                }];
                allocationJson.push(item);
            }
        });

        renderAllocationCharts(allocationJson);
    }

    function renderAllocationCharts(allocationJson) {
        var data = [];
        var targetData = [];

        allocationJson = _.sortByOrder(allocationJson, ['Weight', 'assetClass'], [false, true]);
        var targetAllocations = masterContainer.targetAllocationContainer.Get();

        for (var i = 0; i < allocationJson.length; i++) {
            var assetClassCode = allocationJson[i].assetClass;
            var assetClassCodeName = assetClassDictionary[assetClassCode];
            data.push({
                name: assetClassCodeName,
                y: allocationJson[i].Weight,
                code: assetClassCode,
                breakdown: allocationJson[i].breakdown
            });

            var matchingTarget = _.find(targetAllocations, function (o) {
                return o.Code === assetClassCode;
            });

            if (matchingTarget) {
                targetData.push({
                    name: assetClassCodeName,
                    y: matchingTarget.Value,
                    code: assetClassCode
                });
            }
        }

        renderAllocationPieChart(data);
        if (isAllocationBarchartEnabled) renderAllocationBarChart(data, targetData);
    }

