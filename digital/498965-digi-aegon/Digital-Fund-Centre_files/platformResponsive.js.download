$(function () {
    if (modelContents.EnableScrollTabs) {
        // If scroll tabs is enabled, skip adaptive menu tabs behaviour changes
        return;
    }
    generic();
    setResize();
    tabnavtoggle();
    menuTabsList();

    $(window).resize(function () {
        setResize();
    });
});

function generic()
{
    ////$(".fe-tabs-container-Shortlist .fe-tabs-responsive-icon").hide();
