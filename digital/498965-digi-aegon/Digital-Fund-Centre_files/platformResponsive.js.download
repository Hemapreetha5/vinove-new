    });

    var modelPortfoliodefaultContant = $(".fe-tabs-container-ModelPortfolio").children(".fe-tabs-tab-ModelPortfolio li a:first").text();
    $(".fe-tabs-container-ModelPortfolio .fe-tabs-responsive-title").text(modelPortfoliodefaultContant);
    $(".fe-tabs-container-ModelPortfolio .fe-tabs-tab-ModelPortfolio li a, this").on("click",function () {
        var ModelPortfolioselectContent = $(this).text();
        $('.fe-tabs-container-ModelPortfolio .fe-tabs-responsive-title').text(ModelPortfolioselectContent);
    });

    var mPConstituentsdefaultContant = $(".fe-tabs-container-MPConstituents").children(".fe-tabs-tab-MPConstituents li a:first").text();
    $(".fe-tabs-container-MPConstituents .fe-tabs-responsive-title").text(mPConstituentsdefaultContant);
    $(".fe-tabs-container-MPConstituents .fe-tabs-tab-MPConstituents li a, this").on("click",function () {
        var mPConstituentsselectContent = $(this).text();
        $('.fe-tabs-container-MPConstituents .fe-tabs-responsive-title').text(mPConstituentsselectContent);
    });
    
    var savePortfoliodefaultContant = $(".fe-tabs-container-Saved").children(".fe-tabs-tab-Saved li a:first").text();
    $(".fe-tabs-container-Saved .fe-tabs-responsive-title").text(savePortfoliodefaultContant);
    $(".fe-tabs-container-Saved .fe-tabs-tab-Saved li a, this").on("click",function () {
        var SavePortfolioselectContent = $(this).text();
        $('.fe-tabs-container-Saved .fe-tabs-responsive-title').text(SavePortfolioselectContent);
    });

    var savePortfoliodefaultContant = $(".fe-tabs-container-Saved").children(".fe-tabs-tab-Saved li a:first").text();
    $(".fe-tabs-container-Saved .fe-tabs-responsive-title").text(savePortfoliodefaultContant);
    $(".fe-tabs-container-Saved .fe-tabs-tab-Saved li a, this").on("click",function () {
        var SavePortfolioselectContent = $(this).text();
        $('.fe-tabs-container-Saved .fe-tabs-responsive-title').text(SavePortfolioselectContent);
    });
    var feuniverseseletordefaultContant = $(".fe-tabs-autoLoad").children(".fe-tabs li a:first").text();
    $(".fe-tabs-autoLoad .fe-tabs-responsive-title").text(feuniverseseletordefaultContant);
    $(".fe-tabs-autoLoad .fe-tabs li a, this").on("click",function () {
        var feuniverseseletorContent = $(this).text();
        $('.fe-tabs-autoLoad .fe-tabs-responsive-title').text(feuniverseseletorContent);
