}
function setResize() {
    if ($(window).width() <= 625) {
        $('.fe-tabs-responsive-icon').show();
        $('.fe-menuTabs-list').hide();
        $('.fe-tabs').hide();
        $(".fe-tabs li a, this").on("click",function () {
            $(this).parents(".fe-tabs").hide();
        });
        $(".fe-menuTabs-list li a, this").on("click",function (e) {
            $(this).parents(".fe-menuTabs-list").hide();
        });

    }
    if ($(window).width() >= 626) {
        $('.fe-menuTabs-list').show();
        $('.fe-tabs-responsive-icon').hide();
        $('.fe-tabs').show();
        $(".fe-tabs li a, this").on("click",function (e) {
            $(this).parents(".fe-tabs").show();
        });
        $(".fe-menuTabs-list li a, this").on("click",function (e) {
            $(this).parents(".fe-menuTabs-list").show();
        });
    }
}
function menuTabsList() {
    $('.fe-menuTabs-list').css('display', 'none');
    $('.menuTabsDropdownArrow').each(function () {
        $(this).on("click",function () {
            $('.fe-tabs').css('display', 'none');
            var tabnavpanel = $('.fe-menuTabs-list');
            var tabnavisOpen = tabnavpanel.is(':visible');
            tabnavpanel[tabnavisOpen ? 'slideUp' : 'slideDown']('2000');
            if (tabnavisOpen) {
            }
        });
    });
}
function tabnavtoggle()
{
    $('.fe-tabs').css('display', 'none');
    $('.fe-tabs-responsive-icon').each(function () {
        $(this).on("click",function () {
            var tabnavpanel = $('.fe-tabs');
            var tabnavisOpen = tabnavpanel.is(':visible');
            tabnavpanel[tabnavisOpen ? 'slideUp' : 'slideDown']('2000');
        });
    });
}


function PscanTabnavtoggle() {
    $(".fe-mastertabs-portfolioScanMasterTab .fe-tabs-responsive-title").text($(".fe-mastertabs-portfolioScanMasterTab li a:first").text());

    $(".fe-mastertabs-portfolioScanMasterTab .fe-tabs li a").on("click",function () {
        $('.fe-mastertabs-portfolioScanMasterTab .fe-tabs-responsive-title').text($(this).text());
    });
    
    $(".menuTabsDropdown").text($(".fe-topmenu .fe-menuTabs-list li a.selected").text());
    $('.fe-mastertabs-portfolioScanMasterTab .fe-tabs').css('display', 'none');
    $('.fe-mastertabs-portfolioScanMasterTab .fe-tabs-responsive-icon').each(function () {
        $(this).on("click",function () {
            var tabnavpanel = $('.fe-mastertabs-portfolioScanMasterTab .fe-tabs');
            var tabnavisOpen = tabnavpanel.is(':visible');
            tabnavpanel[tabnavisOpen ? 'slideUp' : 'slideDown']('2000');
        });
    });
    $(".fe-mastertabs-portfolioScanMasterTab .fe-tabs li a, this").on("click",function (e) {
        $(this).parents(".fe-tabs").hide();
    });
}
