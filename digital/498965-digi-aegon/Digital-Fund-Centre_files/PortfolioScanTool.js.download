
var PortfolioScanTool = PortfolioScanTool || {}
var maxFileSize = 46080; ////In bytes
var Setting = {};
var selectedConfigCategoryId = -1;  //// Set to correct configCategoryId only when it is necessary to save a commentary.
var ignoreSaveCommentaryEvent = false;
var isFileReaderSupported = window.FileReader != null;
var isAjaxUploadSupported = window.FormData != null; //IE (9 and below) browser not support Ajax file upload
var isPScanFirstTab = true;
////IE8 and below does not support console 
if (!window.console) {
    window.console = { log: function () { /*Do nothing*/ } };
}

GetSettingIds = function () {
    $.ajaxSetup({ cache: true });
    $.ajax({
        async: false,
        type: 'GET',
        contentType: 'application/json; charset=utf-8',
        url: modelContents.GetClientConfigUrl,
        success: function (result) {
            if (result) {
                $.each(result, function (key, value) {
                    Setting[key] = value;
                });
            } else {
                console.log('Error. Cannot load config');
            }
        }
    });
};

function OnGetPortfolioCompositionModelComplete(dataContainer, model) {

    ////Which means the response is a string from Azure service
    if (model.IsSuccessful == null) {
        model = JSON.parse(model.GetPortfolioCompositionResult);
    }

    // This is the old, where the view is send to client and rendered. Now the viewModel is passed and rendered.
    if (model.view != null) {
        dataContainer.html(model.view);
    }

    if (model.viewModel != null) {
        dataContainer.html(''); /// Remove loader 
        $('#template-PortfolioCompositionSummary').tmpl(model.viewModel).appendTo(dataContainer);
        if (model.viewModel.PortfolioScanDetails != null && (model.viewModel.PortfolioScanDetails.SummaryText == null ||
            model.viewModel.PortfolioScanDetails.SummaryText == '')) {
            $('div.fe-pscan-summarytext', dataContainer).remove();
            $('#fe-pscan-summarytext-break', dataContainer).remove();
        }
    }

    var html = $('.fe-portfoliocomposition-container', dataContainer);
    if (html.find("#fe-portfolioComposition-tableBody tr.total").length > 0) {
        $("#template-PortfolioComposition_10_41").tmpl(model.result).insertBefore(html.find("#fe-portfolioComposition-tableBody tr.total"));
    }
    else {
        $("#template-PortfolioComposition_10_41").tmpl(model.result).appendTo(html.find("#fe-portfolioComposition-tableBody"));
    }

    if (model != null && model.result != null) {
        var ongoingChargeTotal = 0.00, yieldTotal = 0.00, originalValueTotal = 0.00, latestValueTotal = 0.00;

        $(model.result).each(function() {
            if (this.PortfolioComposition != null && this.PortfolioComposition.OngoingCharge != null) {
                var latestPercentageForOngoing = this.PortfolioComposition.LatestPercentageWeight / 100;
                latestPercentageForOngoing = this.PortfolioComposition.OngoingCharge * latestPercentageForOngoing;
                ongoingChargeTotal += latestPercentageForOngoing;
            }
            if (this.PortfolioComposition != null && this.PortfolioComposition.Yield != null) {
                var latestPercentageForYield = this.PortfolioComposition.LatestPercentageWeight / 100;
                latestPercentageForYield = this.PortfolioComposition.Yield * latestPercentageForYield;
                yieldTotal += latestPercentageForYield;
            }

            if (this.PortfolioComposition != null && this.PortfolioComposition.OriginalValue != null) {
                var originalValue = this.PortfolioComposition.OriginalValue.replace(model.viewModel.Currency, "");
                originalValueTotal += ConvertToFloat(originalValue.replace(/[^0-9\.]/g, ""), 0);
            }

            if (this.PortfolioComposition != null && this.PortfolioComposition.LatestValue != null) {
                var latestValue = this.PortfolioComposition.LatestValue.replace(model.viewModel.Currency, "");
                latestValueTotal += ConvertToFloat(latestValue.replace(/[^0-9\.]/g, ""), 0);
            }
        });
        ongoingChargeTotal = FormatDecimal(ongoingChargeTotal, null, '2', '.') + '%';
        yieldTotal = FormatDecimal(yieldTotal, null, '2', '.') + '%';
        originalValueTotal = originalValueTotal.toLocaleString().indexOf('.') === -1
            ? originalValueTotal.toLocaleString() + '.00'
            : originalValueTotal.toLocaleString();
        latestValueTotal = latestValueTotal.toLocaleString().indexOf('.') === -1
            ? latestValueTotal.toLocaleString() + '.00'
            : latestValueTotal.toLocaleString();

        $('#portfolioComposition-OngoingChargeTotal').html(ongoingChargeTotal);
        $('#portfolioComposition-yieldTotal').html(yieldTotal);

        $('#portfolioComposition-OriginalValueTotal').html(model.viewModel.Currency + originalValueTotal);
        $('#portfolioComposition-LatestValueTotal').html(model.viewModel.Currency + latestValueTotal);
    }

    $('.fe-datatable', dataContainer).StyleTableRows();

    SpanDivKeypress();

    applyResponsiveCascadingRow(dataContainer, dataContainer.find('.fe-datatable'));
}

