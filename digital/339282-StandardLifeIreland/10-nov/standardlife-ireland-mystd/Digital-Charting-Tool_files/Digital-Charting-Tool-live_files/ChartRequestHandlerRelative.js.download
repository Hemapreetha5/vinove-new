    this.PreviousInstruments = null;
    this.SummaryWidth = null;
    this.SummaryHeight = null;
    this.SummaryLeftPercentage = null;
    this.SummaryRightPercentage = null;
    this.DateFormat = null;

    this.DetailWidth = null;
