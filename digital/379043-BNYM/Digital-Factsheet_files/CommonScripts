        var desktopViewTarget = parentTr.find(dropdownMenu);

        //Remove old active parents
        $tbody.find('tr.active.parent').not(parentTr).removeClass('active');

        var prevDesktopActive = $tbody.find('tr ' + dropdownMenu).not(desktopViewTarget);
        timedAddRemoveClass(prevDesktopActive, 'cascade-hide', true, 0);

