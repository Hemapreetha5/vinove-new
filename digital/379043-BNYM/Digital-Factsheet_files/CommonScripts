    /**
     * Enhances the original table HTML with the more buttons
     * dropdown and collapsible secttion contents
     */
    var _createCascadingElements = function () {
        var groupName = '';

        $moreBtnTh = $header.find('.' + moreBtnHeaderClassName);
        if ($moreBtnTh.length === 0) {
            $moreBtnTh = $('<th role="presentation" class="' + moreBtnHeaderClassName + ' cascade-hide"></th>');
            $moreBtnTh.append('<span aria-visible="hidden" class="cascade-hide">More Information</span>');
            $header.append($moreBtnTh);
        }

        $tbody.find('tr').each(function (trIdx, trObj) {
            var $trObj = $(trObj);
            var hasCascadeMenuWrapper = $trObj.find('td.cascade-menu-wrapper');
            if (hasCascadeMenuWrapper.length == 0) {
                var createdLists = _createListForTableRow($trObj, groupName);

                var infoList = createdLists[0];

                // Add column at last with a button that toggles dropdown menu(desktop)
                // or collapsible section(mobile)
                $trObj.append(moreButtonTdHTML);

                $trObj.find(moreButtonSelector).button();

                // For mobile view
                var columnCount = colSettings.length;
                var childRow = $(childRowTr);
                var childColumn = $('<td colspan="' + (columnCount + 1) + '"></td>');

                var wrappedList = $('<div class="cascade-childrow-wrapper"/>');
                var wrappedListCnt = $('<div class="cascade-childrow-cnt cascade-common-theme"/>');
                wrappedListCnt.append(infoList);
                wrappedList.append(wrappedListCnt);

                if (createdLists[1].children().length > 0) {
                    wrappedListCnt.append(createdLists[1]);
                }

                childColumn.append(wrappedList);

                childRow.append(childColumn);

                // For desktop view
                var ddMenu = $(dropdownMenuHTML);
                var ddMenuCnt = $('<div class="cascade-menu-cnt cascade-common-theme" />');
                ddMenuCnt.append(infoList.clone(true, true));
                ddMenu.append(ddMenuCnt);

                if (createdLists[1].children().length > 0) {
                    ddMenuCnt.append(createdLists[1].clone(true, true));
                }

                ddMenu.appendTo($trObj.find('td:last'));

                $trObj.find(moreButtonSelector).off('click' + evtNamespace)
                    .on('click' + evtNamespace, function (e) {
                        e.stopPropagation(); // Stop event from bubbling up to parent
                        _moreClickHandler(e);
                    });

                if (opts.enableCascade) {
                    // causes redraw - so do it after completing all DOM manipulations
                    $trObj.after(childRow);
                }
                $trObj.addClass('parent');
            }
        });
    }

    var _refreshTableTimer = 0;
    /**
     * Prevents duplicate triggers that can happen immediately
     */
    var _debouncedRefreshTableColumns = function () {
        _refreshTableTimer && clearTimeout(_refreshTableTimer);
        _refreshTableTimer = setTimeout(function () {
            _refreshTableColumns();
        }, 0);
    }

    var _init = function () {
        _readTableConfigurations();

        // Don't do anything if cascade row feature is false, 
        // and ribbon data attribute is not found in table header
        var isAnyItemConfiguredInDropdown = false;
        $.each(colSettings, function (idx, obj) {
            if (obj.fixedRibbons) {
                isAnyItemConfiguredInDropdown = true;
                return;
            }
        });

        if (!(opts.enableCascade || isAnyItemConfiguredInDropdown))
            return;

        _createCascadingElements();
        _initDropdownOnlyItems(isAnyItemConfiguredInDropdown);

        if (opts.enableCascade) {
            // Delay so that, If there is a delay with table rendering by browser - 
            // we can reliably calculate the column widths when it appears.
            opts.debug && _debug('> Init : Refresh table triggered for ' + parent.attr('id'));
            _debouncedRefreshTableColumns();
        }
        _bindGlobalEvents();
    }

    // Finally init show hide based on current view
    _init();
}

