$.fn.AttachObjectAsUrlQueryString = function (url, object, prependKey) {
    var queryStringValue = '';

    $.map(object, function (value, key) {
        if (value != null && key != null && key != 'undefined') {
            if ($.isPlainObject(value)) {
                //if isemptyobject should be inside because its an object not a regular type
                if (!$.isEmptyObject(value)) {
                    var tempPrependKey = prependKey != null ? prependKey + '.' + key : key;
                    queryStringValue += $(this).AttachObjectAsUrlQueryString(null, value, tempPrependKey) + '&';
                }
            } else {
                queryStringValue += encodeURIComponent(prependKey != null ? prependKey + '.' + key : key);
                queryStringValue += '=' + encodeURIComponent(value) + '&';
            }
        }
    });

    queryStringValue = queryStringValue.substring(0, queryStringValue.length - 1);

    if (url == null) {
        return queryStringValue;
    } else {
        if (url.indexOf('?') > 0) {
            return url + '&' + queryStringValue;
        } else {
            return url + '?' + queryStringValue;
        }
    }
};

