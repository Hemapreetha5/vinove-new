// Function to expand a row and add its sub-rows
function expandRow(cachedDataList, newDataListToAppend, insertAfterCitiCode) {
    const rowIndex = cachedDataList.findIndex(i => i.Common.CitiCode == insertAfterCitiCode);
    if (rowIndex !== -1) {
        // Splice sub-rows into the data array
        for (let i = 1; i <= newDataListToAppend.length; i++) {
            cachedDataList.splice(rowIndex + i, 0, newDataListToAppend[i - 1]);
        }
    }
}


