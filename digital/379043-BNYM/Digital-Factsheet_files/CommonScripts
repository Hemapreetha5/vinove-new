//Test the current browser can create and read cookie
function HasCookieAccess() {
    if (isSafariCookieDebugMode)
        return false;

    //Create a new cookie "safariCookie"
    createCookie("safariCookie", 1, 30);

    return HasSafariCookie();
}

function HasSafariCookie() {
    //Read the cookie value of "safariCookie" to validate browser has cookie access
    var nameEQ = "safariCookie=";
    var ca = document.cookie.split(';');
    for (var i = 0; i < ca.length; i++) {
        var c = ca[i];
        while (c.charAt(0) == ' ') c = c.substring(1, c.length);
        if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length) == 1;
    }
}

function GetCookieStorageAccess() {
    $("#fe-helptext-span-1-cookie-message").hide();
    if (!HasCookieAccess()) {
        if (SupportsStorageAccessAPI()) {
                return document.hasStorageAccess().then(function(hasAccess) {
                    storageAccessGranted = hasAccess && !isSafariCookieDebugMode;
                    return hasAccess;
                });
        }
        else {
            console.log("This browser does not support Storage Access API");
            storageAccessGranted = true;
            return null;
        }
    }
    else {
        storageAccessGranted = true;
    }
}

function SupportsStorageAccessAPI() {
    if (typeof document.hasStorageAccess === 'function'
        && typeof document.requestStorageAccess === 'function') {
        return true;
    }
    else {
        return false;
    }
}

