function HandlePlaceholder(input) {
    // If you modify anything here, please check the GetModel function in default.js.
    if (browser.msie || typeof (input[0].placeholder == "undefined")) {
        var placeholder = input.attr("placeholder");
        if (placeholder && placeholder.length > 0) {
            input.val(placeholder);
            input.attr("oldColour", input.css("color"));
            input.css("color", "#c0c0c0");

            input.on("focus", function () {
                $(this).css("color", $(this).attr("oldColour"));
                if ($(this).val() === placeholder) {
                    $(this).val("");
                }
            });

            input.on("blur", function () {
                if ($(this).val() === "") {
                    $(this).css("color", "#c0c0c0");
                    $(this).val(placeholder);
                }
            });
        }
    }
}

