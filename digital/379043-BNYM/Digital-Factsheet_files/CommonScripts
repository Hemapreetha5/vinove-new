    $.ajax({
        url: actionUrl,
        type: type,
        data: model,
        cache: type == $.ajaxTypes.get ? true : false,
        datatype: "json",
        contentType: "application/json; charset=utf-8",
        complete: $.OnAjaxComplete,
        success: function (data) {
            datarequested = data;
        },
        error: OnAjaxError,
        async: false
    });

    return datarequested;
}

