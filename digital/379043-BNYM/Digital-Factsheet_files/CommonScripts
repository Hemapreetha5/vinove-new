function getLocation(href) {
    var parseRegex = /^(https?\:)*\/\/(([^:\/?#]*)(?:\:([0-9]+))?)([\/]{0,1}[^?#]*)(\?[^#]*|)(#.*|)$/;
    var match = href.match(parseRegex);

    // Is it relative url ?
    if (!match) {
        href = location.protocol + '//' + location.host + (href.match(/^[\/]/) ? '' : '/') + href;
        match = href.match(parseRegex);
    }

    return match &&
    {
        href: href,
        protocol: match[1],
        host: match[2],
        hostname: match[3],
        port: match[4],
        pathname: match[5],
        search: match[6],
        hash: match[7]
    };
}

