// A Global variable that keeps the version number of the last/latest/recent request made for a tool (tool id - 6, 7), 
// so we can abort/ignore a unwanted or intermediate or repeated response from the AJAX calls
var latestRequestVersion = {};
latestRequestVersion[getToolIdVarName(ToolIds.Portfolio)] = 0;
latestRequestVersion[getToolIdVarName(ToolIds.Shortlist)] = 0;

$.fn.GetToolIdbyToolControl = function () {
    var toolControlName = $(this).attr("id");
    //Default Control Id
    var controlToolId = ToolIds.FundCentreId;
    $.each(ToolIdMaps, function (key, value) {
        if (value == "#" + toolControlName)
            controlToolId = key;
    });

    return controlToolId;
}

$.fn.shorten = function (settings) {
    return this.each(function () {
        var $this = $(this);

        var content = $this.html();

        ////Check if the number of characters is greater than the character limit
        if (content.length > settings.showChars) {
            //// Get the character limit characters and the remining characters
            var shortenedText = content.substr(0, settings.showChars);
            var hiddenText = content.substr(settings.showChars, content.length - settings.showChars);
            //// Show the characters within the limit and hide the remaining characters
            var html = shortenedText + '<span class="moreellipses">' + settings.ellipsesText + ' </span><span class="fe-readmorecontent"><span>' + hiddenText + '</span> <a href="javascript:void(0)" role="button" title="More Links" class="' + settings.moreLink + '"><img src="/Assets/images/transparent-1x1.png" role="presentation" alt="Shorten" /></a></span>';
            var sanitizedHtml = DOMPurify.sanitize(html);
            $this.html(sanitizedHtml);
            $(".fe-readmorecontent span").hide();
        }
    });

};

$.fn.HighCharAddHashToColor = function (colour) {
    if (colour instanceof Array) {
        for (var i = 0; i < colour.length; i++) {
            colour[i] = colour[i].indexOf('#') < 0 ? '#' + colour[i] : colour[i];
        }
        return color;
    } else {
        return colour.indexOf('#') < 0 ? '#' + colour : colour;
    }
};

$.fn.AttachObjectAsUrlQueryString = function (url, object, prependKey) {
    var queryStringValue = '';

    $.map(object, function (value, key) {
        if (value != null && key != null && key != 'undefined') {
            if ($.isPlainObject(value)) {
                //if isemptyobject should be inside because its an object not a regular type
                if (!$.isEmptyObject(value)) {
                    var tempPrependKey = prependKey != null ? prependKey + '.' + key : key;
                    queryStringValue += $(this).AttachObjectAsUrlQueryString(null, value, tempPrependKey) + '&';
                }
            } else {
                queryStringValue += encodeURIComponent(prependKey != null ? prependKey + '.' + key : key);
                queryStringValue += '=' + encodeURIComponent(value) + '&';
            }
        }
    });

    queryStringValue = queryStringValue.substring(0, queryStringValue.length - 1);

    if (url == null) {
        return queryStringValue;
    } else {
        if (url.indexOf('?') > 0) {
            return url + '&' + queryStringValue;
        } else {
            return url + '?' + queryStringValue;
        }
    }
};

// Returns the total number of funds available following a call to the search service.
// Works for either Fund Centre or Fund Centre AM depending on the value of the container provided.
function getTotalFunds(fundCentreContainer) {
    var totalFundsAvailable = 0;
    if (typeof fundCentreContainer === "undefined" || !fundCentreContainer || fundCentreContainer.length == 0) {
        return totalFundsAvailable;
    }

    var paginator = fundCentreContainer.find(".paginator");  // Find the selector used to store paging state.
    if (paginator.length > 0) {
        totalFundsAvailable = paginator.data('totalRows');
        if (typeof totalFundsAvailable === "undefined") {
            totalFundsAvailable = 0;
        }
    }

    return totalFundsAvailable;
}

GetNavSpecialUnitName = function (name, splUnitType) {
    splUnitType = splUnitType.toLowerCase();
    name += (splUnitType == 'investment trust nav' || splUnitType == 'nav' ? ' NAV' : (splUnitType == 'close of market nav' || splUnitType == 'cnav' ? ' CNAV' : ''));
    return name;
}

getQueryStringValue = function (key) {
    return unescape(window.location.search.replace(new RegExp("^(?:.*[&\\?]" + escape(key).replace(/[\.\+\*]/g, "\\$&") + "(?:\\=([^&]*))?)?.*$", "i"), "$1"));
};


function MakeCloseButtonWorking(dialog) {
    if (dialog.find('.ui-icon-closethick').is(':visible')) {
        var iconpos = dialog.find(".ui-icon-closethick").offset();
        var buttonpos = dialog.find(".ui-dialog-titlebar-close").offset();

        if (((buttonpos.left - iconpos.left) > 10 && (buttonpos.top - iconpos.top) > 25)) {

            dialog.find('.ui-icon-closethick').addClass('ui-icon-closethick-cornor');//.removeClass('ui-icon-closethick')
            dialog.find('.ui-icon-closethick').parent('.ui-dialog-titlebar-close').addClass('ui-dialog-titlebar-close-cornor');//.removeClass('ui-dialog-titlebar-close')
            if ((dialog.find('.ui-icon-closethick').css('background-image').indexOf('swiss_privilege/fe_img/ui-icons_888888_256x240.png') > -1 ||
                dialog.find('.ui-icon-closethick').css('background-image').indexOf('swiss_privilege/images/ui-icons_000000_256x240.png') > -1)
                && dialog.find('.ui-icon-closethick').hasClass('ui-icon')) {
                dialog.find('.ui-icon-closethick').removeClass('ui-icon');
            }
        }
        else if ((buttonpos.left - iconpos.left) > 25) {
            dialog.find(".ui-dialog-titlebar-close").width(dialog.find(".ui-icon-closethick").width());
        }
        else if ($(".ui-dialog-titlebar-close > .ui-button-text").is(':visible')
            && $('.ui-dialog-titlebar-close > .ui-icon-closethick').css('background-image').indexOf('fe_img/cancel.png') > -1
            && $('.ui-dialog-titlebar-close > .ui-button-text').css('background-image').indexOf('standardlife-ireland/fe_img/cancel.png') > -1) {
            $(".ui-dialog-titlebar-close > .ui-button-text").hide();
            $(".ui-dialog-titlebar-close").removeClass("ui-icon-closethick-duplicate").addClass("ui-icon-closethick-duplicate");
        }
    }
}

function RemoveAddedClassOnClose(dialog) {
    if (dialog.find('.ui-icon-closethick').is(':visible')) {
        dialog.find('.ui-icon-closethick').removeClass('ui-icon-closethick-cornor');
        dialog.find('.ui-icon-closethick').parent('.ui-dialog-titlebar-close').removeClass('ui-dialog-titlebar-close-cornor');
    }
    if ((dialog.find('.ui-icon-closethick').css('background-image').indexOf('swiss_privilege/fe_img/ui-icons_888888_256x240.png') > -1 ||
        dialog.find('.ui-icon-closethick').css('background-image').indexOf('swiss_privilege/images/ui-icons_000000_256x240.png') > -1)
        && !dialog.find('.ui-icon-closethick').hasClass('ui-icon')) {
        dialog.find('.ui-icon-closethick').addClass('ui-icon');
    }
}

////Duplicate close image appear due to bad design
function hideDuplicateImage(dialog) {
    if (dialog.find('.ui-icon-closethick').is(':visible')
        && $('.ui-dialog-titlebar-close > .ui-icon-closethick').css('background-image').indexOf('fe_img/cancel.png') > -1
        && $(".ui-dialog-titlebar-close > .ui-button-text").is(':visible')
        && $('.ui-dialog-titlebar-close > .ui-button-text').css('background-image').indexOf('fe_img/cancel.png') > -1) {
        $(".ui-dialog-titlebar-close > .ui-button-text").hide();
        $(".ui-dialog-titlebar-close").removeClass("ui-icon-closethick-duplicate").addClass("ui-icon-closethick-duplicate");
    }
}

/**
 * Used to generate a property name to be used with a JavaScript Object
 * Currently used in portfolio & shortlist tools
 * @param {number} toolId
 */
function getToolIdVarName(toolId) {
    return 'toolId_' + toolId;
}

function onClickShareClass(parent, model) {
    $("." + parent + " .share-class-expansion").on("click",
        function (e) {
            e.preventDefault();
            var element = $(this);
            var citiCode = element.attr("data-citicode");
            var subRowIds = element.attr("data-subrowids");
           
            if (element.hasClass("plus")) {

                var getFundCenterData = GetInternalState($('#tab-fundCentre'));
                var getCacheModel = getFundCenterData.CachedModel.DataList;
                var hasChildRow = getCacheModel.findIndex(i => i.Common.LinkedToMainUnit == citiCode);
                if (hasChildRow !== -1) {
                    element.removeClass("plus");
                    element.addClass("minus");
                    $("#tab-fundCentre .fe-fund-tableBody .child-row[data-citicode=" + citiCode + "]").slideToggle();
                }
                else {
                    $(element).closest('tr').addClass("loading");
                    var requestModel = {
                        "DateFormat": model.DateFormat,
                        "DecimalPointSeparator": model.DecimalPointSeparator,
                        "DisplayIfNull": model.DisplayIfNull,
                        "RowIDs": subRowIds,
                        "PagedRowIDs": [],
                        "GrsProjectId": modelContents.GrsProjectId,
                        "ProjectId": model.ProjectId,
                        "ActiveTabId": model.ActiveTabId,
                        "DataList": null,
                        "LanguageCode": modelContents.LanguageCode,
                        "LanguageId": modelContents.InternalLanguageId,
                        "ProjectName": modelContents.ProjectName,
                        "IsSuccessful": false,
                        "ResponseMessage": null,
                        "RowCount": subRowIds.split(',').length,
                        "FilteringOptions": GetSearchModel(model.ToolId, model.ProjectToolId).FilteringOptions,
                        "ToolId": model.ToolId
                    };


                    // and make call to fetch citicodes details
                    $(this).sendJsonAsString(modelContents.AzureUrlForCitiCode, requestModel,
                        function (result) {
                            if (result != null && result != '') {
                                result = JSON.parse(result);
                                if (result.IsSuccessful) {
                                    element.removeClass("plus");
                                    element.addClass("minus");
                                    
                                    result.PageNo = model.PageNo;
                                    result.PageSize = model.PageSize;
                                    result.TotalRows = model.TotalRows;
                                    result.PageStartRecNo = model.PageStartRecNo;
                                    result.PageEndRecNo = model.PageEndRecNo;

                                    expandRow(getCacheModel, result.DataList, citiCode);

                                    $(element).closest('table').renderDataTable(result, result.DataList, true, true);
                                    element.attr("data-haschildRow", "true")
                                    $("#tab-fundCentre .fe-fund-tableBody .child-row[data-citicode=" + citiCode + "]").slideToggle();
                                    if (modelContents.PostMessagingEnabled) {
                                        PostMessaging.Events.ResizeIFrame();
                                    }
                                }
                                $(element).closest('tr').removeClass("loading");
                            }
                        }, function () { $(element).closest('tr').removeClass("loading");  });
                }
            }
            else if (element.hasClass("minus")) {
              
                element.removeClass("minus");
                element.addClass("plus");
                $("#tab-fundCentre .fe-fund-tableBody .child-row[data-citicode=" + citiCode + "]").slideToggle();

            }
            ToolkitUI.Common.ResizeIFrame();
        });
}


// Function to expand a row and add its sub-rows
function expandRow(cachedDataList, newDataListToAppend, insertAfterCitiCode) {
    const rowIndex = cachedDataList.findIndex(i => i.Common.CitiCode == insertAfterCitiCode);
    if (rowIndex !== -1) {
        // Splice sub-rows into the data array
        for (let i = 1; i <= newDataListToAppend.length; i++) {
            cachedDataList.splice(rowIndex + i, 0, newDataListToAppend[i - 1]);
        }
    }
}


/*
 * https://stackoverflow.com/a/21553982/2952405
 */
function getLocation(href) {
    var parseRegex = /^(https?\:)*\/\/(([^:\/?#]*)(?:\:([0-9]+))?)([\/]{0,1}[^?#]*)(\?[^#]*|)(#.*|)$/;
    var match = href.match(parseRegex);

    // Is it relative url ?
    if (!match) {
        href = location.protocol + '//' + location.host + (href.match(/^[\/]/) ? '' : '/') + href;
        match = href.match(parseRegex);
    }

    return match &&
    {
        href: href,
        protocol: match[1],
        host: match[2],
        hostname: match[3],
        port: match[4],
        pathname: match[5],
        search: match[6],
        hash: match[7]
    };
}

function getCategoryCodes()
{
    var category = $("#downloadtool_category").val();
    if (category) {
        category = String.prototype.trim.call(category);
    }
    var category2 = $("#downloadtool_category2").val();
    if (category2) {
        category2 = String.prototype.trim.call(category2);
    }

    return {"category1": category, "category2": category2 };
}
//Accessibility helper
function setAriaHiddenValue(tab, isActive) {
    if (!tab || typeof tab.attr !== 'function' || typeof tab.find !== 'function') {
        return;
    }
    const ariaValue = isActive ? 'false' : 'true';
    tab.attr('aria-hidden', ariaValue);
    const links = tab.find('a');
    if (links && typeof links.attr === 'function') {
        links.attr('aria-hidden', ariaValue);
    }
}

function enableAccessibilityFeaturesV1(tab, isActive) {
    if (tab && typeof tab.attr === 'function' && typeof tab.find === 'function') {
        const ariaValue = isActive ? 'false' : 'true';
        tab.attr('aria-hidden', ariaValue);

        const links = tab.find('a');
        if (links && typeof links.attr === 'function') {
            links.attr('aria-hidden', ariaValue);
        }
    }
    if (modelContents.Accessibility && modelContents.HigChartAccessibilitySettings.EnableAccessibilityFeatures && modelContents.HigChartAccessibilitySettings.AccessibilityFeaturesVersion >= 1)
    {
        if (tab && tab.length) {            
            tab.find('a')                
                .each(function () {
                    var targetUrl = DOMPurify.sanitize($(this).attr('data-target'));
                    if (!isActive && targetUrl) {
                        $(this).attr('href', targetUrl);
                    } else if (isActive) {
                        $(this).removeAttr('href');
                    }
                });
        }
    }
}
