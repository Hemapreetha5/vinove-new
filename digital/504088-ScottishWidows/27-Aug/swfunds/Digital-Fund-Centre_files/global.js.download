//This function should be called on document ready for each tab toolbar
//You can call it once but it all depends on your implementation
//TODO: below selector may need a later visit for some of complex scenarios
$.fn.initializeToolbar = function () {
    this.find('.actions').each(function (img) {
        $(this).mouseover(function () {
            this.src = this.src.replace("_Normal", "_Highlight");
        });
        $(this).mouseout(function () {
            this.src = this.src.replace("_Highlight", "_Normal");
        });
    });
}

//This funtion is extended from jQuery framework to create dynamic 
//check box within specified container
//and as per given value
//Please note that this funtion can take any container but it
//is strongly suggested that you should use ul as you main container 
$.fn.addCheckbox = function (name, value, text) {
    var inputs = this.find('input');
    var id = inputs.length + 1;

    var html = '<li><input type="checkbox" id="' + name + '" name="' + name + '" value="' + value + '" /> <label for="' + name + '">' + text + '</label></li>';
    this.append($(html));
}

//This function creates check box list control
$.fn.createCheckboxList = function (name, data) {
    var list = this;
    list.empty();
    //TODO: The below line is just temp. solution but I need to find out route cause of this problem and fix it properly later.
    //Serializearray funtion some how ignoring first value.
    list.append('<li style="display:none"><input type="checkbox" id="' + name + '" name="' + name + '" value="' + 0 + '" /> <label for="' + name + '">' + 0 + '</label></li>');
    $.each(data, function (k, v) {
        list.append('<li><input type="checkbox" id="' + name + '" name="' + name + '" value="' + k + '" /> <label for="' + name + '">' + v + '</label></li>');
    });
}

//This function load values in selected check box list
$.fn.setCheckboxList = function (name, data) {
    var list = this;
    //first reset the current list
    this.find('input[type=checkbox]').each(function () {
        this.checked = false;
    });
    //now load the given object values
    $.each(data, function (k, v) {
        $('input[@type=checkbox][value=' + v + ']').each(function () {
            this.checked = true;
        });
    });
}

//This function sets values in given radio button list 
$.fn.setRadioButtonValue = function (name, value) {
    //First reset radio button list
    this.find('input[type=radio][name=' + name + ']').each(function () {
        this.checked = false;
    });

    //Load radio button with given values
    this.find('input[@type=radio][name=' + name + '][value=' + value + ']').each(function () {
        this.checked = true;
    });
}

//This funtion loads given json object data into select options
$.fn.addItems = function (data) {
    var list = this;
    list.empty();
    $.each(data, function (k, v) {
        list.append("<option value='" + k + "'>" + v + "</option>");
    });
};

//This funtion loads given json object data into select options
$.fn.addItems = function (data, canEmptyList) {
    this.addItems(data, canEmptyList, true);
}

//This funtion loads given json object data into select options
$.fn.addItems = function (data, canEmptyList, canRefresh) {
    var list = this;
    if (canEmptyList)
        list.empty();

    $.each(data, function (k, v) {
        list.append("<option value='" + k + "'>" + v + "</option>");
    });

    if (canRefresh)
        this.multiselect('refresh');
};

//This funtion loads given json object data into select options
$.fn.addItems = function (data, canEmptyList, canRefresh, emptyItemText) {
    var list = this;

    if (canEmptyList)
        list.empty();

    if (emptyItemText != null && emptyItemText != undefined) {
        list.append("<option value=''>" + emptyItemText + "</option>");
    }

    $.each(data, function (k, v) {
        list.append("<option value='" + k + "'>" + v + "</option>");
    });

    if (canRefresh)
        this.multiselect('refresh');
};

//This funtion is extended from jQuery framework to get controls
//data in json format rather constructing ourself.
$.fn.getJsonData = function (name) {
    var o = {};
    o[name] = this.data('key_id');
    if (o[name] == undefined)
        o[name] = 0;
    var a = this.serializeArray();
    $.each(a, function () {
        var placeholder = $('[name="' + this.name + '"]').attr('placeholder');
        if (this.value == placeholder)
            this.value = null;
        if (o[this.name] !== undefined) {
            if (!o[this.name].push) {
                o[this.name] = [o[this.name]];
                //o[this.name] = this.value;
            }
            if (this.value != '' && this.value != undefined && this.value != null ) {
                o[this.name].push(this.value.replaceAll(',','|') || '');
            }
        } else if (this.value != '' && this.value != undefined && this.value != null) {
            o[this.name] = this.value.replaceAll(',', '|') || '';
        }
    });
    AddSliderData(this, o);
    return o;
};

function AddSliderData(parent, resultSet) {
    parent.find('div[data-rangeslider]').each(function (i, sliderElement) {
        resultSet[$(sliderElement).attr('data-name')] = CreateValueRangeObject(jQuery(sliderElement));
    });
}

function CreateValueRangeObject(slider) {
    var o = {};
    if (!$(slider).hasClass("ui-slider")) {
        return o;
    }

    var values = slider.slider("option", "values");
    var highBoundry = values[1];
    var lowBoundry = values[0];

    if (!(slider.data("maxopen") && slider.data("max") == highBoundry)) {
        o.TopValue = String(highBoundry);
    }

    if (!(slider.data("minopen") && slider.data("min") == lowBoundry)) {
        o.BottomValue = String(lowBoundry);
    }

    return o;
}

$.fn.loadJsonData = function (key, data) {
    this.data('key_id', key);
    $.each(data, function (k, v) {
        if (typeof v == 'string' && v.length > 5 && v.substring(0, 5) == '/Date')
            $('#' + k + '').val(GetDateString(v));
        else
            $('#' + k + '').val(v);
    });
};

//Global function which will be called as a part of every request.
//TODO: The below approach is not ideal but considering time we have at this present, I think it will work
//but need revisit at some time.
$.OnAjaxComplete = function (response) {
    if (typeof response.responseText == "string" && response.responseText.toLowerCase().indexOf("<title>login</title>") > 0) {
        $("#error-dialog").dialog("close");
        window.location.replace($.url.actions.LogOn);
    }
}

OnAjaxComplete = function (response, status, source) {
    if (typeof response.responseText == "string" && response.responseText.toLowerCase().indexOf("<title>login</title>") > 0) {
        $("#error-dialog").dialog("close");
        window.location.replace($.url.actions.LogOn);
    }
    if (source) {
        if ($(source).is('select')) {
            $(source).siblings('.mfs-selected-option').focus();
        } else if ($(source).hasClass('fe-ico-basket-portfolio-add') || $(source).hasClass('fe-ico-basket-shortlist-add')) {
            $('.fe-tableInBasket tr a').each(function () {
                if ($(this).attr('code') == $(source).attr('code')) {
                    $(this).focus();
                }
            });
        }
        else if ($(source).hasClass('ui-paging-button')) {
            if ($(source).attr('data-location') == "FT") {
                $('.fe-paging-footer .pagination').children().each(
                    function () {
                        if ($(this).html() == $(source).html()) {
                            if ($(this).is(":tabbable")) {
                                $(this).focus()
                            } else if ($(this).next('a').length > 0) {
                                $(this).next('a').focus();
                            } else {
                                $(this).siblings('a')[0].focus();
                            }
                            return;
                        }
                    });
            } else {
                $('.fe-datatable-pagination-container .pagination').children().each(
                    function () {
                        if ($(this).html() == $(source).html()) {
                            if ($(this).is(":tabbable")) {
                                $(this).focus()
                            } else if ($(this).next('a').length > 0) {
                                $(this).next('a').focus();
                            } else {
                                $(this).siblings('a')[0].focus();
                            }
                            return;
                        }
                    });
            }
        }
    }


}

$.fn.sendJsonAsString = function (actionUrl, model, onSuccess, onError, fundLength) {
    var inputObj = "jsonString=" + encodeURIComponent(JSON.stringify(model));
    if (fundLength > 3) {
        $(this).sendJson($.ajaxTypes.post, actionUrl, inputObj, onSuccess, onError);
    }
    else {
        $(this).sendJson($.ajaxTypes.get, actionUrl, inputObj, onSuccess, onError);
    }
}

$.fn.getDataFromJsonString = function (actionUrl, model) {
    var inputObj = "jsonString=" + encodeURIComponent(JSON.stringify(model));
    var datarequested = $(this).getDataFromJson($.ajaxTypes.get, actionUrl, inputObj);
    return datarequested;
}

$.fn.sendJson = function (type, actionUrl, model, onSuccess, onError) {
    $.ajaxSetup({ cache: true });
    $.ajax({
        url: actionUrl,
        type: type,
        data: model,
        datatype: "json",
        complete: $.OnAjaxComplete,
        success: onSuccess,
        error: onError != null ? onError : OnAjaxError
    });
}

//This function sends json request asynchronously to server based on given parameteres
$.fn.getDataFromJson = function (type, actionUrl, model) {
    var datarequested;
    $.ajaxSetup({ cache: true });
    $.ajax({
        url: actionUrl,
        type: type,
        data: model,
        cache: type == $.ajaxTypes.get ? true : false,
        datatype: "json",
        contentType: "application/json; charset=utf-8",
        complete: $.OnAjaxComplete,
        success: function (data) {
            datarequested = data;
        },
        error: OnAjaxError,
        async: false
    });

    return datarequested;
}

//This function sends json request asynchronously to server based on given parameteres
$.fn.sendJsonRequest = function (type, actionUrl, model, onSuccess, source) {

    $.ajax({
        url: actionUrl,
        type: type,
        data: model ? JSON.stringify(model) : null,
        cache: type == $.ajaxTypes.get ? true : false,
        datatype: "json",
        contentType: "application/json; charset=utf-8",
        complete: function (r, status) {
            OnAjaxComplete(r, status, source);
        },
        success: onSuccess,
        error: OnAjaxError
    });
}

//This function sends json request asynchronously to server based on given parameteres and expects return
$.fn.sendJsonReturnRequest = function (type, actionUrl, model, onSuccess, source) {

    return $.ajax({
        url: actionUrl,
        type: type,
        data: model ? JSON.stringify(model) : null,
        cache: type == $.ajaxTypes.get ? true : false,
        datatype: "json",
        contentType: "application/json; charset=utf-8",
        complete: function (r, status) {
            OnAjaxComplete(r, status, source);
        },
        success: onSuccess,
        error: OnAjaxError
    });
}

//This function sends json request asynchronously to server based on given parameteres
$.fn.getDataFromJsonRequest = function (type, actionUrl, model) {
    var datarequested;

    $.ajax({
        url: actionUrl,
        type: type,
        data: model ? JSON.stringify(model) : null,
        cache: type == $.ajaxTypes.get ? true : false,
        datatype: "json",
        contentType: "application/json; charset=utf-8",
        complete: $.OnAjaxComplete,
        success: function (data) {
            datarequested = data;
        },
        error: OnAjaxError,
        async: false
    });

    return datarequested;
}

//This function display error dialog 
$.fn.showError = function (msg) {
    $('#error-dialog p').html(msg);
    var OKText = modelContents.GetTranslation("Ok");
    $("#error-dialog").dialog({
        modal: true,
        buttons: [{
            text: OKText,
            "class": "ui-state-default ui-button-text-only",
            click: function () {
                $(this).dialog("close");
            }
        }]
    });
}


function GetOkButton(buttonName) {
    var OkButton = {};
    OkButton[buttonName] = function () {
        $(this).dialog("close");
    }
    return OkButton;
}

//This function display given message in dialog
$.fn.showMessageWithButtonText = function (msg, buttonText) {
    $('#message-dialog p').html(msg);
    var button = GetOkButton(buttonText);
    $("#message-dialog").dialog({
        modal: true,
        buttons: button
    });
}

//This function display confirm dialog
$.fn.showConfirm = function (msg, id, callback) {
    $('#confirmationDialog p').html(msg);
    var OKText = modelContents.GetTranslation("Ok");
    var CancelText = modelContents.GetTranslation("Cancel");
    $("#confirmationDialog").dialog({
        autoOpen: true,
        height: 200,
        width: 350,
        modal: true,
        buttons: [{
            text: OKText,
            "class": "ui-state-default ui-button-text-only",
            click: function (e) {
                $("#confirmationDialog").dialog("close");
                callback(true, id, e);
            }
        }, {
                text: CancelText,
                "class": "ui-state-default ui-button-text-only",
            click: function (e) {
                $("#confirmationDialog").dialog("close");
                callback(false, id, e);
            }
        }
        ]
    });

    return $("#confirmationDialog");
}

