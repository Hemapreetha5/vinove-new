// $.browser has been removed from JQuery 1.9 versions
// browser variable is created to support the existing functionality based on browsers.
var browser = new function () {
    var regex = /((MSIE|TRIDENT)|(?!Gecko.+)Firefox|(?!AppleWebKit.+Chrome.+)Safari|(?!AppleWebKit.+)Chrome|AppleWebKit(?!.+Chrome|.+Safari)|Gecko(?!.+Firefox))(?: |\/)([\d\.apre]+)/i;
    var value = navigator.userAgent.match(regex);

    this.mozilla = /mozilla/.test(navigator.userAgent.toLowerCase()) && !/webkit/.test(navigator.userAgent.toLowerCase());

    if (value != null && value[1] != null) {
        this.firefox = /firefox/.test(value[1]) && !/webkit/.test(value[1].toLowerCase());
        this.webkit = /webkit/.test(value[1].toLowerCase());
        this.opera = /opera/.test(value[1].toLowerCase());
        this.msie = (/msie/.test(value[1].toLowerCase())) || (/trident/.test(value[1].toLowerCase()));
        this.chrome = /chrome/.test(value[1].toLowerCase());
        this.safari = /safari/.test(value[1].toLowerCase());

        if (this.safari) {
            // When request comes from chrome in IOS the user agent wont contain version but CriOS instead. Henced this fix 
            var versionregex = /(Version|CriOS)\/(.*?(?=\s))/i;
            this.version = navigator.userAgent.match(versionregex)[1];                      
        } else if (/trident/.test(value[1].toLowerCase())) {
            var versionregex = /rv:(.*?(?=\)))/i;
            this.version = navigator.userAgent.match(versionregex)[1];
        } else if (value.length >= 4) {
            this.version = value[3];
        } else {
            this.version = 0;
        }
    }
    else {
        this.firefox = false;
        this.webkit = false;
        this.opera = false;
        this.msie = false;
        this.chrome = false;
        this.safari = false;
        this.version = 0;
    }
}

Object.keys = Object.keys || (function () {
    var hasOwnProperty = Object.prototype.hasOwnProperty,
        hasDontEnumBug = !{ toString: null }.propertyIsEnumerable("toString"),
        DontEnums = [
            'toString',
            'toLocaleString',
            'valueOf',
            'hasOwnProperty',
            'isPrototypeOf',
            'propertyIsEnumerable',
            'constructor'
        ],
        DontEnumsLength = DontEnums.length;

    return function (o) {
        if (typeof o != "object" && typeof o != "function" || o === null)
            throw new TypeError("Object.keys called on a non-object");

        var result = [];
        for (var name in o) {
            if (hasOwnProperty.call(o, name))
                result.push(name);
        }

        if (hasDontEnumBug) {
            for (var i = 0; i < DontEnumsLength; i++) {
                if (hasOwnProperty.call(o, DontEnums[i]))
                    result.push(DontEnums[i]);
            }
        }

        return result;
    };
})();

$.extend({
