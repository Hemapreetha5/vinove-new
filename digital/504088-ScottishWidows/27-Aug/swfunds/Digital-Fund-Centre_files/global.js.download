//#region Helper Functions

Array.prototype.remove = function (e) {
    var t, _ref;
    if ((t = $.inArray(e, this)) > -1) {
        return ([].splice.apply(this, [t, t - t + 1].concat(_ref = [])), _ref);
    }
};

///Include for IE browser as findIndex is not supportted by them
if (!Array.prototype.findIndex) {
    Object.defineProperty(Array.prototype, 'findIndex', {
        value: function (predicate) {
            // 1. Let O be ? ToObject(this value).
            if (this == null) {
                throw new TypeError('"this" is null or not defined');
            }

            var o = Object(this);

            // 2. Let len be ? ToLength(? Get(O, "length")).
            var len = o.length >>> 0;

            // 3. If IsCallable(predicate) is false, throw a TypeError exception.
            if (typeof predicate !== 'function') {
                throw new TypeError('predicate must be a function');
            }

            // 4. If thisArg was supplied, let T be thisArg; else let T be undefined.
            var thisArg = arguments[1];

            // 5. Let k be 0.
            var k = 0;

            // 6. Repeat, while k < len
            while (k < len) {
                // a. Let Pk be ! ToString(k).
                // b. Let kValue be ? Get(O, Pk).
                // c. Let testResult be ToBoolean(? Call(predicate, T, « kValue, k, O »)).
                // d. If testResult is true, return k.
                var kValue = o[k];
                if (predicate.call(thisArg, kValue, k, o)) {
                    return k;
                }
                // e. Increase k by 1.
                k++;
            }

            // 7. Return -1.
            return -1;
        },
        configurable: true,
        writable: true
    });
}

String.prototype.contains = function (it) { return this.indexOf(it) != -1; };

function DoOnWindowClose() {
    $(this).sendJsonRequest($.ajaxTypes.get, $.url.actions.LogOff, null, null);
}

function GetDateString(date, s) {
    if (!s)
        s = 'dd/MM/yyyy';

    if (date != null && s == null) {
        var formattedDate = moment.utc(date).toDate();
        return formattedDate.f(s); //"dd/MM/yyyy \r HH:mm"
    }
    if (date != null && s != null) {
        var formattedDate = moment.utc(date).toDate();
        return formattedDate.f(s); //"dd/MM/yyyy \r HH:mm:ss"
    }
    return "";
}

//This funtion shows dialog based on given name of the dialog
//other parameters
function ShowDialog(name, width, height, onSave) {
    $(name).dialog({
        resizable: false,
        width: width,
        height: height,
        modal: true,
        hide: "fade",
        buttons: {
            "class": "ui-state-default ui-button-text-only",
            Cancel: function () {
                $(this).dialog("close");
            },
            "Save": onSave
        }
    });
}

//This function show data container and hides all other which are visible.
//If you have a requirement to keep other data container visible then either 
//you need to extend this funtion or call this funtion as per your requirement
//which may be twice or thrice.
//You need to define your data container with the postfix (in otherwords id or name should be
//ending with) '-data-container'
function ShowContainer(name) {
    $('div[id$="-data-container"]').hide();
    $(name).show();
}

//This function called by sendRequest function and will fire call when ever any ajax error occured
function OnAjaxError(req, status, error) {
    $('html').hideLoading();
    $(this).showError("Sorry, an error occurred while processing your request.");
}

