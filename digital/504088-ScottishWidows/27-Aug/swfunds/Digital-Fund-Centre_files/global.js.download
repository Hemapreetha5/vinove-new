    $("#message-dialog").dialog({
        modal: true,
        buttons: [{
            text: OKText,
            "class": "ui-state-default ui-button-text-only",
            click: function () {
                $(this).dialog("close");
                callback();
            }
        }]
    });
}


//This function display disclaimer in dialog 
$.fn.showDisclaimer = function (msg) {
    $('#disclaimer-dialog p').html(msg);
    var OKText = modelContents.GetTranslation("Ok");
    $("#disclaimer-dialog").dialog({
        modal: true,
        height: 500,
        width: 550,
        buttons: [{
            text: OKText,
            "class": "ui-state-default ui-button-text-only",
            click: function () {
                $(this).dialog("close");
            }
        }]
    });
}

//This funtion shows dialog based on given name of the dialog
//other parameters
$.fn.showFormDialog = function (width, height, onSave) {
    $(this).dialog({
        resizable: false,
        width: width,
        height: height,
        modal: true,
        hide: "fade",
        buttons: {
            Cancel: function () {
                $(this).dialog("close");
            },
            "Save": onSave
        }
    });
}

//This function closes the dialog
$.fn.closeDialog = function () {
    $(this).dialog("close");
}

$.fn.resetForm = function () {
    this.find('form').get(0).reset();
    this.find('form').data('key_id', 0);
}

//This funtion sets the given input text control to have calender
//funtionality with default settings which are being used across 
//the project
$.fn.setAsDatePicker = function () {
    $(this).datepicker({ dateFormat: 'dd-mm-yy' });
    $(this).datepicker('option', 'firstDay', 1);
}

//This function sets the paging features and callback function
$.fn.setPaging = function (totalRows, currentPage, recordsPerPage, onPageChange) {
    if (!currentPage) {
        currentPage = 1;
    }
    if (currentPage - 1 > totalRows / recordsPerPage) {
        // this is just "in case" - it should not happen
        currentPage = 1;
    }
    //initialization of current page index
    $(this).data('current_page_index', currentPage);
    $(this).data('totalRows', totalRows);
    $(this).data('pageSize', recordsPerPage);

    if (totalRows <= recordsPerPage && $(this).data('autohide')) {
        // 
        $(this).hide();
        return;
    }
    else {
        $(this).show();
    }


    var options = {
        current_page: currentPage - 1, // 0 based
        items_per_page: recordsPerPage,
        num_display_entries: 4,
        num_edge_entries: 1,
        ellipse_text: '...',
        prev_text: $(this).data('prev'),
        next_text: $(this).data('next')
    }

    if (onPageChange != null)
        options.callback = onPageChange;

    $(this).pagination(totalRows, options);

    return false;
}

$.fn.FormatPagingDisplay = function (firstElement, lastElement, totalNumberOfElements) {
    var template = $(this).data('template') || $(this).text();
    if (template != null) {
        var result = String(template).replace('{first}', firstElement);
        result = String(result).replace('{last}', lastElement);
        result = String(result).replace('{total}', totalNumberOfElements);
        $(this).data('template', template);
        $(this).text(result);
    }
};

function PagingPageChangedHandler(new_page_index, pagination_container, isFooterPagination, event) {
    var eventObj = (window.event || event) ? $.event.fix(event || window.event) : null;
    var target = eventObj.currentTarget;
    if (isFooterPagination) {

        $(target).attr('data-location', "FT");
    }
    var tbl = $(pagination_container).parents('table');

    if (tbl.length < 1)
        tbl = $(pagination_container).parents('div.fe-tabs-datacontainer');

    var onGetDataRequest = jQuery.Event("onGetDataRequest");
    onGetDataRequest.pageSize = tbl.getPageSize();
    new_page_index++;
    onGetDataRequest.newPageIndex = new_page_index;
    onGetDataRequest.currentPage = tbl.getCurrentPage();
    onGetDataRequest.source = target;
    tbl.setCurrentPage(new_page_index);
    tbl.setPaginationTitle();
    tbl.trigger(onGetDataRequest);
    //$(pagination_container).data('has_initialized', true);        
    tbl.initializePagination(true);
    return false;
};

function PagingRowsPerPageChangedHandler(e) {
    e.preventDefault();

    var tbl = $(this).parents('table');

    if (tbl.length < 1)
        tbl = $(this).parents('div.fe-tabs-datacontainer');

    var paginator = tbl.parent().find(".paginator");
    var newPageSize = $(this).val();
    tbl.initializePagination(false);
    //fire onRecordsPerPage change event
    var onRecordsPerPage = jQuery.Event("onRecordsPerPage");
    onRecordsPerPage.pageSize = newPageSize;
    var currPage = tbl.getCurrentPage();
    onRecordsPerPage.currentPage = currPage;

    //following newPageIndex is set same as current because in this event we don't have newPage index 
    onRecordsPerPage.newPageIndex = onRecordsPerPage.currentPage;
    tbl.trigger(onRecordsPerPage);

    var onGetDataRequest = jQuery.Event("onGetDataRequest");
    onGetDataRequest.pageSize = newPageSize;
    // the current page would change because the size changes
    var currentPageBeforeEvent = tbl.getCurrentPage();
    var pageSizeBeforeEvent = paginator.data('pageSize');
    var firstItemOrderNumberOnPageBeforeEvent = 1 + pageSizeBeforeEvent * (currentPageBeforeEvent - 1);
    var pageWhereFirstItemIsNow = Math.floor(firstItemOrderNumberOnPageBeforeEvent / newPageSize) + 1;

    onGetDataRequest.currentPage = pageWhereFirstItemIsNow;
    onGetDataRequest.newPageIndex = onGetDataRequest.currentPage;
    onGetDataRequest.source = e.currentTarget;
    //tbl.setCurrentPage(onGetDataRequest.currentPage);
    tbl.trigger(onGetDataRequest);

};

//This funtion renders the table with data based on given model and data object.
$.fn.renderDataTable = function (model, data, hasSections, isChildRowCreation) {

    isChildRowCreation = isChildRowCreation || false;
    //Table control where to load data
    var current = $(this);
    var parent = current.parent();

    //Fire custom event on pre data load
    var onPreDataLoad = jQuery.Event("onPreDataLoad");
    onPreDataLoad.hasData = model.TotalRows > 0;
    current.trigger(onPreDataLoad);
    var currentTemplateId = '';

    var reqControl;
    if (hasSections) {
        // Create document rows with JS templating
        if (!isChildRowCreation) {
            current.find("[data-id=docRows]").empty();
        }
        else {
            current.find("tr.cascade-hide.cascade-child").remove();
        }

        currentTemplateId = "#template-" + current.attr('id').replace('-data-container', '');

        processDocumentTemplate(current, currentTemplateId, model);

        if (isChildRowCreation) {
            var generatedContent = $("#template-" + current.attr('id').replace('-data-container', '')).tmpl(data).addClass("child-row hidden-row").attr("data-citicode", data[0].Common.LinkedToMainUnit)
            current.find("tr[data-citicode=" + data[0].Common.LinkedToMainUnit + "]").each(function (index) {
                var clonedContent = generatedContent.clone();

                // Add odd or even class to the cloned content based on the index
                if (index % 2 === 0) {
                    clonedContent.addClass("even");
                } else {
                    clonedContent.addClass("odd");
                }
                clonedContent.find(".fe-column-name")
                    .prepend("<span class='share-class-icon'></span>");

                var nextElement = $(this).next();
                if (nextElement.hasClass("cascade-child")) {
                    nextElement.after(clonedContent);
                } else {
                    $(this).after(clonedContent);
                }
            });
        } else {
            if (current.attr('data-projectToolTabId') == modelContents.DocumentTabId) {
                /// This block of code will create new template instead of using cached template because manipulated the template string 
                /// dynamically for the above condition.
                let templateString = $("#template-" + current.attr('id').replace('-data-container', '')).html();
                let newTemplate = $.template(null, templateString); // Compile new template
                $.tmpl(newTemplate, data).appendTo(parent.find("[data-id=docRows]"));
            } else {
                $("#template-" + current.attr('id').replace('-data-container', '')).tmpl(data).appendTo(current.find("[data-id=docRows]"));
            }
        }

        if (current.find(".fe-section-largetext-wrap").length > 0) {
            current.find(".fe-section-largetext-wrap").each(function (x) {
                var noOfColumns = $(this).find(".fe-section-vertical-wrap").length;
                var width = (100 - 0.5) / noOfColumns;
                $(this).find(".fe-section-vertical-wrap").css("width", width + "%");
            });
        }
        reqControl = current;

        ///IHUB-2937: Image load event is not fired in mozilla when Fund manager is null. So assigning invalid image to fire onerror event.
        $('img[src=""]', 'span.ManagerPersonPhoto').attr('src', 'noImage.png');
    }
    else {
        // Create document rows with JS templating
        parent.find("[data-id=docRows]").empty();
        if (model.ToolId === ToolIds.FundCentreId) {
            currentTemplateId = "#template-" + current.attr('id');
        }
        processDocumentTemplate(current, "#template-" + current.attr('id'), model);

        if (current.attr('data-projectToolTabId') == modelContents.DocumentTabId) {
            /// This block of code will create new template instead of using cached template because manipulated the template string 
            /// dynamically for the above condition.
            let templateString = $("#template-" + current.attr('id')).html();
            let newTemplate = $.template(null, templateString); // Compile new template
            $.tmpl(newTemplate, data).appendTo(parent.find("[data-id=docRows]"));
        } else {
            $("#template-" + current.attr('id')).tmpl(data).appendTo(parent.find("[data-id=docRows]"));
        }

        parent.find('tbody tr td.actionLink').on('click',
            function (event) {
                var target = $(this).parent();
                var onDataRowClick = jQuery.Event("onDataRowClick");
                onDataRowClick.id = target.find('.check').attr('id');
                $(this).parents('table').trigger(onDataRowClick);
            });

        parent.StyleTableRows();
        reqControl = parent;
    }

    parent.find(".display-count").FormatPagingDisplay(model.PageStartRecNo, model.PageEndRecNo, model.TotalRows);

    if (model.ShowPerformanceTypeDropDown) {
        if (currentTemplateId != '') {
            if ($(currentTemplateId).html().contains('.CalendarPerformance.') || $(currentTemplateId).html().contains('.Performance.') || $(currentTemplateId).html().contains('.DiscretePerformance.') || $(currentTemplateId).html().contains('PerformanceAndRiskSection_')) {
                parent.find("div.fe-specialunittype-dropdown").show();
            } else {
                parent.find("div.fe-specialunittype-dropdown").hide();
            }
        }

        parent.find("select[name=specialunittype-dropdown]").empty();
        parent.find("select[name=specialunittype-dropdown]").append($('<option>', {
            value: 'DEFAULT',
            text: 'Default'
        }));
        $.each(model.SpecialUnitTypeInfo, function (i, item) {
            parent.find("select[name=specialunittype-dropdown]").append($('<option>', {
                value: item.SpecialUnitTypeCode,
                text: item.SpecialUnitTypeName
            }));
        });

        if (model.SelectedSpecialUnitType != null && typeof model.SelectedSpecialUnitType != 'undefined') {
            $("select[name=specialunittype-dropdown] option[value='" + model.SelectedSpecialUnitType + "']").prop('selected', true);
            if (model.ToolId == ToolIds.FundCentreId) {
                parent.parent().data('selectedspecialunittype', model.SelectedSpecialUnitType);
            } else {
                parent.data('selectedspecialunittype', model.SelectedSpecialUnitType);
            }
        }
        $(parent).mfs('destroy');
        $(parent).mfs();
        parent.find("select[name=specialunittype-dropdown]").off('change').change(function (e) {
            if (model.ToolId == ToolIds.FundCentreId) {
                parent.parent().data('selectedspecialunittype', $(this).val());
            } else {
                parent.data('selectedspecialunittype', $(this).val());
                var selectedFundIndexes = [];
                parent.find(".fe-tabs-datacontainer:visible").find(".fe-section-accordion-container").each(function (index) {
                    if ($(this).is(':visible')) {
                        selectedFundIndexes.push(index);
                    }
                });
                isAccordionRetainNeeded = true;
                SetFundTabIndexesSelected(parent, selectedFundIndexes);
            }
            Search(model.ToolId, false, false, this);
        });
    }

    //Set paging features
    var paginator = reqControl.find(".paginator");
    var currentPage;
    if (model.PageNo) {
        currentPage = model.PageNo;
    }
    else {
        currentPage = paginator.getCurrentPage();
    }

    var pageSize = (model.PageSize) ? model.PageSize
        : (current.getPageSize()) ? current.getPageSize() : model.TotalRows;

    paginator.setPaging(model.TotalRows,
        currentPage,
        pageSize,
        PagingPageChangedHandler
    );

    parent.find('.record-count').off('change');

    paginator.setPaginationTitle();

    // Correct the page size drop down.
    var corrected = false;

    reqControl.find('.record-count').find('option').each(function () {
        if ($(this).val() > model.TotalRows) {
            if (corrected) {
                $(this).prop('disabled', true);
            }
            else {
                $(this).prop('disabled', false);
                $(this).html(model.TotalRows);
                corrected = true;
            }
        }
        else {
            $(this).prop('disabled', false);
            var sanitizedValue = DOMPurify.sanitize($(this).val());
            $(this).html(sanitizedValue);
        }
    });

    reqControl.find('.record-count').val(pageSize);
    reqControl.find('.record-count').on("change", PagingRowsPerPageChangedHandler);
    $('.fe-paging-displayContainer').mfs('refresh');

    if (!hasSections) {
        //Fire custom event on post data load
        var onPostDataLoad = jQuery.Event("onPostDataLoad");
        onPostDataLoad.hasData = model.TotalRows > 0;
        current.trigger(onPostDataLoad);
    }
    if (!isChildRowCreation) {
        if (model.ToolId === ToolIds.FundCentreId && model.ShowMainUnits) {
            $(data).each(function (index, row) {
                var hasMainUnit = data.findIndex(
                    function (x) {
                        return x.Common.CitiCode === row.Common.LinkedToMainUnit;
                    });
                if (row.Common.LinkedToMainUnit !== null && this.Common.LinkedToMainUnit.length > 0 && hasMainUnit < 0) {
                    row.Common.LinkedToMainUnit = null;
                }
            });

            var childClassName = "odd";
            $(parent.find("[data-id=docRows] tr .fe-column-name"))
                .prepend(
                    "<div class='loading-icon'></div><span class='share-class-icon'></span>");

            $(data).each(function (d) {
                var parentRow = parent.find("[data-id=docRows] tr")[d];
                $(parentRow).attr("class", "");
                $(parentRow).addClass("parent");
                $(parentRow).attr("data-citicode", this.Common.CitiCode);

                var subRow = isChildRowCreation ? [] : modelContents.RowSubRowIdPairs.filter(i => i.CitiCode == this.Common.CitiCode);

                if (subRow.length > 0 && subRow[0].SubRowIds != "") {
                    $(parent.find("[data-id=docRows] tr .fe-column-name .share-class-icon")[d])
                        .html(
                            "[<a class='share-class-expansion plus' href='javascript: void (0)' data-citicode=" +
                            this.Common.CitiCode + ' aria-label="expand row" ' +
                            " data-subRowIds=" + subRow[0].SubRowIds + "></a>]");
                }
                
                if ((this.Common.LinkedToMainUnit !== null && this.Common.LinkedToMainUnit.length > 0)) {
                    $(parentRow).attr("class", "");
                    $(parentRow).addClass("child-row hidden-row " + childClassName);
                    $(parentRow).attr("data-citicode", this.Common.LinkedToMainUnit);
                    childClassName = childClassName === "even" ? "odd" : "even";
                    if (!$(parent.find("[data-id=docRows] tr")[d - 1]).hasClass("child-row")) {
                        $(parent.find("[data-id=docRows] tr")[d - 1])
                            .attr("data-citicode", this.Common.LinkedToMainUnit);
                        $(parent.find("[data-id=docRows] tr .fe-column-name .share-class-icon")[d - 1])
                            .html(
                                "[<a class='share-class-expansion plus' href='javascript: void (0)' data-citicode=" +
                                this.Common.LinkedToMainUnit + ' aria-label="expand row" ' +
                                "></a>]");
                    }
                }
            });

            var className = "even";
            $(parent.find("[data-id=docRows] tr.parent")).each(function (d) {
                $(this).addClass(className);
                className = className === "even" ? "odd" : "even";
            });
            onClickShareClass($(parent.find("[data-id=docRows]")).attr("class"), model);
        }
    }
    applyResponsiveCascadingRow(parent,
        current,
        {
            headerSelector: '.check.ui-widget-header',
            tbodySelector: 'tbody'
        });
}

function processDocumentTemplate(current, currentTemplateId, model) {
    function cloneTemplateIfNeeded() {
        if (!$(`${currentTemplateId}_clone`).length) {
            let originalElement = document.querySelector(currentTemplateId);
            let clonedElement = originalElement.cloneNode(true);
            clonedElement.id = `${clonedElement.id}_clone`;
            originalElement.parentNode.insertBefore(clonedElement, originalElement.nextSibling);
        }
    }

    function getTemplateElements() {
        let currentTemplateResult = $($(currentTemplateId).html());
        let clonedCurrentTemplateResult = $($(`${currentTemplateId}_clone`).html());
        return {
            currentTemplate: currentTemplateResult.length ? currentTemplateResult : null,
            clonedCurrentTemplate: clonedCurrentTemplateResult.length ? clonedCurrentTemplateResult : null
        };
    }

    function processRetailFactsheet(currentTemplate) {
        /*
           Legends:
           1.) FS - Provider Factsheet
           2.) AD - Advisor Factsheet
           Summary:
           Prioritize FS results and show FS results in both FS and AD factsheets.
           If FS doesn't have results then show empty result in both FS and AD
        */
        let advisorFactsheetResult = currentTemplate.find(".AdvisorFactsheet *[class*='fe-section-'][class*='-val']");
        if (advisorFactsheetResult.length) {
            $(currentTemplateId).html(unEscapeHtml(currentTemplate.prop('outerHTML').replace(/\$data\.Documents\.AdvisorFactsheet/g, '$data.Documents.ProviderFactsheet')));
        }
    }

    function processInstitutionalFactsheet(currentTemplate) {
        /*
           Legends:
           1.) FS - Provider Factsheet
           2.) AD - Advisor Factsheet
           Summary:
           Prioritize AD results and show AD results in both FS and AD factsheets.
           If AD doesn't have results then show FS results in both FS and AD
        */
        let providerFactsheetResult = currentTemplate.find(".ProviderFactsheet *[class*='fe-section-'][class*='-val']");
        if (model.DataList.length && model.DataList[0].Documents && model.DataList[0].Documents.AdvisorFactsheet) {
            if (providerFactsheetResult.length) {
                var sanitizedHtml = DOMPurify.sanitize(unEscapeHtml(currentTemplate.prop('outerHTML').replace(/\$data\.Documents\.ProviderFactsheet/g, '$data.Documents.AdvisorFactsheet')));
                $(currentTemplateId).html(sanitizedHtml);
            }
        } else {
            let advisorFactsheetResult = currentTemplate.find(".AdvisorFactsheet *[class*='fe-section-'][class*='-val']");
            if (advisorFactsheetResult.length) {
                var sanitizedHtml = DOMPurify.sanitize(unEscapeHtml(currentTemplate.prop('outerHTML').replace(/\$data\.Documents\.AdvisorFactsheet/g, '$data.Documents.ProviderFactsheet')));
                $(currentTemplateId).html(sanitizedHtml);
            }
        }
    }

    function unEscapeHtml(str) {
        return str.replace(/&amp;/g, "&")
            .replace(/&lt;/g, "<")
            .replace(/&gt;/g, ">");
    }

    if (current.attr('data-projectToolTabId') == modelContents.DocumentTabId) {
        cloneTemplateIfNeeded();

        let { clonedCurrentTemplate } = getTemplateElements();
        let userTypeDropdownResult = current.find('#UserTypeDropdown');

        if (userTypeDropdownResult.length && clonedCurrentTemplate && (clonedCurrentTemplate.find(".AdvisorFactsheet *[class*='fe-section-'][class*='-val']").length || clonedCurrentTemplate.find(".ProviderFactsheet *[class*='fe-section-'][class*='-val']").length)) {

            switch ($(userTypeDropdownResult[0]).val()) {
                case "0": // Retail
                    processRetailFactsheet(clonedCurrentTemplate);
                    break;
                case "1": // Institutional
                    processInstitutionalFactsheet(clonedCurrentTemplate);
                    break;
            }
        }
    }
}


function applyResponsiveCascadingRow(parent, current, opts) {
    var defaultOpt = {
        autoPriority: true,
        enableCascade: modelContents.EnableCascadingRows
    };

    var initParams = $.extend({}, defaultOpt, opts);
    current.initializeCascadingRows(initParams);
}

/**
 * This jQuery plugin enables following features on table. <br/>
 * 1) cascading row feature ( can be disabled through enableCascade property),<br/>
 * 2) move items to dropdown ribbon
 */
$.fn.initializeCascadingRows = function (options) {
    var defaults = {
        /**
         * header selector
         */
        headerSelector: 'thead tr:last',
        theadSelector: 'thead',
        /**
         * table body selector
         */
        tbodySelector: 'tbody',
        tfootSelector: 'tfoot',
        /**
         * When autoPriority is enabled the plugin auto assigns the priority from left to right
         * And cascades accordingly
         */
        autoPriority: false,
        childRowClassName: 'cascade-child',
        enableCascade: true,
        debug: false
    }

    var opts = $.extend({}, defaults, options);

    /**
     * Javascript class to hold the column settings
     */
    var ColumnSettings = (function () {
        function ColumnSettings() { }
        return ColumnSettings;
    }());

    var table = $(this).uniqueId(); // Generate unique element id if not present
    var parent = table.parent(); // Can be commented
    parent.addClass('fe-cascade-table'); // Just add for css to apply properly. not required as this class should be added from Server HTML

    opts.enableCascade && parent.addClass('fe-enable-cascade');

    var autoPriority = opts.autoPriority;
    var headerSelector = opts.headerSelector;
    var theadSelector = opts.theadSelector;
    var tbodySelector = opts.tbodySelector;
    var tfootSelector = opts.tfootSelector;
    var childRowClassName = opts.childRowClassName;
    var hasPinnedItems = false;

    var moreBtnHeaderClassName = 'morebtn-th';
    var $moreBtnTh;

    var _ddMenu = 'cascade-menu';
    var dropdownMenu = '.' + _ddMenu;
    var dropdownMenuWrapper = dropdownMenu + '-wrapper';
    var dropdownMenuHTML = '<div class="cascade-hide ' + _ddMenu + '"/>';

    var _moreTag = 'fe-cascade-morebutton';
    var moreButtonSelector = '.' + _moreTag;
    var moreButtonTdHTML = '<td class="' + _ddMenu + '-wrapper" style="display:none"><button class="' + _moreTag + ' fe-button ui-state-default ui-button-text-only" type="button" aria-label="more" aria-expanded="false"><span class="ui-icon ui-icon-carat-1-s">More</span></button></td>';

    var childRowTr = '<tr class="cascade-hide ' + childRowClassName + '"></tr>';

    var colSettings = [];
    table = table.uniqueId(); // Generate unique element id if not present
    var evtNamespace = '.' + table.attr('id'); // Event namespace
    // $header corresponds to the header row that defines data- attributes
    var $header = table.find(headerSelector);

    // Clear the old more button header column/cell as this will not
    // be removed during data re-binding.
    $moreBtnTh = $header.find('.' + moreBtnHeaderClassName);
    if ($moreBtnTh.length > 0) {
        $moreBtnTh.remove();
    }

    var $headerLis = $header.find('td,th');
    // $theader corresponds to thead that can actually contain more than one header
    // rows like pagination row and actual display table headers
    var $theader = table.find(theadSelector);
    var $tbody = table.find(tbodySelector);
    var $tfooter = table.find(tfootSelector);
    var preventRibbonClose = false;

    var _getVisibleColumnsCount = function () {
        var totalVisibleColumns = 0;
        $.each(colSettings, function (idx, obj) {
            if (obj.visibility === true && !obj.fixedRibbons) {
                totalVisibleColumns++;
            }
        });
        return totalVisibleColumns;
    }

    /**
     * Hides all the elements with the provided priority value
     * Helpful in case of colspans
     * @param {*} selectedPriority 
     */
    var _hideMatchingPriorities = function (selectedPriority) {
        var headerHidden = false;
        $.each(colSettings, function (idx, obj) {
            if (selectedPriority === obj.priority) {
                if (headerHidden === false) {
                    var headerObj = $headerLis.eq(obj.actualIndex);
                    headerObj.data('width', table.width())
                        .css('display', 'none');
                    headerHidden = true;
                }
                $tbody.find('tr.parent td:nth-child(' + (idx + 1) + ')').css('display', 'none');
                obj.visibility = false;
            }
        });
    }

    /**
     * Method to hide the low priority columns, when the table width is greater than its parent/screen width
     */
    var _hideOverflowingColumns = function () {
        if (!parent.is(':visible'))
            return;

        $tbody.find(dropdownMenuWrapper).show();
        $moreBtnTh.removeClass('cascade-hide');
        var parentOuterWidth = parent.outerWidth();

        while (table.outerWidth() > parentOuterWidth) {
            var lowPriorityIdx = -1,
                availableLowPriority = -1;

            // Find the next visible candidate with low priority
            $.each(colSettings, function (idx, obj) {
                if (obj.fixedRibbons === false &&
                    obj.sticky === false &&
                    obj.visibility &&
                    obj.priority > availableLowPriority) {

                    availableLowPriority = obj.priority;
                    lowPriorityIdx = idx;
                }
            });

            if (lowPriorityIdx >= 0) {
                _hideMatchingPriorities(availableLowPriority);
            } else {
                // unable to find a valid column to hide. So do nothing
                break;
            }
        }
    }

    /**
     * Method to show the high priority columns that are hidden, 
     * when the table width is greater than its parent/screen width
     */
    var _showColumnsIfFeasible = function () {
        if (!parent.is(':visible'))
            return;

        var parentOuterWidth = parent.outerWidth();

        while (table.outerWidth() <= parentOuterWidth) {
            var highPriorityValue = 999;
            var highPriorityIdx = -1;

            // Find if we can fit a column in the view
            $.each(colSettings, function (idx, obj) {
                if (obj.fixedRibbons === false &&
                    obj.sticky === false &&
                    obj.visibility === false &&
                    obj.priority < highPriorityValue) {

                    highPriorityValue = obj.priority;
                    highPriorityIdx = idx;
                }
            });

            if (highPriorityIdx >= 0) {
                var headerObj = $headerLis.eq(colSettings[highPriorityIdx].actualIndex);
                if (parseInt(headerObj.data('width')) < parentOuterWidth) {
                    headerObj.css('display', '');
                    $.each(colSettings, function (idx, obj) {
                        if (obj.priority == highPriorityValue) {
                            $tbody.find('tr.parent td:nth-child(' + (idx + 1) + ')').css('display', '');
                            obj.visibility = true;
                        }
                    });
                } else {
                    // Can't fit the candidate within the available screen space
                    break;
                }
            } else {
                // unable to find a valid column to show. So do nothing
                break;
            }
        }
    }

    /**
     * This method checks the current column visibility array and modifies the footer column spans 
     * or hides column span accoringly
     */
    var _syncHeaderFooterColumns = function () {

        var totalVisibleColumns = _getVisibleColumnsCount();

        if ($theader.length > 0) {
            var tHeaderRows = $theader.find('tr');

            if (tHeaderRows.length > 1) {
                var paginationTd = tHeaderRows.eq(0).find('td');
                if (paginationTd.length === 1)
                    paginationTd.attr('colspan', totalVisibleColumns + 1);
            }
        }

        if ($tfooter.length > 0) {
            var tFooterRows = $tfooter.find('tr');

            if (tFooterRows.length > 1) {
                var showTotalRowTds = tFooterRows.eq(0).find('td');

                var labelColObj = showTotalRowTds.eq(0);
                var padColObj = showTotalRowTds.eq(2);

                var weightColumnIdx = parseInt(labelColObj.attr('colspan'));
                var showLabelColCount = 0;

                for (var i = 0; i < weightColumnIdx; i++) {
                    if (colSettings[i].visibility === true)
                        showLabelColCount++;
                }
                labelColObj.attr('colspan', showLabelColCount);
                padColObj.attr('colspan', totalVisibleColumns - showLabelColCount);

                tFooterRows.eq(1).find('td:first').attr('colspan', totalVisibleColumns + 1);
            } else {
                tFooterRows.eq(0).find('td:first').attr('colspan', totalVisibleColumns + 1);
            }
        }

        opts.enableCascade && $tbody.find('.cascade-child td:first').attr('colspan', totalVisibleColumns + 1);
    }

    /**
     * This method hides or shows the columns based on column priority
     * It hides the least priority columns first, when the table doesn't fit within view
     */
    var _refreshTableColumns = function (e) {

        try {
            if (!parent.is(':visible'))
                return;

            opts.debug && _debug('> Actual: refresh table proceeds for ' + parent.attr('id'));
            parent.css('overflow', 'hidden');

            _hideOverflowingColumns();
            _showColumnsIfFeasible();

            /* Refresh currently open/active listing */
            $tbody.find(dropdownMenu + '.active').closest('tr').each(function (idx, obj) {
                _refreshListDataItems($(obj));
            });
            $tbody.find('.' + childRowClassName + '.active').prev().each(function (idx, obj) {
                _refreshListDataItems($(obj));
            });

            _syncHeaderFooterColumns();

            var showMore = hasPinnedItems;

            if (!showMore) {
                // Check for more button visibility
                $.each(colSettings, function (idx, obj) {
                    if (obj.visibility === false || obj.fixedRibbons) {
                        showMore = true;
                        return;
                    }
                });
            }

            if (!showMore) {
                $tbody.find(moreButtonSelector + ' .ui-icon').removeClass('ui-icon-carat-1-n').addClass('ui-icon-carat-1-s');
                $tbody.find(dropdownMenuWrapper).hide();
                $moreBtnTh.addClass('cascade-hide');
            } else {
                $tbody.find(dropdownMenuWrapper).show();
                $moreBtnTh.removeClass('cascade-hide');
            }

        } catch (err) {
            _debug(err);
        }

        parent.css('overflow', '');
        _resizeParentFrame();
    }

    /**
     * Method to refresh the list items to match the current table view
     * i.e, show just the hidden items from the table
     * @param {* parent row object} parentTr 
     */
    var _refreshListDataItems = function (parentTr) {
        var menuLis = parentTr.find(dropdownMenu + ' ul li.cascade-col');
        var childLis = opts.enableCascade ? parentTr.next().find('ul li.cascade-col') : null;
        $.each(colSettings, function (idx, obj) {
            if (obj.fixedRibbons) {
                // Do nothing
            } else {
                if (obj.visibility === false) {
                    menuLis.eq(idx).show();
                    childLis && childLis.eq(idx).show();
                } else {
                    menuLis.eq(idx).hide();
                    childLis && childLis.eq(idx).hide();
                }
            }
        });
    }

    /**
     * This method hides all the columns that are marked as show in dropdown
     * from the table
     */
    var _initDropdownOnlyItems = function (isAnyItemConfiguredInDropdown) {
        isAnyItemConfiguredInDropdown && $moreBtnTh.removeClass('cascade-hide');
        $.each(colSettings, function (idx, obj) {
            if (obj.fixedRibbons) {
                $headerLis.eq(obj.actualIndex)
                    .css('display', 'none');;
                $tbody.find('tr.parent td:nth-child(' + (idx + 1) + ')')
                    .css('display', 'none');
            }
        });
    }

    /**
     * 
     * @param {any} elems - array of jQuery objects
     * @param {string} className 
     * @param {boolean} isAdd 
     * @param {number} timeout 
     */
    var timedAddRemoveClass = function (elems, className, isAdd, timeout) {
        setTimeout(function () {
            if (Array.isArray(elems)) {
                $.each(elems, function (idx, obj) {
                    isAdd ? obj.addClass(className) : obj.removeClass(className);
                })
            } else {
                isAdd ? elems.addClass(className) : elems.removeClass(className);
            }
        }, timeout);
    }

    var _debounceResizeIframeTimer = 0;
    var _resizeParentFrame = function () {

        if (_debounceResizeIframeTimer)
            clearTimeout(_debounceResizeIframeTimer);

        // Communicate the height change to parent Iframe
        _debounceResizeIframeTimer = setTimeout(function () {
            // For Toolkit UIs, fund center
            if (typeof ToolkitUI != 'undefined') {
                ToolkitUI.Common.ResizeIFrame();
            } else if (typeof PostMessaging != 'undefined') {
                // For charting tool
                if (modelContents.PostMessagingEnabled) {
                    PostMessaging.Events.ResizeIFrame();
                }
            }
        }, 750);
    }

    var _debug = function (msg) {
        if (opts.debug)
            console.log('cascade feature ' + msg);
    }

    /**
     * Handle all the events related to global object or based on global events
     * Besure to destroy or unbind these events during destroy
     */
    var _bindGlobalEvents = function () {
        // clicking within the menu popup/dropdown shouldn't close the dropdown
        // so stop the event bubbling
        $tbody.find('tr ' + dropdownMenu).off('click' + evtNamespace)
            .on('click' + evtNamespace, function (e) {
                preventRibbonClose = true;
            });

        // Hide the dropdown menu on clicking the document 
        // (If the actual element does bubble it to parent)
        $(document).off('click' + evtNamespace)
            .on('click' + evtNamespace, function () {
                if (preventRibbonClose) {
                    preventRibbonClose = !preventRibbonClose;
                    return;
                }

                if (!parent.is(':visible'))
                    return;

                // Check if we are in dropdown view or cascaded row mobile-view
                var childRows = $tbody.find('tr.' + childRowClassName);
                var isChildCascadedRowVisible = false;
                isChildCascadedRowVisible = childRows.length > 0 && childRows.filter(':visible').length > 0;

                if (!isChildCascadedRowVisible) {
                    var activeParentTr = $tbody.find('tr.active.parent');
                    activeParentTr.removeClass('active');
                    activeParentTr.find(moreButtonSelector).attr('aria-expanded', 'false');
                    activeParentTr.find(moreButtonSelector + ' .ui-icon').removeClass('ui-icon-carat-1-n').addClass('ui-icon-carat-1-s');

                    var elemsToHide = $tbody.find('tr.active.' + childRowClassName + ', tr ' + dropdownMenu + '.active');
                    elemsToHide.removeClass('active');
                    timedAddRemoveClass(elemsToHide, 'cascade-hide', true, 350);
                }
            });

        if (opts.enableCascade) {
            // refresh the visible columns on screen size change
            $(window).off('resize' + evtNamespace)
                .on('resize' + evtNamespace, $.throttle(300, _refreshTableColumns));


            // This event is triggered by the parent/topmost tab to refresh the 
            // the table columns visibility based on screen size
            table.off('fe-datatable:shown').on('fe-datatable:shown', function () {
                opts.debug && _debug('> Tab changes : refresh table triggered for ' + parent.attr('id'));
                _debouncedRefreshTableColumns();
            });
        }
    }

    /**
     * Debounces function that handles show/hide of the dropdown or
     * the collapsible section
     */
    var _moreClickHandler = $.debounce(150, function (e) {
        e.stopPropagation();

        var toggleButton = $(e.currentTarget);
        var toggleIcon = toggleButton.find('.ui-icon');
        var parentTr = toggleButton.closest('tr');

        var desktopViewTarget = parentTr.find(dropdownMenu);

        //Remove old active parents
        $tbody.find('tr.active.parent').not(parentTr).removeClass('active');

        var prevDesktopActive = $tbody.find('tr ' + dropdownMenu).not(desktopViewTarget);
        timedAddRemoveClass(prevDesktopActive, 'cascade-hide', true, 0);

        prevDesktopActive.removeClass('active');
        $tbody.find(moreButtonSelector + ' .ui-icon').removeClass('ui-icon-carat-1-n').addClass('ui-icon-carat-1-s');

        var isAlreadyExpanded = desktopViewTarget.hasClass('active');

        if (isAlreadyExpanded) {
            toggleIcon.removeClass('ui-icon-carat-1-n').addClass('ui-icon-carat-1-s');
            desktopViewTarget.removeClass('active');
            parentTr.removeClass('active');
            timedAddRemoveClass(desktopViewTarget, 'cascade-hide', true, 350);
            toggleButton.attr('aria-expanded', 'false');
        } else {
            toggleIcon.removeClass('ui-icon-carat-1-s').addClass('ui-icon-carat-1-n');
            desktopViewTarget.removeClass('cascade-hide');
            timedAddRemoveClass([desktopViewTarget, parentTr], 'active', true, 0);
            toggleButton.attr('aria-expanded', 'true');
        }

        if (opts.enableCascade) {
            var mobileViewTarget = parentTr.next();
            isAlreadyExpanded = mobileViewTarget.hasClass('active');
            var prevMobileActive = $tbody.find('tr.active.' + childRowClassName).not(mobileViewTarget);
            prevMobileActive.removeClass('active');
            timedAddRemoveClass(prevMobileActive, 'cascade-hide', true, 0);
            if (isAlreadyExpanded) {
                mobileViewTarget.removeClass('active');
                timedAddRemoveClass(mobileViewTarget, 'cascade-hide', true, 750);
            } else {
                mobileViewTarget.removeClass('cascade-hide');
                timedAddRemoveClass(mobileViewTarget, 'active', true, 0);
            }
        }

        _refreshListDataItems(parentTr);
        _resizeParentFrame();
    });

    /**
     * Read and parse display priority of each column
     * Handle columnspan changes between header and the data rows
     */
    var _readTableConfigurations = function () {
        var defaultVisibility = true;
        var iPriority = 1,
            referenceColumnIdx = 0;
        var $referencRowTds = $tbody.find('tr:first td');

        // parent.css('overflow', 'hidden');
        $headerLis.css('display', '');

        $headerLis.each(function (idx, obj) {
            var jqObj = $(obj);
            var colSpan = jqObj.attr('colspan');
            var isConfiguredInDropdown = jqObj.data('ribbon') === true;
            var cSticky = jqObj.data("sticky") === true;
            var groupName = jqObj.data('group');
            var headerTitle = jqObj.html();

            if (autoPriority) {
                // Allows hidding of columns even when there is no 'priority' specified using data attribute
                iPriority++;
            } else {
                var objPriority = jqObj.data('priority');
                if (objPriority) {
                    iPriority = parseInt(objPriority);
                } else {
                    iPriority++;
                    cSticky = true;
                }
            }

            // Special case to move the buttons in the Name subcolumns to ribbon.
            var isSpecialStickyCol = false;
            if (cSticky) isSpecialStickyCol = /_175$/.test(jqObj.attr('id'));

            var iColSpan = 1; // Default for single column
            // When colspan attribute is set
            if (colSpan) iColSpan = parseInt(colSpan);

            // Number of special stickied columns to be fixed in table
            var specialStickyFixedCount = 0,
                makeColsSticky = false;

            for (var i = 0; i < iColSpan; i++) {
                var cOpts = new ColumnSettings();
                cOpts.visibility = defaultVisibility;
                cOpts.priority = iPriority;
                cOpts.actualIndex = idx;
                cOpts.fixedRibbons = isConfiguredInDropdown;
                cOpts.sticky = cSticky;
                cOpts.groupName = groupName;
                cOpts.title = headerTitle;
                cOpts.specialSticky = isSpecialStickyCol;
                cOpts.spanCount = iColSpan;

                var referenceTdObj = $referencRowTds.eq(referenceColumnIdx);

                // Make the column containing input controls as sticky to avoid any logic issues
                makeColsSticky = makeColsSticky || (referenceTdObj.find('input').length > 0);

                if (isSpecialStickyCol) {
                    cOpts.specialStickyInfo = {
                        showInTable: false
                    };

                    // Cross check the column fields in the first reference row
                    var isActualNameColumn = referenceTdObj.hasClass('fe-column-name');
                    if (isActualNameColumn ||
                        referenceTdObj.hasClass('fe-datafield-selectinstrument')) {
                        cOpts.specialStickyInfo.showInTable = true;
                        cOpts.specialStickyInfo.assignMaxColspan = isActualNameColumn;
                        specialStickyFixedCount++;
                    }
                }
                colSettings.push(cOpts);
                referenceColumnIdx++;
            }

            if (isSpecialStickyCol) {
                // colSettings.length corresponds to the actual index of the columns in the tbody
                for (var i = colSettings.length - colSpan; i < colSettings.length; i++) {
                    var verifyColSettings = colSettings[i];
                    if (verifyColSettings.specialStickyInfo.showInTable) {
                        if (verifyColSettings.specialStickyInfo.assignMaxColspan) {
                            colSettings[i].spanCount = colSpan - specialStickyFixedCount + 1;
                        } else {
                            colSettings[i].spanCount = 1;
                        }
                    }
                }
            }
            if (makeColsSticky) {
                // Make all fields in the colspan as sticky, if even a single td is found with an input element
                for (var i = referenceColumnIdx - iColSpan; i < colSettings.length; i++) {
                    colSettings[i].sticky = true;
                }
            }
        });
    }

    /**
     * Creates the duplicate nodes based on the table configurations parsed from the th -header HTML.
     */
    var _createListForTableRow = function ($trObj, groupName) {
        // Construct the list that will be embeded within dropdown, as well as toggleable section
        var infoList = $('<ul/>');
        var pinnedList = $('<ul class="cascade-pin-btns"/>');
        var isTotalRow = $trObj.hasClass('total'); // Sometimes total row appears as part of tbody

        $trObj.find('td').not('.cascade-menu-wrapper').each(function (tdIdx, tdObject) {
            var jqObj = $(tdObject);
            var jqChildren = jqObj.children();

            var curSettings = colSettings[tdIdx];
            var jqLi = $('<li class="cascade-col"/>');
            var isTotalRowEmptyTd = false;

            // Most sticky elements will have elements that cause issue when duplicated
            if (curSettings.sticky === false) {
                var objClone = jqChildren.clone(true, true);

                if (objClone.length === 1 && objClone.eq(0).is('a')) {
                    // TODO : For anchor buttons like download tool, charting tool, factsheet. we may have to show a group name
                    // instead of individual labels

                    // Current logic copies the children elements with events
                    jqLi.append(objClone);
                    jqLi.addClass(jqObj.attr('class'));
                    var sanitizedTitle = DOMPurify.sanitize(objClone.attr('title'));
                    objClone.html(sanitizedTitle);
                } else {
                    var cellHTML = jqObj.html();
                    if (isTotalRow && String.prototype.trim.call(cellHTML).length === 0) {
                        // Sometimes total row appears as part of tbody
                        // In that case just show the headers, only when its cell has data
                        jqLi.addClass('cascade-hide');
                    } else {
                        jqLi.html('<span class="cascade-cellheader">' + curSettings.title + ' </span>');

                        // If no children, copy the HTML with no event
                        jqLi.append(cellHTML);
                    }
                }
            } else if (curSettings.specialSticky) {
                // For a special case, where Add to Portfolio, Basket, Shortlist appears within Name subcoloumns
                // AND Name is marked as sticky

                if (curSettings.specialStickyInfo.showInTable) {
                    if (curSettings.spanCount > 1) {
                        jqObj.attr('colspan', curSettings.spanCount);
                    } else {
                        // Let it just take one column
                    }
                } else {
                    var objClone = jqChildren.clone(true, true);
                    var sanitizedTitle = DOMPurify.sanitize(objClone.attr('title'));
                    objClone.html(sanitizedTitle);
                    pinnedList.append($('<li/>').addClass(jqObj.attr('class')).append(objClone));
                    jqObj.css('display', 'none');
                    hasPinnedItems = true;
                }
            }
            infoList.append(jqLi);
        });
        return [infoList, pinnedList];
    }

    /**
     * Enhances the original table HTML with the more buttons
     * dropdown and collapsible secttion contents
     */
    var _createCascadingElements = function () {
        var groupName = '';

        $moreBtnTh = $header.find('.' + moreBtnHeaderClassName);
        if ($moreBtnTh.length === 0) {
            $moreBtnTh = $('<th role="presentation" class="' + moreBtnHeaderClassName + ' cascade-hide"></th>');
            $moreBtnTh.append('<span aria-visible="hidden" class="cascade-hide">More Information</span>');
            $header.append($moreBtnTh);
        }

        $tbody.find('tr').each(function (trIdx, trObj) {
            var $trObj = $(trObj);
            var hasCascadeMenuWrapper = $trObj.find('td.cascade-menu-wrapper');
            if (hasCascadeMenuWrapper.length == 0) {
                var createdLists = _createListForTableRow($trObj, groupName);

                var infoList = createdLists[0];

                // Add column at last with a button that toggles dropdown menu(desktop)
                // or collapsible section(mobile)
                $trObj.append(moreButtonTdHTML);

                $trObj.find(moreButtonSelector).button();

                // For mobile view
                var columnCount = colSettings.length;
                var childRow = $(childRowTr);
                var childColumn = $('<td colspan="' + (columnCount + 1) + '"></td>');

                var wrappedList = $('<div class="cascade-childrow-wrapper"/>');
                var wrappedListCnt = $('<div class="cascade-childrow-cnt cascade-common-theme"/>');
                wrappedListCnt.append(infoList);
                wrappedList.append(wrappedListCnt);

                if (createdLists[1].children().length > 0) {
                    wrappedListCnt.append(createdLists[1]);
                }

                childColumn.append(wrappedList);

                childRow.append(childColumn);

                // For desktop view
                var ddMenu = $(dropdownMenuHTML);
                var ddMenuCnt = $('<div class="cascade-menu-cnt cascade-common-theme" />');
                ddMenuCnt.append(infoList.clone(true, true));
                ddMenu.append(ddMenuCnt);

                if (createdLists[1].children().length > 0) {
                    ddMenuCnt.append(createdLists[1].clone(true, true));
                }

                ddMenu.appendTo($trObj.find('td:last'));

                $trObj.find(moreButtonSelector).off('click' + evtNamespace)
                    .on('click' + evtNamespace, function (e) {
                        e.stopPropagation(); // Stop event from bubbling up to parent
                        _moreClickHandler(e);
                    });

                if (opts.enableCascade) {
                    // causes redraw - so do it after completing all DOM manipulations
                    $trObj.after(childRow);
                }
                $trObj.addClass('parent');
            }
        });
    }

    var _refreshTableTimer = 0;
    /**
     * Prevents duplicate triggers that can happen immediately
     */
    var _debouncedRefreshTableColumns = function () {
        _refreshTableTimer && clearTimeout(_refreshTableTimer);
        _refreshTableTimer = setTimeout(function () {
            _refreshTableColumns();
        }, 0);
    }

    var _init = function () {
        _readTableConfigurations();

        // Don't do anything if cascade row feature is false, 
        // and ribbon data attribute is not found in table header
        var isAnyItemConfiguredInDropdown = false;
        $.each(colSettings, function (idx, obj) {
            if (obj.fixedRibbons) {
                isAnyItemConfiguredInDropdown = true;
                return;
            }
        });

        if (!(opts.enableCascade || isAnyItemConfiguredInDropdown))
            return;

        _createCascadingElements();
        _initDropdownOnlyItems(isAnyItemConfiguredInDropdown);

        if (opts.enableCascade) {
            // Delay so that, If there is a delay with table rendering by browser - 
            // we can reliably calculate the column widths when it appears.
            opts.debug && _debug('> Init : Refresh table triggered for ' + parent.attr('id'));
            _debouncedRefreshTableColumns();
        }
        _bindGlobalEvents();
    }

    // Finally init show hide based on current view
    _init();
}

// Creates style classes for table rows
$.fn.StyleTableRows = function () {
    var target = $(this);
    if (target.find('tbody tr:odd').hasClass('even')) {
        target.find('tbody tr:odd').removeClass('even');
    }

    target.find('tbody tr:odd').addClass('odd');


    if (target.find('tbody tr:even').hasClass('odd')) {
        target.find('tbody tr:even').removeClass('odd');
    }
    target.find('tbody tr:even').addClass('even');

    target.find('tbody tr td:not(.actionLink)').on('click',
        function (event) {
            var target = $(this).parent();
            target.toggleClass('selected');
            target.find('.check').prop('checked', target.hasClass('selected'));

            var currentPos = target.index();
            var isAdd = target.find('.check').prop('checked');

            if (!event.shiftKey) {
                // Reset
                startPos = $(this).parent().index();
                minMaxPos = 0;
                action = isAdd ? 1 : 0;
            }
            else if (action == -1) {
                //action = isAdd ? 1 : 0;
            }

            if (currentPos > startPos) {
                minMaxPos = Math.max(minMaxPos, currentPos);
            }
            else if (currentPos < startPos) {
                minMaxPos = Math.min(minMaxPos, currentPos);
            }
        });

    target.find('tbody tr').on('mouseover', function (event) {
        $(this).addClass('mouseover');
    });

    target.find('tbody tr').on('mouseout', function (event) {
        $(this).removeClass('mouseover');
    });
}

//This funtion sets the pagination title
$.fn.setPaginationTitle = function () {
    $('.ui-paging-button').each(function () {
        $(this).attr('title', 'Page ' + $(this).text());
    });

    $('.ui-paging-next').each(function () {
        $(this).attr('title', 'Next Page');
    });

    $('.ui-paging-prev').each(function () {
        $(this).attr('title', 'Previous Page');
    });
}

//This funtion returns the current selected page size
$.fn.getPageSize = function () {
    return this.find(".record-count, input").val();
}

//This funtion returns the current selected page size
$.fn.initializePagination = function (value) {
    this.find('.paginator').data('has_initialized', value);
}

//This funtion returns the pagination initialization status
$.fn.canInitializePagination = function (value) {
    return this.find('.paginator').data('has_initialized');
}

//This funtion sets the current page index
$.fn.setCurrentPage = function (value) {
    this.find('.paginator').data('current_page_index', value);
}

//This funtion returns the current selected page size
$.fn.getCurrentPage = function () {
    var cp = $(this).parent().find(".paginator").data('current_page_index');
    if (cp == null || cp == undefined)
        cp = 0;
    return cp;
}

//This event funtion should be used to subscribe for data table onDataRowClick event.
$.fn.onDataRowClick = function (fun) {
    $(document).undelegate("#" + $(this).attr('id'), "onDataRowClick");
    $(document).delegate("#" + $(this).attr('id'), "onDataRowClick", fun);
}

//This event funtion should be used to subscribe for data table onPreDataLoad event.
$.fn.onPreDataLoad = function (fun) {
    $(document).undelegate("#" + $(this).attr('id'), "onPreDataLoad");
    $(document).delegate("#" + $(this).attr('id'), "onPreDataLoad", fun);
}

//This event funtion should be used to subscribe for data table onPostDataLoad event.
$.fn.onPostDataLoad = function (fun) {
    $(document).undelegate("#" + $(this).attr('id'), "onPostDataLoad");
    $(document).delegate("#" + $(this).attr('id'), "onPostDataLoad", fun);
}

//This event funtion should be used to subscribe for data table onRecordsPerPage event.
$.fn.onRecordsPerPage = function (fun) {
    $(document).undelegate("#" + $(this).attr('id'), "onRecordsPerPage");
    $(document).delegate("#" + $(this).attr('id'), "onRecordsPerPage", fun);
}

//This event funtion should be used to subscribe for data table onGetDataRequest event.
$.fn.onGetDataRequest = function (fun) {
    $(document).undelegate("#" + $(this).attr('id'), "onGetDataRequest");
    $(document).delegate("#" + $(this).attr('id'), "onGetDataRequest", fun);
}

//This function show data container and hides all other which are visible.
//If you have a requirement to keep other data container visible then either 
//you need to extend this funtion or call this funtion as per your requirement
//which may be twice or thrice.
//You need to define your data container with the postfix (in otherwords id or name should be
//ending with) '-data-container'
$.fn.showContainer = function () {
    $('div[id$="-data-container"]').hide();
    $(this).show();
}

//This function hides all data container 
//You need to define your data container with the postfix (in otherwords id or name should be
//ending with) '-data-container'
$.fn.hideAllContainers = function () {
    $('div[id$="-data-container"]').hide();
}

//This function returns true or false based on given checkbox control
$.fn.isChecked = function () {
    return this.prop('checked');
};

$.fn.getActiveTab = function (context) {
    return $('.ui-state-active', context);
};

$.fn.getTabContainer = function () {   
    //Accessibility href fix
    return $(this.find('a').attr('href') || this.find('a').attr('data-target'));
};

$.fn.getActiveTabId = function (context) {
    return parseInt($('.ui-state-active', context).attr('id'));
}

$.fn.disable = function () {
    return this.each(function () {
        if (typeof this.disabled != "undefined") this.disabled = true;
    });
}

$.fn.enable = function () {
    return this.each(function () {
        if (typeof this.disabled != "undefined") this.disabled = false;
    });
}
$.fn.disableForm = function () {
    this.find("select").each(function () {
        if (typeof this.disabled != "undefined") this.disabled = true;
    }).end()
        .find("input").each(function () {
            if (typeof this.disabled != "undefined") this.disabled = true;
        }).end()
        .find("button").each(function () {
            if (typeof this.disabled != "undefined") this.disabled = true;
        });
}

$.fn.enableForm = function () {
    this.find("select").each(function () {
        if (typeof this.disabled != "undefined") this.disabled = false;
    }).end()
        .find("input").each(function () {
            if (typeof this.disabled != "undefined") this.disabled = false;
        }).end()
        .find("button").each(function () {
            if (typeof this.disabled != "undefined") this.disabled = false;
        });
}

//#endregion
////this function is limited, first it will do a replace to change
////e.g. dd.mm.yy to dd_dotmm_dotyy
function getJqueryDatePickerFormatMapping(originalData) {
    originalData = String.prototype.trim.call(originalData);
    originalData = originalData.replace(/\./g, "_dot");

    originalData = originalData.replace(/ /g, "_empty");
    originalData = originalData.replace(/\//g, "_slash");
    originalData = originalData.replace(/\-/g, "_dash");
    var mapping = JqueryDatePickerFormatMapping[originalData];
    return mapping;
}

var JqueryDatePickerFormatMapping = {
    dd_emptyMMM_emptyyyyy: "dd M yy",
    dd_emptyMMMM_emptyyyyy: "dd MM yy",
    dd_emptyMM_emptyyy: "dd mm y",
    dd_dotMM_dotyy: "dd.mm.y",
    dd_dotMM_dotyyyy: "dd.mm.yy",
    dd_slashMM_slashyy: "dd/mm/y",
    dd_slashMM_slashyyyy: "dd/mm/yy",
    dd_dashMM_dashyy: "dd-mm-y",
    dd_dashMM_dashyyyy: "dd-mm-yy",
    yyyy_dotMM_dotdd: "yy.mm.dd",
    yyyy_slashMM_slashdd: "yy/mm/dd",
    yyyy_dashMM_dashdd: "yy-mm-dd",
    MM_slashdd_slashyyyy: "mm/dd/yy",
    dd_slashMM_slashyyyy: "dd/mm/yy"
}

function getParameterByName(name) {
    var match = RegExp('[?&]' + name + '=([^&]*)')
        .exec(window.location.search);

    return nullIfEmpty(match && decodeURIComponent(match[1].replace(/\+/g, ' ')));
}


function getParameterByNameIgnoreCase(name) {
    var match = RegExp('[?&]' + name + '=([^&]*)', 'gi')
        .exec(window.location.search);

    return nullIfEmpty(match && decodeURIComponent(match[1].replace(/\+/g, ' ')));
}


function getParameterByNameFromURl(name, url) {
    var match = RegExp('[?&]' + name + '=([^&]*)')
        .exec(url);

    return nullIfEmpty(match && decodeURIComponent(match[1].replace(/\+/g, ' ')));
}

function getParameterByNameFromURLIgnoreCase(name, url) {
    var match = RegExp('[?&]' + name + '=([^&]*)', 'gi')
        .exec(url);

    return nullIfEmpty(match && decodeURIComponent(match[1].replace(/\+/g, ' ')));
}

///Set value to null, if the URL parameter value is empty
function nullIfEmpty(value) {
    return value === '' ? null : value;
}

