    recordsPerPage: 25
});

$.fn.extend({
    toggleAttr: function (attrib) {
        if (this.attr(attrib)) {
            this.removeAttr(attrib);
        } else {
            this.attr(attrib, attrib);
        }
        return this;
    }
});

function getIntersect(arr1, arr2) {
    var r = [], o = {}, l = arr2.length, i, v;
    for (i = 0; i < l; i++) {
        o[arr2[i]] = true;
    }
    l = arr1.length;
    for (i = 0; i < l; i++) {
        v = arr1[i];
        if (v in o) {
            r.push(v);
        }
    }
    return r;
}

function isFirstValuesSameAsSecond(o1, o2, ignoreUndefined) {
    if (o1 == null && o2 == null) {
        return true;
    }
    if ((o1 == null && o2 != null) || (o2 == null && o1 != null)) {
        return false;
    }

    var k1 = Object.keys(o1).sort();
    var k2 = Object.keys(o2).sort();

    if (k1.length == 0 && k2.length == 0)
        return true;
    var same = false;

    ////if both are the same length and both array do not contain objects
    //// it is quite possible that they are int array or string array
    //// in this case, it is possible that the order is different, so we do an intersect
    var isPrimaryArray = true;
    if (k1.length == k2.length) {
        for (var i = 0; i < k1.length; i++) {
            if (typeof o1[k1[i]] == "object" || typeof o2[k1[i]] == "object" || typeof o1[k1[i]] == "undefined" || typeof o2[k1[i]] == "undefined") {
                ////both contain primary types
                //// so do a intersect
                isPrimaryArray = false;
                break;
            }
        }
    }
    else {
        isPrimaryArray = false;
    }
    if (o1.length == undefined || o2.length == undefined) {
        isPrimaryArray = false;
    }

    if (isPrimaryArray) {
        var intersect = getIntersect(o1, o2);
        var same = intersect.length == k1.length;
        return same;
    }

    for (var i = 0; i < k1.length; i++) {
        if ((typeof o1[k1[i]] == typeof o2[k1[i]]) && typeof o1[k1[i]] == "object") {
            same = isFirstValuesSameAsSecond(o1[k1[i]], o2[k1[i]], ignoreUndefined);
            if (!same) {
                break;
            }
        }
        else if (typeof o2[k1[i]] == "undefined" && ignoreUndefined) {
            continue;
        }
        else {
            if (typeof o2[k1[i]] == "undefined") {
                same = o1[k1[i]] == o2[k1[i]];
            }
            else {
                if (o1[k1[i]] != null && o2[k1[i]] != null) {
                    same = o1[k1[i]].toString() == o2[k1[i]].toString();
                }
                else if (o1[k1[i]] == null && o2[k1[i]] != null) {
                    same = false;
                }
                else if (o1[k1[i]] != null && o2[k1[i]] == null) {
                    same = false;
                }
                else {
                    same = true;
                }
            }

            if (!same)
                break;
        }
    }
    return same;
}

function deepEquals(o1, o2) {
    var k1 = Object.keys(o1).sort();
    var k2 = Object.keys(o2).sort();
    if (k1.length != k2.length) return false;

    return k1.zip(k2, function (keyPair) {
        if (typeof o1[keyPair[0]] == typeof o2[keyPair[1]] == "object") {
            return deepEquals(o1[keyPair[0]], o2[keyPair[1]])
        } else {
            return o1[keyPair[0]] == o2[keyPair[1]];
        }
    }).all();
}

