
$.fn.AnimateTransition = function (destinationObject, cssClass) {
    var options = { to: destinationObject, className: cssClass };
    $(this).effect("transfer", options, 700, null);
};

$.fn.AnimateTransitionToBasket = function () {

    if (modelContents.ShowAddToBasketAnimation == 'True') {
        var basketHeader = $("#floatcontainer .fe-fundsInBasket .fe-basketHeader");
        $(this).AnimateTransition(basketHeader, "fe-effects-moveToBasket");
    }
};

