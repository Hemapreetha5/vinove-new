// note that below cookie names are also defined on server side in FE.Toolkit.ClientUI.Shared.Constants.CookieName
// so make sure that both server side and client side cookie names are always in sync
function MasterContainer(projectName, grsUserId) {
    mpCodelistkey = projectName + "_mpCodelist";
    this.shortListContainer = new ShortListContainer(projectName + "_shortlist");
    this.dynamicShortListContainer = new DynamicShortListContainer(projectName + "_dynamicshortlist");
    this.basketContainer = new BasketContainer(projectName + "_basket");
    this.portfolioContainer = new PortfolioContainer(projectName + "_portfolio");
    this.portfolioComparisonContainer = new PortfolioComparisonContainer(projectName + "_portfolioComparison");
    this.shortlistComparisonContainer = new ShortlistComparisonContainer(projectName + "_shortlistComparison");
    this.targetAllocationContainer = new TargetAllocationListContainer(projectName + "_targetAllocation");
    if (modelContents.AllowSavingOfPortfolios === "True") {
        this.userPortfoliosContainer = new UserPortfoliosContainer(projectName + '_' + grsUserId + '_userPortfolios');
    }
    if (modelContents.ShowMultipleWatchlists && parseInt(modelContents.GrsUserId) > 0) {
        this.userWatchlistsContainer = new UserWatchlistsContainer(projectName + '_' + grsUserId + '_userWatchlists');
    }
}




