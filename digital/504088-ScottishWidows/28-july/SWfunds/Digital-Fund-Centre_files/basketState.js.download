function UserPortfoliosContainer(containerKey) {

    this.target = new EventTarget();
    this.target.addListener("ItemAdded", UserPortfolioAddedHandler);
    this.target.addListener("ItemUpdated", UserPortfolioUpdatedHandler);
    this.target.addListener("ItemRemoved", UserPortfolioRemovedHandler);


    this.container = new Container(containerKey, this.target);

    this.Get = function () {
        return this.container.GetEncoded();
    };

    this.Add = function (val) {
        this.container.AddEncoded(val);
    };

    this.Update = function (val) {
        this.container.UpdateEncoded(val);
    }
    
    this.Remove = function (val) {
        this.container.RemoveEncoded(val);
    };

    this.RemoveAll = function () {
        this.container.RemoveAllEncoded();
    };

    this.AddCollection = function (collection) {
        this.container.AddCollectionEncoded(collection);
    };

    this.PersistState = function () {
        this.container.PersistStateEncoded();
    };
}

