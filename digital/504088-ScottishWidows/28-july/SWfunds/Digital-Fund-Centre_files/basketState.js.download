function BasketContainer(containerKey) {

    this.target = new EventTarget();
    this.target.addListener("ItemAdded", BasketItemAddedHandler);
    this.target.addListener("ItemRemoved", BasketItemRemovedHandler);

    this.container = new Container(containerKey, this.target);

    this.Get = function() {
        return this.container.GetEncoded();
    };

    this.Add = function(val) {
        this.container.AddEncoded(val);
    };

    this.Remove = function(val) {
        this.container.RemoveEncoded(val);
    };

    this.RemoveAll = function() {
        this.container.RemoveAllEncoded();
    };
}


function PortfolioContainer(containerKey) {

    this.target = new EventTarget();
    this.target.addListener("ItemAdded", PortfolioItemAddedHandler);
    this.target.addListener("ItemRemoved", PortfolioItemRemovedHandler);

    this.container = new Container(containerKey, this.target);

    this.Get = function() {
        return this.container.Get();
    };

    this.Add = function(val) {
        this.container.Add(val);
    };

    this.Remove = function(val) {
        this.container.Remove(val);
    };
    
    this.RemoveCookie = function () {
        this.container.RemoveCookie();
    };

    this.RemoveAll = function() {
        this.container.RemoveAll();
    };

    this.AddCollection = function (collection) {
        this.container.AddCollection(collection);
    };

    this.RemoveCollection = function (collection) {
        this.container.RemoveCollection(collection);
    };

    this.PersistState = function () {
        this.container.PersistState();
    };

    this.UnbindItemRemovedEvent = function () {
        this.target.removeListener("ItemRemoved", PortfolioItemRemovedHandler);
    };

    this.BindToItemRemovedEvent = function () {
        this.target.addListener("ItemRemoved", PortfolioItemRemovedHandler);
    };
}


